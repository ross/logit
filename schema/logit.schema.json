{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Config",
  "type": "object",
  "properties": {
    "components": {
      "default": {},
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/definitions/Component"
      }
    }
  },
  "definitions": {
    "Component": {
      "description": "One node in the pipeline's component graph. `sources` names the other components this one reads events from -- empty for a listener, required for everything else (enforced at validation time, not in this schema: which arity is legal depends on `kind`, not something a blanket `minItems` on this shared field can express). See `docs/design/pipeline-graph.md` for the full arity table and validation rules.",
      "type": "object",
      "oneOf": [
        {
          "description": "statsd / DogStatsD-style tagged metrics over UDP.",
          "type": "object",
          "required": [
            "bind",
            "type"
          ],
          "properties": {
            "bind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "statsd_in"
              ]
            }
          }
        },
        {
          "description": "RFC 3164 / RFC 5424 syslog over UDP or TCP.",
          "type": "object",
          "required": [
            "bind",
            "type"
          ],
          "properties": {
            "bind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "syslog_in"
              ]
            }
          }
        },
        {
          "description": "OpenTelemetry Protocol (logs, metrics, and/or traces).",
          "type": "object",
          "required": [
            "bind",
            "type"
          ],
          "properties": {
            "bind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "otlp_in"
              ]
            }
          }
        },
        {
          "description": "Tail one or more files as a log source, rotation- and checkpoint-aware.",
          "type": "object",
          "required": [
            "paths",
            "type"
          ],
          "properties": {
            "checkpoint_path": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "type": {
              "type": "string",
              "enum": [
                "file_tail"
              ]
            }
          }
        },
        {
          "description": "The native logit-to-logit protocol (`docs/design/wire-protocol.md`).",
          "type": "object",
          "required": [
            "bind",
            "type"
          ],
          "properties": {
            "bind": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "logit_in"
              ]
            }
          }
        },
        {
          "description": "Inline Lua source (a YAML block scalar in practice). See `docs/design/lua-api.md`.",
          "type": "object",
          "required": [
            "script",
            "type"
          ],
          "properties": {
            "interval": {
              "description": "Runs this component's `flush()`, if the script defines one, on this interval (`docs/design/lua-api.md`'s flush contract). Omitted -- the common case -- means the component never ticks, same as a script with no `flush()` at all.",
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "script": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "lua"
              ]
            }
          }
        },
        {
          "description": "A `.lua` file path, relative to the config file.",
          "type": "object",
          "required": [
            "lua_file",
            "type"
          ],
          "properties": {
            "interval": {
              "default": null,
              "type": [
                "string",
                "null"
              ]
            },
            "lua_file": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "lua_file"
              ]
            }
          }
        },
        {
          "description": "The stateful aggregator (counters/gauges/sets/distributions). Runs `flush()` on `interval`; see `docs/adr/0008-aggregation-window-semantics.md`.",
          "type": "object",
          "required": [
            "interval",
            "type"
          ],
          "properties": {
            "interval": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "aggregate"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "logfmt"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "kv"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "pattern",
            "type"
          ],
          "properties": {
            "pattern": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "regex"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "csv"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "from",
            "to",
            "type"
          ],
          "properties": {
            "from": {
              "type": "string"
            },
            "to": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "rename"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "field",
            "type"
          ],
          "properties": {
            "field": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "remove"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "where"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "filter"
              ]
            },
            "where": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "rate",
            "type"
          ],
          "properties": {
            "rate": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "enum": [
                "sample"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "limit",
            "type",
            "window"
          ],
          "properties": {
            "limit": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0.0
            },
            "type": {
              "type": "string",
              "enum": [
                "throttle"
              ]
            },
            "window": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "key",
            "type"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "dedup"
              ]
            }
          }
        },
        {
          "description": "`rename`d explicitly: `rename_all = \"snake_case\"` alone would tag this `influx_db_out` (a word break at the embedded capital `Db`), not `influxdb_out` as published in `docs/design/pipeline-graph.md` and every example config.",
          "type": "object",
          "required": [
            "bucket",
            "org",
            "token",
            "type",
            "url"
          ],
          "properties": {
            "bucket": {
              "type": "string"
            },
            "org": {
              "type": "string"
            },
            "token": {
              "description": "A plain string field like any other -- give it `!env INFLUXDB_TOKEN` in config to pull it from the environment (`crates/logit-cli/src/config.rs`) rather than inlining it. No env-specific field of its own: `!env` works on any field on any component, so `url`/`org`/`bucket` (just as deployment-specific) can use it too.",
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "influxdb_out"
              ]
            },
            "url": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "endpoint",
            "type"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "otlp_out"
              ]
            }
          }
        },
        {
          "description": "The native logit-to-logit protocol (`docs/design/wire-protocol.md`).",
          "type": "object",
          "required": [
            "endpoint",
            "type"
          ],
          "properties": {
            "endpoint": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "enum": [
                "logit_out"
              ]
            }
          }
        }
      ],
      "properties": {
        "sources": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
