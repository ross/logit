{
 "resourceMetrics": [
  {
   "resource": {
    "attributes": [
     {
      "key": "service.name",
      "value": {
       "stringValue": "checkout"
      }
     },
     {
      "key": "host.name",
      "value": {
       "stringValue": "web-1"
      }
     }
    ]
   },
   "scopeMetrics": [
    {
     "scope": {
      "name": "io.opentelemetry.contrib.runtime",
      "version": "1.2.0",
      "attributes": [
       {
        "key": "library.language",
        "value": {
         "stringValue": "go"
        }
       }
      ]
     },
     "metrics": [
      {
       "name": "system.memory.utilization",
       "unit": "1",
       "description": "Memory in use.",
       "gauge": {
        "dataPoints": [
         {
          "startTimeUnixNano": "1799999930000000000",
          "timeUnixNano": "1799999990000000000",
          "asDouble": 0.625,
          "attributes": [
           {
            "key": "state",
            "value": {
             "stringValue": "used"
            }
           }
          ]
         }
        ]
       }
      },
      {
       "name": "jvm.thread.count",
       "unit": "{thread}",
       "gauge": {
        "dataPoints": [
         {
          "timeUnixNano": "1799999990000000000",
          "asInt": "42"
         }
        ]
       }
      },
      {
       "name": "room.temperature.offset",
       "unit": "Cel",
       "gauge": {
        "dataPoints": [
         {
          "timeUnixNano": "1799999990000000000",
          "asDouble": -4.5,
          "attributes": [
           {
            "key": "room",
            "value": {
             "stringValue": "lab"
            }
           }
          ]
         }
        ]
       }
      }
     ]
    }
   ]
  }
 ]
}
