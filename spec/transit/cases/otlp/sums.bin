{
 "resourceMetrics": [
  {
   "resource": {
    "attributes": [
     {
      "key": "service.name",
      "value": {
       "stringValue": "checkout"
      }
     },
     {
      "key": "host.name",
      "value": {
       "stringValue": "web-1"
      }
     }
    ]
   },
   "scopeMetrics": [
    {
     "scope": {
      "name": "io.opentelemetry.contrib.runtime",
      "version": "1.2.0",
      "attributes": [
       {
        "key": "library.language",
        "value": {
         "stringValue": "go"
        }
       }
      ]
     },
     "metrics": [
      {
       "name": "http.server.requests",
       "unit": "{request}",
       "description": "Requests served.",
       "sum": {
        "aggregationTemporality": 1,
        "isMonotonic": true,
        "dataPoints": [
         {
          "startTimeUnixNano": "1799999980000000000",
          "timeUnixNano": "1799999990000000000",
          "asDouble": 12.5,
          "attributes": [
           {
            "key": "http.route",
            "value": {
             "stringValue": "/cart"
            }
           }
          ]
         }
        ]
       }
      },
      {
       "name": "queue.depth.change",
       "unit": "{item}",
       "sum": {
        "aggregationTemporality": 1,
        "dataPoints": [
         {
          "startTimeUnixNano": "1799999980000000000",
          "timeUnixNano": "1799999990000000000",
          "asInt": "-3",
          "attributes": [
           {
            "key": "queue",
            "value": {
             "stringValue": "orders"
            }
           }
          ]
         }
        ]
       }
      },
      {
       "name": "process.cpu.time",
       "unit": "s",
       "description": "CPU time by state.",
       "sum": {
        "aggregationTemporality": 2,
        "isMonotonic": true,
        "dataPoints": [
         {
          "startTimeUnixNano": "1799999930000000000",
          "timeUnixNano": "1799999990000000000",
          "asDouble": 81.25,
          "attributes": [
           {
            "key": "cpu.mode",
            "value": {
             "stringValue": "user"
            }
           }
          ]
         },
         {
          "startTimeUnixNano": "1799999930000000000",
          "timeUnixNano": "1799999990000000000",
          "asDouble": 9.75,
          "attributes": [
           {
            "key": "cpu.mode",
            "value": {
             "stringValue": "system"
            }
           }
          ]
         }
        ]
       }
      },
      {
       "name": "db.client.connections.usage",
       "unit": "{connection}",
       "sum": {
        "aggregationTemporality": 2,
        "dataPoints": [
         {
          "startTimeUnixNano": "1799999930000000000",
          "timeUnixNano": "1799999990000000000",
          "asInt": "7",
          "attributes": [
           {
            "key": "pool.name",
            "value": {
             "stringValue": "primary"
            }
           }
          ]
         }
        ]
       }
      }
     ]
    }
   ]
  }
 ]
}
