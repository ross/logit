/target
.env
*.log
__pycache__/

# tools/* are each their own standalone [workspace] (never a member of the root one -- see
# tools/protogen/Cargo.toml), so their build output lands in their own target/, not the root one.
/tools/*/target

# script/perf run's output (crates/logit-perf, docs/adr/load-test-harness.md) -- deliberately
# untracked: a results file records one machine's numbers at one commit, not something to commit.
/perf/results/
