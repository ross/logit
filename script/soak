#!/bin/bash
# Usage: script/soak run <scenario> [--duration 20m] [--seed N] [--keep] [--out DIR]
#        script/soak list | check <run-dir> | self-test
#
# Runs a soak scenario from tools/soak/scenarios/: real `logit` containers under network and
# lifecycle faults on a timeline, scored by a watchdog. See tools/soak/README.md for what it runs
# and what it writes, and docs/plans/soak-harness.md for the design.
#
# Not part of script/cibuild: it drives the host's docker daemon, and no test depends on it.
#
#   SOAK_SKIP_IMAGE=1   reuse the existing logit:soak and logit-soak-netem:local images
#   SOAK_OUT=<dir>      where run directories go (default perf/results/soak)

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TOOLS_DIR="${ROOT}/tools/soak"
IMAGE="logit:soak"
NETEM_IMAGE="logit-soak-netem:local"

python3 -c 'import sys; sys.exit(sys.version_info < (3, 11))' || {
    echo "soak: needs Python 3.11 or later on the host (tomllib)" >&2
    exit 1
}

if [ "${1:-}" != "run" ]; then
    exec python3 "${TOOLS_DIR}/soak.py" "$@"
fi

scenario="${2:-}"
if [ -z "${scenario}" ]; then
    echo "usage: script/soak run <scenario> [--duration 20m] [--seed N] [--keep] [--out DIR]" >&2
    exit 2
fi
scenario_dir="${TOOLS_DIR}/scenarios/${scenario}"
[ -f "${scenario_dir}/scenario.toml" ] || {
    echo "soak: no scenario ${scenario} under ${TOOLS_DIR}/scenarios" >&2
    exit 2
}

python3 "${TOOLS_DIR}/soak.py" self-test

# The driver runs every docker command as `sudo -n` so an expired ticket fails instead of
# prompting mid-run; this primes the ticket.
${DOCKER} version >/dev/null

if [ -n "${SOAK_SKIP_IMAGE:-}" ]; then
    for image in "${IMAGE}" "${NETEM_IMAGE}"; do
        ${DOCKER} image inspect "${image}" >/dev/null 2>&1 || {
            echo "soak: SOAK_SKIP_IMAGE is set but ${image} does not exist" >&2
            exit 1
        }
    done
else
    echo "soak: building ${IMAGE} from the current tree"
    ${DOCKER} build -q -f "${ROOT}/Dockerfile" -t "${IMAGE}" "${ROOT}" >/dev/null
    echo "soak: building ${NETEM_IMAGE}"
    ${DOCKER} build -q -t "${NETEM_IMAGE}" "${TOOLS_DIR}/netem" >/dev/null
fi

for config in "${scenario_dir}"/logit-*.yaml; do
    ${DOCKER} run --rm -v "${config}:/config.yaml:ro,z" "${IMAGE}" validate /config.yaml >/dev/null || {
        echo "soak: ${config} failed 'logit validate'" >&2
        exit 1
    }
done

export DOCKER SOAK_IMAGE="${IMAGE}"
exec python3 "${TOOLS_DIR}/soak.py" "$@"
