#!/bin/bash
# Usage: script/bench [filter] [divan args...]
# Throughput benchmarks with per-benchmark allocation counts (crates/logit-bench, divan's
# AllocProfiler). A filter runs only the benches whose path contains it: `script/bench
# syslog_decode`. See docs/design/memory.md for what the numbers mean.
#
# Not part of script/cibuild: wall-clock timing on a shared runner measures the runner. The
# allocation counts that must hold are assertions in crates/logit-bench/tests/allocations.rs.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

run cargo bench -p logit-bench -- "$@"
