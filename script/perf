#!/bin/bash
# Usage: script/perf run [--scenario NAME]... [--repeat N] [--label TEXT] [--settle 1s] [--no-build] [--profile release] [--logit-bin PATH]
#        script/perf compare <a.json> <b.json> [--threshold 5.0] [--rss-threshold PCT]
#        script/perf attribute --scenario NAME [--interval 1s] [--settle 1s] [--no-build] [--profile release] [--logit-bin PATH]
#        script/perf flamegraph --scenario NAME [--out perf/results/NAME.svg] [--freq 999] [--no-build]
#        script/perf list
# Load-test harness (crates/logit-perf): runs the release `logit` binary against
# perf/scenarios/*.yaml and measures throughput, CPU per event, and peak RSS. `--logit-bin PATH`
# (relative to the repo root) measures a stashed binary instead of building one. See
# docs/adr/load-test-harness.md.
#
# Not part of script/cibuild: it loads the machine heavily, and on a shared runner its numbers
# measure the runner (ADR `load-test-harness`).

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

# Computed on the host: a git worktree's `.git` file points at a host path the dev container's
# bind mount doesn't include, so `git` inside the container can't answer (see `git_info` in
# crates/logit-perf/src/run.rs).
#
# Passed as argv to `env`, not through compose.yaml's `environment:` block: `sudo` strips the
# calling shell's environment before compose interpolates `${VAR}`, while `run()`'s argv reaches
# the process unchanged, locally or in CI.
LOGIT_PERF_GIT_SHA="$(git rev-parse HEAD 2>/dev/null)" || LOGIT_PERF_GIT_SHA=""
if LOGIT_PERF_GIT_PORCELAIN="$(git status --porcelain 2>/dev/null)"; then
    if [ -n "${LOGIT_PERF_GIT_PORCELAIN}" ]; then
        LOGIT_PERF_GIT_DIRTY=1
    else
        LOGIT_PERF_GIT_DIRTY=0
    fi
else
    LOGIT_PERF_GIT_DIRTY=""
fi

# `flamegraph` runs in its own image (crates/logit-perf/Dockerfile): `perf`/`inferno` aren't in
# the dev image, and `perf record` needs capabilities the `dev` service shouldn't have. It mounts
# the `dev` service's bind mount and the two named volumes compose.yaml pins with `name:`, so it
# reuses the warm caches.
#
# Three security flags (docs/design/performance.md, "Flamegraph"): SYS_ADMIN because the kernel's
# default perf_event_paranoid refuses perf_event_open, seccomp=unconfined because Docker's default
# profile gates it on CAP_PERFMON, and label=disable because SELinux's container_t denies perf
# events with a zero-sample perf.data that looks like a capability problem. No `:z` on the bind
# mount: with labeling disabled there's nothing to relabel, and `:z` would recursively relabel the
# whole checkout, target/ included, on every run.
if [ "${1:-}" = "flamegraph" ] && ! in_project_environment; then
    # The profiling image is `FROM logit-dev:local`, so build that first or a fresh checkout fails
    # on the FROM line.
    build_image
    ${DOCKER} build -t logit-perf:local -f crates/logit-perf/Dockerfile crates/logit-perf
    exec ${DOCKER} run --rm \
        --cap-add SYS_ADMIN \
        --security-opt seccomp=unconfined \
        --security-opt label=disable \
        -u 1000:1000 -w /work \
        -v "${ROOT}:/work" \
        -v logit_cargo_home:/home/dev/.cargo \
        -v logit_target_cache:/work/target \
        -e CARGO_HOME=/home/dev/.cargo \
        -e CARGO_TARGET_DIR=/work/target \
        -e LOGIT_DEV_CONTAINER=1 \
        -e "LOGIT_PERF_GIT_SHA=${LOGIT_PERF_GIT_SHA}" \
        -e "LOGIT_PERF_GIT_DIRTY=${LOGIT_PERF_GIT_DIRTY}" \
        logit-perf:local \
        cargo run -q -p logit-perf -- "$@"
fi

if [ -n "${LOGIT_PERF_GIT_SHA}" ]; then
    run env "LOGIT_PERF_GIT_SHA=${LOGIT_PERF_GIT_SHA}" "LOGIT_PERF_GIT_DIRTY=${LOGIT_PERF_GIT_DIRTY}" \
        cargo run -q -p logit-perf -- "$@"
else
    run cargo run -q -p logit-perf -- "$@"
fi
