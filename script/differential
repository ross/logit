#!/bin/bash
# Usage: script/differential <corpus> [--check]
#   Corpora: pickle (testdata/differential/graphite-pickle/, from tools/differential/pickle/)
#            prom-text (testdata/differential/prometheus-text/reference/, from
#            tools/differential/prom-text/)
#
# Regenerates a differential corpus under testdata/differential/: generated cases, each committed
# beside a reference implementation's reading of it, which tests read with no reference installed
# (ADR `out-of-ci-fuzzing`'s "Seeds and differential corpora"). Review `git diff --stat
# testdata/differential/` and commit.
#
# --check regenerates into a temporary directory outside the repository and fails, exit 1, if the
# result differs from the committed files: a stale corpus, or a generator that isn't deterministic.
#
# Runs on the host and drives docker, like script/record-fixtures. Every image is pinned by tag and
# digest, so a rerun writes the same bytes. Not part of script/cibuild.

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

# CPython 3.12.15, the version testdata/interop/graphite/README.md records for the CPython pickle
# captures, and Python 2.7.18, the last Python 2, for the cPickle senders.
PY3_IMAGE="python:3.12.15-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1"
PY2_IMAGE="python:2.7.18-slim@sha256:6c1ffdff499e29ea663e6e67c9b6b9a3b401d554d2c9f061f9a45344e3992363"

# Go 1.27.2, which builds the Prometheus 3.14.0 module tools/differential/prom-text/go.mod pins
# (`github.com/prometheus/prometheus v0.314.0`, the release whose `prompb` is vendored under
# crates/logit-proto/proto/prometheus/).
GO_IMAGE="golang:1.27.2-bookworm@sha256:5cf287a799e6b94384bad13d16b14904c531f51ba65792237e122ce42b392f61"
# The Go module and build caches: downloaded modules are untrusted data, so they live in a docker
# volume rather than under the repository. `docker volume rm` it to start clean.
GO_CACHE_VOLUME="logit-differential-go"

usage() {
    sed -n '2,5p' "$0" >&2
    exit 2
}

# generate_pickle <out_dir>: writes the carbon pickle corpus into <out_dir>. gen_py2.py writes the
# Python 2 payloads into a scratch directory; gen_cases.py reads them, pickle.rs's opcode lists,
# and testdata/interop/graphite/, and writes every case. Neither container has a network.
# `-P -s` keeps the script's directory and the user site off `sys.path` and, unlike `-I`, honors
# PYTHONHASHSEED.
generate_pickle() {
    local out="$1" scratch
    scratch="$(mktemp -d)"
    # shellcheck disable=SC2064
    trap "rm -rf '${scratch}'" RETURN
    local gen="${ROOT}/tools/differential/pickle"
    local user
    user="$(id -u):$(id -g)"

    ${DOCKER} run --rm --network none --user "${user}" -e PYTHONHASHSEED=0 \
        -v "${gen}:/gen:ro,z" -v "${scratch}:/work:z" \
        "${PY2_IMAGE}" python2 /gen/gen_py2.py /work/py2.json
    ${DOCKER} run --rm --network none --user "${user}" -e PYTHONHASHSEED=0 \
        -v "${gen}:/gen:ro,z" -v "${scratch}:/work:ro,z" \
        -v "${ROOT}/crates/logit-proto/src/graphite/pickle.rs:/src/pickle.rs:ro,z" \
        -v "${ROOT}/testdata/interop/graphite:/interop:ro,z" \
        -v "${out}:/out:z" \
        "${PY3_IMAGE}" python3 -P -s /gen/gen_cases.py --py2 /work/py2.json \
            --allowlist /src/pickle.rs --interop /interop --out /out
}

# generate_prom_text <out_dir>: writes Prometheus's reading of every hand-built case and every
# recorded scrape body (testdata/interop/prometheus-scrape/) into <out_dir>/cases/ and
# <out_dir>/prometheus-scrape/. The first container downloads the modules go.sum names, the only
# step with a network; the second builds and runs the program with none, and with the module proxy
# off, so it can only use what go.sum verified.
generate_prom_text() {
    local out="$1"
    local gen="${ROOT}/tools/differential/prom-text"
    local user
    user="$(id -u):$(id -g)"
    local env=(-e HOME=/tmp -e GOTOOLCHAIN=local -e GOFLAGS=-mod=readonly
        -e GOPATH=/cache/gopath -e GOCACHE=/cache/build)

    ${DOCKER} run --rm -v "${GO_CACHE_VOLUME}:/cache" "${GO_IMAGE}" chown "${user}" /cache
    ${DOCKER} run --rm --user "${user}" "${env[@]}" -v "${GO_CACHE_VOLUME}:/cache" \
        -v "${gen}:/gen:ro,z" -w /gen "${GO_IMAGE}" go mod download
    ${DOCKER} run --rm --network none --user "${user}" "${env[@]}" -e GOPROXY=off \
        -v "${GO_CACHE_VOLUME}:/cache" -v "${gen}:/gen:ro,z" \
        -v "${ROOT}/testdata/differential/prometheus-text/cases:/cases:ro,z" \
        -v "${ROOT}/testdata/interop/prometheus-scrape:/recorded:ro,z" \
        -v "${out}:/out:z" -w /gen "${GO_IMAGE}" \
        bash -c 'go build -o /cache/prom-text . && /cache/prom-text -cases /cases \
            -recorded /recorded -out /out'
}

[ $# -ge 1 ] || usage
corpus="$1"
shift
check=0
case "${1:-}" in
    --check) check=1 ;;
    "") ;;
    *) usage ;;
esac

case "${corpus}" in
    pickle) committed="${ROOT}/testdata/differential/graphite-pickle" ;;
    prom-text) committed="${ROOT}/testdata/differential/prometheus-text/reference" ;;
    *) usage ;;
esac

if [ "${check}" = 1 ]; then
    out="$(mktemp -d)"
    trap 'rm -rf "${out}"' EXIT
    "generate_${corpus//-/_}" "${out}"
    if diff -r -x README.md "${committed}" "${out}"; then
        echo "differential: ${committed#"${ROOT}/"} is current"
    else
        echo "differential: ${committed#"${ROOT}/"} is stale; run script/differential ${corpus}" >&2
        exit 1
    fi
else
    mkdir -p "${committed}"
    # Every file a generator writes, so a case it no longer writes doesn't linger. The pickle
    # corpus is one flat directory; the prom-text readings sit under per-source subdirectories.
    find "${committed}" -type f ! -name README.md -delete
    "generate_${corpus//-/_}" "${committed}"
fi
