#!/bin/bash
# Usage: script/server [config-file]
# Starts the local InfluxDB + Grafana stack and runs logit against a config file (default:
# examples/statsd-to-influxdb.yaml) -- the v0.1 vertical slice (statsd -> Lua -> InfluxDB, see
# docs/OVERVIEW.md), working end to end via `logit run`.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

CONFIG="${1:-examples/statsd-to-influxdb.yaml}"

${COMPOSE} up -d influxdb grafana
run cargo run -p logit-cli -- run "${CONFIG}"
