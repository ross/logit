#!/bin/bash
# Usage: script/server [config-file]
# Starts the local InfluxDB, Grafana, and nginx stack and runs `logit run` against a config file
# (default: examples/statsd-to-influxdb.yaml). examples/nginx-to-influxdb.yaml exercises the nginx
# service.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

CONFIG="${1:-examples/statsd-to-influxdb.yaml}"

# Execs into the `up`-managed `dev` container, not through common.sh's `run`: compose applies the
# `logit` network alias only to the `up` container, not to a `compose run` one. nginx resolves
# `syslog:server=logit:5140` once at startup, so anywhere else its datagrams are silently lost.
${COMPOSE} up -d dev influxdb grafana nginx
${COMPOSE} exec dev cargo run -p logit-cli -- run "${CONFIG}"
