#!/bin/bash
# Usage: script/shape-survey [producer ...]
#   Producers: every tools/shape-survey/producers/*.sh. With no arguments, surveys all of them.
#
# Drives real or replayed telemetry through `logit`'s `shape` component and summarizes what the
# events look like. See tools/shape-survey/README.md for the producers, the environment
# variables, what a run writes, and how to add a producer.
#
# Not part of script/cibuild: it runs real third-party software and produces measurements.

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TOOLS_DIR="${ROOT}/tools/shape-survey"
source "${TOOLS_DIR}/lib.sh"

# `producers/<name>.sh` defines `survey_<name>`, with `-` in a filename mapping to `_` in the
# function name (`otel-demo.sh` -> `survey_otel_demo`).
available=()
for file in "${TOOLS_DIR}"/producers/*.sh; do
    [ -e "${file}" ] || continue
    name="$(basename "${file}" .sh)"
    available+=("${name}")
    # shellcheck source=/dev/null
    source "${file}"
done

if [ "${#available[@]}" -eq 0 ]; then
    echo "shape-survey: no producers under ${TOOLS_DIR}/producers/" >&2
    exit 1
fi

producers=("$@")
if [ "${#producers[@]}" -eq 0 ]; then
    producers=("${available[@]}")
fi

for p in "${producers[@]}"; do
    fn="survey_${p//-/_}"
    if ! declare -F "${fn}" >/dev/null; then
        echo "shape-survey: unknown producer '${p}' -- have: ${available[*]}" >&2
        exit 1
    fi
done

trap survey_cleanup EXIT

# Before anything expensive: a render change that broke the summarizer fails here, not after a
# capture.
survey_self_test

survey_image

# One producer at a time, each namespaced by `survey_begin` and torn down before the next starts.
# The namespacing is also what makes two concurrent invocations safe (README "Two surveys at
# once").
for p in "${producers[@]}"; do
    echo "== surveying: ${p} =="
    survey_begin "${p}"
    "survey_${p//-/_}"
    survey_cleanup
done

echo "Surveys written under ${SHAPE_SURVEY_OUT:-${ROOT}/perf/results/shape-survey}/ -- read each run's summary.md."
