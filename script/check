#!/bin/bash
# Usage: script/check [nextest arguments]
# Runs the routine development checks. Use script/cibuild for the complete CI-equivalent
# preflight, including supply-chain checks.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

if ! in_project_environment; then
    run ./script/check "$@"
    exit
fi

echo "## format ########################################################################"
"${SCRIPT_PATH}/format" --check

echo "## lint ##########################################################################"
"${SCRIPT_PATH}/lint"

echo "## test ##########################################################################"
"${SCRIPT_PATH}/test" "$@"

echo "## complete ######################################################################"
