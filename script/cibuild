#!/bin/bash
# Usage: script/cibuild
# Runs the same checks, in the same order, that CI runs (.github/workflows/ci.yml calls this
# script directly rather than duplicating its steps) -- so "does this pass CI?" has exactly one
# place to look, and this is the real preflight check, not an approximation of one.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

echo "## bootstrap #####################################################################"
"${SCRIPT_PATH}/bootstrap"

echo "## format ########################################################################"
"${SCRIPT_PATH}/format" --check

echo "## lint ##########################################################################"
"${SCRIPT_PATH}/lint"

echo "## test ##########################################################################"
"${SCRIPT_PATH}/test"

echo "## validate shipped configs ######################################################"
"${SCRIPT_PATH}/validate"

echo "## schema drift ##################################################################"
BEFORE="$(mktemp)"
cp schema/logit.schema.json "${BEFORE}"
"${SCRIPT_PATH}/schema"
if ! diff -u "${BEFORE}" schema/logit.schema.json; then
    echo "schema/logit.schema.json is stale -- run ./script/schema and commit the result"
    exit 1
fi
rm -f "${BEFORE}"

echo "## supply chain ##################################################################"
"${SCRIPT_PATH}/audit"

echo "## complete ######################################################################"
