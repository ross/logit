#!/bin/bash
# Usage: script/cibuild
# Runs the checks CI runs, in the same order. .github/workflows/ci.yml calls this script rather
# than duplicating its steps, so a clean local run means a clean CI run.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

if ! in_project_environment; then
    echo "## bootstrap #####################################################################"
    "${SCRIPT_PATH}/bootstrap"
    run ./script/cibuild
    exit
fi

echo "## bootstrap #####################################################################"
"${SCRIPT_PATH}/bootstrap"

echo "## format ########################################################################"
"${SCRIPT_PATH}/format" --check

echo "## lint ##########################################################################"
"${SCRIPT_PATH}/lint"

echo "## test ##########################################################################"
"${SCRIPT_PATH}/test"

echo "## supply chain ##################################################################"
"${SCRIPT_PATH}/audit"

echo "## complete ######################################################################"
