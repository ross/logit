#!/bin/bash
# Usage: script/demo [compose args...]
# Runs the self-contained demo stack (demo/README.md) from the release image (Dockerfile), with no
# dev container. Defaults to `up --build`; pass any docker compose subcommand instead, such as
# `script/demo down -v` or `script/demo logs -f logit`.
#
# Uses `-f demo/compose.yaml`, not `cd demo`: compose takes the first -f file's directory as the
# project directory, so demo/compose.yaml's relative paths resolve from any working directory.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

if [ "$#" -eq 0 ]; then
    set -- up --build
fi

${DOCKER} compose -f demo/compose.yaml "$@"
