#!/bin/bash
# Usage: script/vm build <ref|dir|tarball>... [--allow-identical]
#
# Runs on the perf VM, fed on stdin by script/vm (`ssh ... 'bash -s -- <source>...'`), so it
# can't go stale against the checkout that invoked it; edit the two together. Builds one release
# `logit` per source into ~/logit/perf/bins/<slug>/logit, beside a `logit.json` sidecar that
# `logit-perf run --logit-bin` reads for provenance. See docs/adr/disposable-azure-perf-vm.md's
# "Multiple sources, one VM" section.
#
#   a git ref/SHA   checked out in turn in ~/logit, the clone `up` made, and built there.
#   a directory     already on the VM, built in place with its own CARGO_TARGET_DIR.
#   a tarball       extracted to ~/src/<slug>/ with `tar -xm`, then built like a directory.
#
# Cargo fingerprints by mtime, so trees extracted at about the same time into one shared target
# dir can build a stale, identical binary under a different label. A `git checkout` in one clone
# stamps each changed file with the current time, so ref builds share the clone's target dir
# safely; a directory or tarball source has no such guarantee and always gets its own. Exits
# non-zero if any source fails or two sources build the identical binary.

set -e -o pipefail

LOGIT_HOME="${HOME}/logit"
BINS_DIR="${LOGIT_HOME}/perf/bins"
SRCS_DIR="${HOME}/src"
# `ssh host 'bash -s'` is a non-login shell that never sources /etc/profile, and this must not
# depend on pam_env reading /etc/environment.
export DOCKER=docker

# `push` copies into $HOME by default, so a relative directory source (`script/vm build wip`)
# resolves against it rather than wherever ssh started the shell.
cd "${HOME}"

ALLOW_IDENTICAL=0
SOURCES=()
for arg in "$@"; do
    case "${arg}" in
        --allow-identical) ALLOW_IDENTICAL=1 ;;
        --) ;;
        *) SOURCES+=("${arg}") ;;
    esac
done
if [ "${#SOURCES[@]}" -eq 0 ]; then
    echo "usage: script/vm build <ref|dir|tarball>... [--allow-identical]" >&2
    exit 2
fi
if [ ! -d "${LOGIT_HOME}/.git" ]; then
    echo "FATAL: ${LOGIT_HOME} is not a git clone -- run 'script/vm up' first." >&2
    exit 1
fi

mkdir -p "${BINS_DIR}" "${SRCS_DIR}"

# --- classification ----------------------------------------------------------------------------

# A source is a path if it exists on the VM or has a path shape (absolute, `./`, `~/`, or an
# archive extension); anything else is a git ref. There's no flag to force either reading.
is_path_source() {
    # `\~/*`, not `~/*`: bash tilde-expands an unescaped tilde in a case pattern to $HOME, which
    # then fails to match the literal "~/..." a caller typed.
    case "$1" in
        /*|./*|\~/*|*.tar|*.tar.gz|*.tgz) return 0 ;;
    esac
    [ -e "$1" ]
}

# A ref keeps its whole name with each character outside `[A-Za-z0-9_-]` mapped to `-`
# (`udp/w3` -> `udp-w3`); a 7-40 character hex string (a SHA) shortens to 12 characters.
slug_for_ref() {
    local raw="$1"
    if [[ "${raw}" =~ ^[0-9a-f]{7,40}$ ]]; then
        echo "${raw:0:12}"
    else
        printf '%s' "${raw}" | tr -c 'A-Za-z0-9_-' '-'
    fi
}

# A path slugs from its basename minus any archive suffix (`~/w3.tar.gz` -> `w3`).
slug_for_path() {
    local raw="$1" base
    base="$(basename -- "${raw}")"
    case "${base}" in
        *.tar.gz) base="${base%.tar.gz}" ;;
        *.tgz) base="${base%.tgz}" ;;
        *.tar) base="${base%.tar}" ;;
    esac
    printf '%s' "${base}" | tr -c 'A-Za-z0-9_-' '-'
}

# --- one container invocation, target dir chosen by the caller ---------------------------------

# compose.yaml gives `logit_cargo_home`/`logit_target_cache` fixed global `name:`s, so every tree
# on the VM shares one warm cargo cache. Only CARGO_TARGET_DIR changes per source, and common.sh's
# `run()` takes no extra `-e`, so this calls compose directly.
container_build_and_stash() {
    local tree_dir="$1" target_dir="$2" slug="$3"
    (
        cd "${tree_dir}"
        source "${tree_dir}/script/common.sh" >/dev/null
        build_image
        ${COMPOSE} run --rm -e LOGIT_DEV_CONTAINER=1 -e "CARGO_TARGET_DIR=${target_dir}" dev \
            bash -c "set -e; mkdir -p '/work/perf/bins/${slug}' && \
                cargo build --profile release -p logit-cli && \
                cp '${target_dir}/release/logit' '/work/perf/bins/${slug}/logit'"
    )
}

# Escapes backslash and double quote, the two characters that break the JSON write_sidecar builds.
json_escape() {
    printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

# Writes the sidecar `crates/logit-perf/src/run.rs::read_binary_sidecar` reads. `printf`, not an
# unquoted heredoc, which would execute a backtick or `$(...)` in a source string.
write_sidecar() {
    local slug="$1" source_desc sha sha256 sha_json
    source_desc="$(json_escape "$2")"
    sha256="$(json_escape "$4")"
    sha_json="null"
    if [ -n "$3" ]; then
        sha_json="\"$(json_escape "$3")\""
    fi
    printf '{"source": "%s", "sha": %s, "sha256": "%s", "built_at": "%s", "profile": "release"}\n' \
        "${source_desc}" "${sha_json}" "${sha256}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
        > "${BINS_DIR}/${slug}/logit.json"
}

# --- per-source builds ---------------------------------------------------------------------------

declare -a RESULT_SLUGS=() RESULT_SOURCES=() RESULT_SHAS=() RESULT_SHA256S=()
LAST_REF_SEEN=""

build_ref() {
    local ref="$1" slug
    slug="$(slug_for_ref "${ref}")"
    echo "== ${ref} (git ref) -> perf/bins/${slug}/logit"

    ( cd "${LOGIT_HOME}" && git fetch --tags --prune origin ) >/dev/null

    local sha
    if sha="$(cd "${LOGIT_HOME}" && git rev-parse --verify "${ref}^{commit}" 2>/dev/null)"; then
        :
    elif sha="$(cd "${LOGIT_HOME}" && git rev-parse --verify "origin/${ref}^{commit}" 2>/dev/null)"; then
        :
    else
        echo "   FAILED: '${ref}' does not resolve to a commit (checked as given, and as origin/${ref})" >&2
        return 1
    fi
    ( cd "${LOGIT_HOME}" && git checkout --detach "${sha}" --quiet )
    LAST_REF_SEEN="${ref}"

    # Ref builds share the clone's target dir (see the header); LOGIT_VM_TARGET_PER_REF isolates
    # each one at the cost of a full rebuild.
    local target_dir="/work/target"
    if [ -n "${LOGIT_VM_TARGET_PER_REF:-}" ]; then
        target_dir="/work/target/refs/${slug}"
    fi
    container_build_and_stash "${LOGIT_HOME}" "${target_dir}" "${slug}"

    local sha256
    sha256="$(sha256sum "${BINS_DIR}/${slug}/logit" | cut -d' ' -f1)"
    write_sidecar "${slug}" "${ref}" "${sha}" "${sha256}"

    RESULT_SLUGS+=("${slug}")
    RESULT_SOURCES+=("${ref} (${sha:0:12})")
    RESULT_SHAS+=("${sha}")
    RESULT_SHA256S+=("${sha256}")
}

build_path() {
    local given="$1" slug tree_dir kind
    slug="$(slug_for_path "${given}")"

    case "${given}" in
        *.tar|*.tar.gz|*.tgz)
            kind="tar"
            tree_dir="${SRCS_DIR}/${slug}"
            echo "== ${given} (tarball) -> perf/bins/${slug}/logit"
            [ -f "${given}" ] || { echo "   FAILED: no such file: ${given}" >&2; return 1; }
            rm -rf "${tree_dir}"
            mkdir -p "${tree_dir}"
            # Strip a single top-level directory, so `git archive --prefix=logit/` and a bare
            # `tar czf ... .` both land the repo's files directly under tree_dir.
            local top_entries strip_args=()
            top_entries="$(tar -tf "${given}" | sed -e 's#/.*##' -e '/^$/d' | sort -u)"
            if [ "$(printf '%s\n' "${top_entries}" | wc -l)" -eq 1 ]; then
                strip_args=(--strip-components=1)
            fi
            # -m stamps each file with the current time. `git archive` records commit times,
            # which would make the tree look older than a fingerprint cargo already has.
            tar -xm "${strip_args[@]}" -f "${given}" -C "${tree_dir}"
            ;;
        *)
            kind="dir"
            tree_dir="${given/#\~/${HOME}}"
            echo "== ${given} (directory) -> perf/bins/${slug}/logit"
            [ -d "${tree_dir}" ] || { echo "   FAILED: no such directory: ${tree_dir}" >&2; return 1; }
            ;;
    esac

    for required in Cargo.toml script/common.sh compose.yaml; do
        if [ ! -e "${tree_dir}/${required}" ]; then
            echo "   FAILED: ${tree_dir} has no ${required} -- not a logit checkout" >&2
            return 1
        fi
    done

    # Always isolated: no `git checkout` guarantees this tree's mtimes are newer than the last
    # build in a shared target dir.
    local target_dir="/work/target/srcs/${slug}"
    mkdir -p "${BINS_DIR}/${slug}"
    container_build_and_stash "${tree_dir}" "${target_dir}" "${slug}"
    # The build lands under <tree_dir>/perf/bins/; copy it into the clone's perf/bins/, where
    # `--logit-bin` and script/vm look.
    if [ "${tree_dir}" != "${LOGIT_HOME}" ]; then
        cp "${tree_dir}/perf/bins/${slug}/logit" "${BINS_DIR}/${slug}/logit"
    fi

    local sha=""
    if [ -d "${tree_dir}/.git" ]; then
        sha="$(cd "${tree_dir}" && git rev-parse HEAD 2>/dev/null || true)"
    fi
    local sha256
    sha256="$(sha256sum "${BINS_DIR}/${slug}/logit" | cut -d' ' -f1)"
    write_sidecar "${slug}" "${given}" "${sha}" "${sha256}"

    RESULT_SLUGS+=("${slug}")
    if [ -n "${sha}" ]; then
        RESULT_SOURCES+=("${given} (${kind}, ${sha:0:12})")
    else
        RESULT_SOURCES+=("${given} (${kind})")
    fi
    RESULT_SHAS+=("${sha}")
    RESULT_SHA256S+=("${sha256}")
}

FAILED=0
for source in "${SOURCES[@]}"; do
    if is_path_source "${source}"; then
        build_path "${source}" || FAILED=1
    else
        build_ref "${source}" || FAILED=1
    fi
done

# --- duplicate-binary guard (docs/adr/disposable-azure-perf-vm.md) ------------------------------

if [ "${ALLOW_IDENTICAL}" -eq 0 ]; then
    for ((i = 0; i < ${#RESULT_SLUGS[@]}; i++)); do
        for ((j = i + 1; j < ${#RESULT_SLUGS[@]}; j++)); do
            if [ "${RESULT_SHA256S[i]}" = "${RESULT_SHA256S[j]}" ]; then
                echo
                echo "FATAL: '${RESULT_SOURCES[i]}' and '${RESULT_SOURCES[j]}' built to the" >&2
                echo "identical binary (sha256 ${RESULT_SHA256S[i]:0:12}...) -- this is the" >&2
                echo "shared-target-dir mtime hazard this script exists to prevent, unless the" >&2
                echo "two sources really are identical (pass --allow-identical to accept that)." >&2
                FAILED=1
            fi
        done
    done
fi

echo
printf '%-14s %-50s %s\n' "slug" "source" "sha256"
for ((i = 0; i < ${#RESULT_SLUGS[@]}; i++)); do
    printf '%-14s %-50s %s\n' "${RESULT_SLUGS[i]}" "${RESULT_SOURCES[i]}" "${RESULT_SHA256S[i]:0:12}"
done
echo
if [ -n "${LAST_REF_SEEN}" ]; then
    echo "clone left checked out at the last ref built: ${LAST_REF_SEEN}"
fi
echo "run each with, e.g.:"
for slug in "${RESULT_SLUGS[@]}"; do
    echo "  script/perf run --logit-bin perf/bins/${slug}/logit --scenario <name> --repeat 5 ..."
done

exit "${FAILED}"
