#!/bin/bash
# Usage: script/record-fixtures [producer ...]
#   Producers: logger, python-syslog-handler, rsyslog, collectd, otlp, graphite
#   With no arguments, records every producer in `all` below.
#
# Captures real wire traffic from real third-party producers (syslog senders, OTel SDKs) into
# testdata/interop/, so logit's decoders get checked against reality instead of only against this
# team's own understanding of a spec -- see docs/plans/recorded-interop-fixtures.md for the design,
# and testdata/tls/regen.sh / docs/adr/committed-pregenerated-otlp-protobuf.md for the "committed
# artifact regenerated by a script, reviewed as a diff, never re-run by CI" precedent this follows.
#
# Deliberately NOT part of script/cibuild, for the same reason script/protogen and
# testdata/tls/regen.sh aren't: recording from live third-party software (Docker Hub/ghcr.io pulls,
# real producers with their own nondeterminism) is a deliberate, reviewed act, not something CI
# should re-run non-deterministically on every push. Run it by hand, review
# `git diff --stat testdata/interop/` (or `git status`, for a brand-new fixture), and commit.
#
# Adding a producer: write a `record_<name>()` function following the shape of the ones below --
# each producer is one self-contained function using the `start_capture`/`finish_capture` (or, for
# OTLP, the Collector's own `file` exporter) plumbing, not a growing if/elif chain -- and add its
# name to `all` at the bottom.

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TOOLS_DIR="${ROOT}/tools/record-fixtures"
OUT_ROOT="${ROOT}/testdata/interop"
NET="logit-record-fixtures"

# ---- shared plumbing ---------------------------------------------------------------------------

# start_capture <proto> <port> <out_dir> <prefix> <count> [timeout]: launches
# tools/record-fixtures/raw_capture.py in a throwaway python container named "capture" on $NET,
# bind-mounting $out_dir so captured files land there directly -- no copy-out step. Caller must
# call finish_capture once whatever's supposed to produce traffic has been started.
start_capture() {
    local proto="$1" port="$2" out_dir="$3" prefix="$4" count="$5" timeout="${6:-15}"
    mkdir -p "${out_dir}"
    ${DOCKER} run -d --name capture --network "${NET}" \
        -v "${TOOLS_DIR}/raw_capture.py:/raw_capture.py:ro,z" \
        -v "${out_dir}:/out:z" \
        python:3.12-slim \
        python3 /raw_capture.py --proto "${proto}" --port "${port}" --out-dir /out \
            --prefix "${prefix}" --count "${count}" --timeout "${timeout}" \
        >/dev/null
    # Give the listener a moment to actually bind before anything tries to send to it.
    sleep 1
}

# finish_capture: waits for the capture container to exit, prints its log, and fails loudly
# (matching raw_capture.py's own exit code) rather than silently leaving a partial fixture set.
finish_capture() {
    local status
    status="$(${DOCKER} wait capture)"
    ${DOCKER} logs capture 2>&1 | sed 's/^/  [capture] /'
    ${DOCKER} rm -f capture >/dev/null 2>&1 || true
    if [ "${status}" != "0" ]; then
        echo "record-fixtures: capture container exited ${status} -- fixture set incomplete, not committing it" >&2
        return 1
    fi
}

cleanup() {
    ${DOCKER} rm -f capture otelcol >/dev/null 2>&1 || true
    ${DOCKER} network rm "${NET}" >/dev/null 2>&1 || true
}

# ---- producers ----------------------------------------------------------------------------------

# logger(1) -- util-linux's implementation (the `/usr/bin/logger` on essentially every Linux
# distro; verified busybox's own logger applet has no remote-server support at all -- `-n`/`-P`
# aren't recognized -- so it can't reach a network capture listener). Three messages: RFC 3164 and
# RFC 5424 framing (`--rfc3164`/`--rfc5424`), since a real sender's dialect choice is exactly the
# kind of framing variation this corpus exists to check `syslog_in` against; and one with UTF-8
# multibyte content, since real senders do emit non-ASCII MSG bodies and the point here is checking
# logit's decoder against a real one doing it, not just logit's own encoder agreeing with itself.
record_logger() {
    echo "== recording: logger(1) (util-linux, debian:bookworm-slim) =="
    local out="${OUT_ROOT}/syslog"

    start_capture udp 5514 "${out}" logger-rfc3164-basic 1
    ${DOCKER} run --rm --network "${NET}" debian:bookworm-slim \
        logger -n capture -P 5514 -d --rfc3164 -t logit-fixture -p user.notice \
        "hello from logger(1), captured for logit interop fixtures"
    finish_capture

    start_capture udp 5514 "${out}" logger-rfc3164-unicode 1
    ${DOCKER} run --rm --network "${NET}" debian:bookworm-slim \
        logger -n capture -P 5514 -d --rfc3164 -t logit-fixture -p user.notice \
        "héllo wörld — ünïcödé ✓ (UTF-8 multibyte smoke test)"
    finish_capture

    start_capture udp 5514 "${out}" logger-rfc5424-basic 1
    ${DOCKER} run --rm --network "${NET}" debian:bookworm-slim \
        logger -n capture -P 5514 -d --rfc5424 -t logit-fixture -p user.notice \
        "hello from logger(1) in RFC 5424 mode, captured for logit interop fixtures"
    finish_capture
}

# Python's logging.handlers.SysLogHandler, via demo/app/pages/syslog_handler.py's
# NoNulSysLogHandler -- the actual handler class the demo app configures, bind-mounted in and
# imported directly, not a stand-in for it. See tools/record-fixtures/python_syslog_producer.py's
# own docstring for what its two messages cover.
record_python_syslog_handler() {
    echo "== recording: Python logging.handlers.SysLogHandler =="
    local out="${OUT_ROOT}/syslog"
    start_capture udp 5514 "${out}" python-syslog-handler 2
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_syslog_producer.py:/producer/run.py:ro,z" \
        -v "${ROOT}/demo/app/pages/syslog_handler.py:/producer/syslog_handler.py:ro,z" \
        -w /producer python:3.12-slim \
        python3 run.py --host capture --port 5514
    finish_capture
}

# rsyslog, forwarding one message to raw_capture.py over UDP. There's no official `rsyslog/*`
# Docker Hub image (verified -- `rsyslog/rsyslog_deb12` doesn't exist; Docker Hub search turns up
# nothing else officially maintained by the rsyslog project either), so this installs the real
# Debian-packaged `rsyslogd` fresh in a plain `debian:bookworm-slim` container at record time --
# the actual upstream-built binary Debian ships, just not a pre-baked image, and one apt layer
# (~20-30s) slower to start than the other producers. Slower and more moving parts than the other
# producers (apt mirror flakiness is a real, if unlikely, failure mode), so if this stops working
# reliably in practice, it's fine to drop it from `all` below -- see
# docs/plans/recorded-interop-fixtures.md's follow-on notes on this producer.
record_rsyslog() {
    echo "== recording: rsyslog =="
    local out="${OUT_ROOT}/syslog"
    start_capture udp 5514 "${out}" rsyslog 1 90
    # rsyslog.conf is mounted at a path *other* than /etc/rsyslog.conf and passed via `-f`:
    # mounting straight over the package's own /etc/rsyslog.conf makes dpkg treat it as a locally
    # modified conffile and block on an interactive Y/I/N/O/D/Z prompt during `apt-get install`,
    # which hangs forever with no stdin attached (confirmed empirically -- `apt-get`'s own
    # DEBIAN_FRONTEND=noninteractive does not suppress dpkg's conffile prompt, only debconf's).
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/rsyslog.conf:/etc/rsyslog-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/rsyslog-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture
}

# collectd, sending its own binary `network`-plugin protocol to raw_capture.py over UDP. Same
# no-official-image situation as rsyslog above: the collectd project's Docker Hub namespace holds
# exactly one repository, `collectd/ci` (verified) -- a *build-environment* image, one tag per
# distro, carrying the dependencies needed to compile collectd, not a runnable collectd daemon. So
# this installs the real Debian-packaged `collectd-core` fresh into a plain `debian:bookworm-slim`
# at record time, the actual upstream-built binary Debian ships, one apt layer slower to start than
# the pre-baked producers. `collectd-core`, not `collectd`: the metapackage pulls in a long tail of
# plugin dependencies this fixture has no use for.
#
# Three datagrams rather than one: collectd's `network` plugin does not send one datagram per read
# cycle -- it packs value lists into a send buffer and flushes once the next list would not fit
# under `MaxPacketSize` (1452), eliding identity parts that repeat within a packet. Three captures
# that packing, that elision, and -- because a read cycle is ~15 lists against 23-26 per datagram --
# a read cycle split across a datagram boundary, with identity re-stated in full at the start of the
# next one. All three are packed flushes: the capture stops on its own `--count 3`, a few seconds
# in, so a shutdown flush is not in the corpus. The 90s timeout matches record_rsyslog's, for the
# same reason: an apt-get install has to finish first.
#
# A second, separate capture follows for the `threshold` plugin's notification
# (`docs/plans/collectd-binary-relay.md`'s W5): its own `start_capture`/`docker run`/
# `finish_capture` cycle, under the fixture prefix `collectd-notification` rather than `collectd`,
# so `crates/logit-inputs/src/collectd.rs`'s value-list interop tests keep reading exactly
# `collectd-00{0,1,2}.raw` and this addition never perturbs them. The two captures are sequential,
# not concurrent -- the first `finish_capture` tears down its listener container entirely before
# the second `start_capture` stands up a new one on the same port -- but that alone is not enough:
# the second `docker run` mounts its own `collectd-threshold.conf` (a copy of `collectd.conf` plus
# the `threshold` plugin), never the plain `collectd.conf` the first run uses, because `threshold`
# fires on the very first read (`WarningMax 0.0`, see that file's own comment) -- if the *first*
# capture's collectd also loaded it, a notification would land inside `collectd-00{0,1,2}.raw`
# too, breaking every test that assumes those three datagrams are pure value lists. One datagram is
# enough for the second capture: the notification's Message/Severity parts land in the listener's
# very first datagram.
record_collectd() {
    echo "== recording: collectd (network plugin, debian:bookworm-slim) =="
    local out="${OUT_ROOT}/collectd"
    start_capture udp 25826 "${out}" collectd 3 90
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/collectd.conf:/etc/collectd-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/collectd-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture

    echo "== recording: collectd threshold notification =="
    start_capture udp 25826 "${out}" collectd-notification 1 90
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/collectd-threshold.conf:/etc/collectd-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/collectd-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture
}

# OTLP, via the OpenTelemetry Collector's own `file` exporter -- see
# tools/record-fixtures/otel-collector-config.yaml for why that's the fixture rather than a raw
# byte capture -- fed by `telemetrygen`, the OpenTelemetry project's own load-generation tool (a
# real SDK-backed exporter, not a hand-built payload).
record_otlp() {
    echo "== recording: OTLP via opentelemetry-collector-contrib + telemetrygen =="
    local out="${OUT_ROOT}/otlp"
    mkdir -p "${out}"
    # otel/opentelemetry-collector-contrib runs as a fixed non-root uid (10001), which has no
    # relationship to whatever uid owns this checkout -- world-writable is what lets its `file`
    # exporters open their output files regardless of who's running this script.
    chmod 777 "${out}"
    ${DOCKER} run -d --name otelcol --network "${NET}" \
        -v "${TOOLS_DIR}/otel-collector-config.yaml:/etc/otelcol-config.yaml:ro,z" \
        -v "${out}:/output:z" \
        otel/opentelemetry-collector-contrib:latest \
        --config /etc/otelcol-config.yaml \
        >/dev/null
    sleep 3 # let the collector finish binding its receivers

    # A fixed count (--traces/--logs/--metrics), not --duration, so a run always produces the same
    # *shape* of fixture (3 records from 1 worker) regardless of how fast the container starts.
    for signal_and_count in "traces:--traces=3" "logs:--logs=3" "metrics:--metrics=3"; do
        local signal="${signal_and_count%%:*}" count_flag="${signal_and_count#*:}"
        echo "-- telemetrygen ${signal}"
        ${DOCKER} run --rm --network "${NET}" \
            ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:latest \
            "${signal}" --otlp-endpoint otelcol:4317 --otlp-insecure "${count_flag}" \
            || echo "record-fixtures: telemetrygen ${signal} failed -- skipping, see plan doc follow-on list" >&2
    done
    sleep 2 # let the collector's file exporters flush

    ${DOCKER} logs otelcol 2>&1 | sed 's/^/  [otelcol] /'
    ${DOCKER} rm -f otelcol >/dev/null 2>&1 || true
}

# Graphite/Carbon, via two real producers speaking carbon's two wire protocols, both captured
# through raw_capture.py's `--proto tcp` mode (one file per accepted connection): W4a of
# `docs/plans/graphite-carbon-relay.md`.
#
# **Plaintext, via collectd's `write_graphite` plugin** -- the same `load`/`memory`/`interface`
# read plugins `collectd.conf` uses (see that file's comments), but a different output plugin
# entirely: `write_graphite` is a real carbon plaintext *sender*, exercising
# `crates/logit-proto/src/graphite/decode.rs`'s line grammar against something other than this
# codec's own encoder. One connection, not several, on purpose: `write_graphite`'s `<Node>` block
# opens one TCP connection at startup and keeps writing every flush cycle's lines to it,
# reconnecting only on a write error -- unlike collectd's `network` plugin (which flushes
# complete, self-contained UDP datagrams), there is exactly one natural capture unit here: the
# whole connection's byte stream, spanning several one-second read cycles.
# `crates/logit-inputs/src/graphite/mod.rs`'s `interop_fixture_write_graphite_plaintext_decodes`
# feeds the file to the decoder as one buffer of complete `\n`-terminated lines for exactly this
# reason. 90s timeout matches `record_collectd`'s, for the same reason: an `apt-get install
# collectd-core` has to finish first.
#
# **Pickle, via `tools/record-fixtures/python_graphite_pickle_producer.py`** -- a stdlib-only
# (`pickle`, `struct`, `socket`) sender exercising the *other* carbon wire protocol, the
# length-prefixed pickle batch, at `protocol=2` and `protocol=-1` (Python's "highest available",
# which resolves to protocol 5 on `python:3.12-slim`). Two separate captures, not one: each
# protocol needs its own fixture file so a consuming test can pin down which opcodes it is
# checking against (protocol -1 is the one that emits FRAME/SHORT_BINUNICODE/MEMOIZE -- see that
# script's own docstring). `python3 --version` is printed alongside the script's own
# `pickle.HIGHEST_PROTOCOL` line so `testdata/interop/graphite/README.md`'s provenance table can
# record both.
record_graphite() {
    echo "== recording: collectd write_graphite plugin (plaintext TCP, debian:bookworm-slim) =="
    local out="${OUT_ROOT}/graphite"
    start_capture tcp 2003 "${out}" write-graphite 1 90
    # RUN_SECONDS=3, not collectd-entrypoint.sh's default 10: write_graphite holds one TCP
    # connection open for as long as collectd runs (unlike `network`'s UDP datagrams, which flush
    # and stop well before the default elapses), so the fixture size is directly proportional to
    # this -- three read cycles at `Interval 1` is already "several", per this function's own
    # top comment, and keeps the capture in the same size class as this corpus's other fixtures.
    ${DOCKER} run --rm --network "${NET}" -e RUN_SECONDS=3 \
        -v "${TOOLS_DIR}/collectd-write-graphite.conf:/etc/collectd-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/collectd-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture

    echo "== recording: stdlib pickle producer (protocol 2) =="
    start_capture tcp 2004 "${out}" graphite-pickle-p2 1
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_graphite_pickle_producer.py:/producer/run.py:ro,z" \
        -w /producer python:3.12-slim \
        bash -c "python3 --version && python3 run.py --host capture --port 2004 --protocol 2"
    finish_capture

    echo "== recording: stdlib pickle producer (protocol -1, highest) =="
    start_capture tcp 2004 "${out}" graphite-pickle-p5 1
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_graphite_pickle_producer.py:/producer/run.py:ro,z" \
        -w /producer python:3.12-slim \
        bash -c "python3 --version && python3 run.py --host capture --port 2004 --protocol -1"
    finish_capture
}

# ---- entry point ----------------------------------------------------------------------------------

all=(logger python-syslog-handler rsyslog collectd otlp graphite)

producers=("$@")
if [ "${#producers[@]}" -eq 0 ]; then
    producers=("${all[@]}")
fi

${DOCKER} network create "${NET}" >/dev/null 2>&1 || true
trap cleanup EXIT

for p in "${producers[@]}"; do
    case "${p}" in
    logger) record_logger ;;
    python-syslog-handler) record_python_syslog_handler ;;
    rsyslog) record_rsyslog ;;
    collectd) record_collectd ;;
    otlp) record_otlp ;;
    graphite) record_graphite ;;
    *)
        echo "record-fixtures: unknown producer '${p}'" >&2
        exit 1
        ;;
    esac
done

echo "Recorded fixtures under ${OUT_ROOT} -- review the diff (git status/diff testdata/interop) and commit."
