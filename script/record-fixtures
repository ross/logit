#!/bin/bash
# Usage: script/record-fixtures [producer ...]
#   Producers: logger, python-syslog-handler, rsyslog, rsyslog-tcp, collectd, otlp, graphite (also
#              graphite-p0, graphite-py2, graphite-dropwizard, one capture each), prometheus,
#              prometheus-scrape, vmagent, statsd, datadog (= datadog-agent, datadog-tracer,
#              datadog-dogstatsd-unix), splunk (= splunk-otel, splunk-docker, splunk-sc4s,
#              splunk-java, then check_splunk_capture.py), influxdb, kafka, cri
#              (= cri-containerd, a kind node, then cri-crio, a minikube node: each's pod log tree),
#              nginx-status (nginx stable and mainline, Angie, freenginx: each's stub_status page)
#   With no arguments, records every producer in `all` below.
#
# Captures wire traffic from real third-party producers into testdata/interop/, so decoders are
# checked against real senders, not only against a reading of the spec. See
# testdata/interop/README.md. Review `git diff --stat testdata/interop/` (or
# `git status`, for a new fixture) and commit.
#
# Not part of script/cibuild: recording pulls live third-party images and isn't deterministic.
#
# To add a producer, write a self-contained `record_<name>()` on the `start_capture`/
# `finish_capture` plumbing and add its name to `all` at the bottom.

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TOOLS_DIR="${ROOT}/tools/record-fixtures"
OUT_ROOT="${ROOT}/testdata/interop"
NET="logit-record-fixtures"
PROM_CFG_DIR="" # set by record_prometheus, removed by cleanup()
DD_CONF_DIR=""  # set by record_datadog_agent, removed by cleanup()
# The Datadog producers' shared `/var/run/datadog`: the Agent's sockets, or the capture's.
DD_VOLUME="logit-record-fixtures-dd-run"
KAFKA_NET="kafka-record-net"
# The JDK and Maven the Java producers (`graphite`'s Dropwizard capture, `splunk-java`) build in.
MAVEN_IMAGE="maven:3.9.16-eclipse-temurin-17"

# ---- shared plumbing ---------------------------------------------------------------------------

# start_capture <proto> <port> <out_dir> <prefix> <count> [timeout [raw_capture.py args...]]:
# launches tools/record-fixtures/raw_capture.py in a throwaway container named "capture" on $NET,
# writing straight into the bind-mounted $out_dir. Arguments past the timeout go to raw_capture.py
# unchanged, and `CAPTURE_DOCKER_ARGS` (empty unless a producer sets it) to `docker run`, for a Unix
# socket's shared volume or a reply file. Call finish_capture once the producer has started.
CAPTURE_DOCKER_ARGS=()
start_capture() {
    local proto="$1" port="$2" out_dir="$3" prefix="$4" count="$5" timeout="${6:-15}"
    shift "$(($# < 6 ? $# : 6))"
    mkdir -p "${out_dir}"
    ${DOCKER} run -d --name capture --network "${NET}" \
        -v "${TOOLS_DIR}/raw_capture.py:/raw_capture.py:ro,z" \
        -v "${out_dir}:/out:z" \
        "${CAPTURE_DOCKER_ARGS[@]}" \
        python:3.12-slim \
        python3 /raw_capture.py --proto "${proto}" --port "${port}" --out-dir /out \
            --prefix "${prefix}" --count "${count}" --timeout "${timeout}" "$@" \
        >/dev/null
    # Give the listener time to bind before anything sends to it.
    sleep 1
}

# finish_capture: waits for the capture container, prints its log, and fails on raw_capture.py's
# nonzero exit rather than leaving a partial fixture set.
finish_capture() {
    local status
    status="$(${DOCKER} wait capture)"
    ${DOCKER} logs capture 2>&1 | sed 's/^/  [capture] /'
    ${DOCKER} rm -f capture >/dev/null 2>&1 || true
    if [ "${status}" != "0" ]; then
        echo "record-fixtures: capture container exited ${status} -- fixture set incomplete, not committing it" >&2
        return 1
    fi
}

cleanup() {
    ${DOCKER} rm -f -v capture otelcol prometheus vmagent metatarget dd-agent dd-clients \
        telegraf scrape-node scrape-python status-server status-connections splunk-dind splunk-sc4s splunk-java kafka-record-broker kafka-record-javac >/dev/null 2>&1 || true
    ${DOCKER} volume rm "${DD_VOLUME}" >/dev/null 2>&1 || true
    ${DOCKER} network rm "${NET}" "${KAFKA_NET}" >/dev/null 2>&1 || true
    # record_prometheus and record_datadog_agent render config into a temp dir; remove it here too
    # so a run that dies mid-capture doesn't leave one behind.
    [ -n "${PROM_CFG_DIR}" ] && rm -rf "${PROM_CFG_DIR}"
    [ -n "${DD_CONF_DIR}" ] && rm -rf "${DD_CONF_DIR}"
    cri_teardown
    # minikube run through sudo leaves root-owned files behind.
    if [ -n "${CRI_WORK}" ]; then
        rm -rf "${CRI_WORK}" 2>/dev/null || sudo rm -rf "${CRI_WORK}"
    fi
    return 0
}

# ---- producers ----------------------------------------------------------------------------------

# logger(1) from util-linux; busybox's applet can't send to a remote server (see
# testdata/interop/README.md's "Findings worth recording" section). Three messages:
# RFC 3164, RFC 5424, and RFC 3164 with UTF-8 multibyte content.
record_logger() {
    echo "== recording: logger(1) (util-linux, debian:bookworm-slim) =="
    local out="${OUT_ROOT}/syslog"

    start_capture udp 5514 "${out}" logger-rfc3164-basic 1
    ${DOCKER} run --rm --network "${NET}" debian:bookworm-slim \
        logger -n capture -P 5514 -d --rfc3164 -t logit-fixture -p user.notice \
        "hello from logger(1), captured for logit interop fixtures"
    finish_capture

    start_capture udp 5514 "${out}" logger-rfc3164-unicode 1
    ${DOCKER} run --rm --network "${NET}" debian:bookworm-slim \
        logger -n capture -P 5514 -d --rfc3164 -t logit-fixture -p user.notice \
        "héllo wörld — ünïcödé ✓ (UTF-8 multibyte smoke test)"
    finish_capture

    start_capture udp 5514 "${out}" logger-rfc5424-basic 1
    ${DOCKER} run --rm --network "${NET}" debian:bookworm-slim \
        logger -n capture -P 5514 -d --rfc5424 -t logit-fixture -p user.notice \
        "hello from logger(1) in RFC 5424 mode, captured for logit interop fixtures"
    finish_capture
}

# Python's logging.handlers.SysLogHandler, through the demo app's own NoNulSysLogHandler
# (demo/app/pages/syslog_handler.py), bind-mounted in and imported directly. See
# python_syslog_producer.py for what its two messages cover.
record_python_syslog_handler() {
    echo "== recording: Python logging.handlers.SysLogHandler =="
    local out="${OUT_ROOT}/syslog"
    start_capture udp 5514 "${out}" python-syslog-handler 2
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_syslog_producer.py:/producer/run.py:ro,z" \
        -v "${ROOT}/demo/app/pages/syslog_handler.py:/producer/syslog_handler.py:ro,z" \
        -w /producer python:3.12-slim \
        python3 run.py --host capture --port 5514
    finish_capture
}

# rsyslog, forwarding one message over UDP. There's no official rsyslog image, so this installs
# Debian's `rsyslogd` package into debian:bookworm-slim at record time (see
# testdata/interop/README.md's "Findings worth recording" section). The apt layer
# adds 20-30s and can flake; if it stops working reliably, drop this producer from `all`.
record_rsyslog() {
    echo "== recording: rsyslog =="
    local out="${OUT_ROOT}/syslog"
    start_capture udp 5514 "${out}" rsyslog 1 90
    # Mounted beside /etc/rsyslog.conf and passed with `-f`: mounting over the package's own file
    # makes dpkg hang on a conffile prompt that DEBIAN_FRONTEND=noninteractive doesn't suppress.
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/rsyslog.conf:/etc/rsyslog-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/rsyslog-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture
}

# rsyslog over TCP: the same entrypoint with rsyslog-tcp.conf, whose `omfwd` sets no
# `TCP_Framing`, so rsyslog sends its default RFC 6587 §3.4.2 non-transparent (LF-terminated)
# framing. That stock default is what this fixture checks the auto-detecting `Framer`
# (crates/logit-proto/src/framing.rs) against. One connection, so one file with one message.
record_rsyslog_tcp() {
    echo "== recording: rsyslog (TCP, non-transparent framing) =="
    local out="${OUT_ROOT}/syslog"
    start_capture tcp 601 "${out}" rsyslog-tcp 1 90
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/rsyslog-tcp.conf:/etc/rsyslog-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/rsyslog-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture
}

# collectd's binary `network` protocol over UDP. There's no runnable official image (`collectd/ci`
# is a build environment), so this installs Debian's `collectd-core` at record time; not the
# `collectd` metapackage, which pulls in a long tail of unneeded plugin dependencies.
#
# Three datagrams: the `network` plugin packs value lists until the next wouldn't fit under
# `MaxPacketSize` (1452), eliding repeated identity parts, so three datagrams capture that elision
# and a read cycle split across a datagram boundary. The capture stops on its count, so no
# shutdown flush is in the corpus (testdata/interop/README.md's "Findings worth recording").
# The 90s timeout covers the apt-get install.
#
# The `threshold` notification is a second capture under the `collectd-notification` prefix, so
# the value-list tests' `collectd-00{0,1,2}.raw` stay pure value lists. It mounts
# collectd-threshold.conf (collectd.conf plus `threshold`), never collectd.conf: `threshold` fires
# on the first read, so loading it in the first capture would put a notification in those files.
# One datagram is enough, since the notification lands in the first one.
record_collectd() {
    echo "== recording: collectd (network plugin, debian:bookworm-slim) =="
    local out="${OUT_ROOT}/collectd"
    start_capture udp 25826 "${out}" collectd 3 90
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/collectd.conf:/etc/collectd-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/collectd-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture

    echo "== recording: collectd threshold notification =="
    start_capture udp 25826 "${out}" collectd-notification 1 90
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/collectd-threshold.conf:/etc/collectd-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/collectd-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture
}

# OTLP, recorded through the Collector's `file` exporter (otel-collector-config.yaml says why) and
# fed by `telemetrygen`, the OpenTelemetry project's SDK-backed load generator.
record_otlp() {
    echo "== recording: OTLP via opentelemetry-collector-contrib + telemetrygen =="
    local out="${OUT_ROOT}/otlp"
    mkdir -p "${out}"
    # The collector runs as uid 10001, unrelated to the checkout's owner, so its `file` exporters
    # need a world-writable output directory.
    chmod 777 "${out}"
    ${DOCKER} run -d --name otelcol --network "${NET}" \
        -v "${TOOLS_DIR}/otel-collector-config.yaml:/etc/otelcol-config.yaml:ro,z" \
        -v "${out}:/output:z" \
        otel/opentelemetry-collector-contrib:latest \
        --config /etc/otelcol-config.yaml \
        >/dev/null
    sleep 3 # let the collector finish binding its receivers

    # A fixed count, not --duration, so every run produces the same fixture shape (3 records from 1
    # worker) however fast the container starts.
    for signal_and_count in "traces:--traces=3" "logs:--logs=3" "metrics:--metrics=3"; do
        local signal="${signal_and_count%%:*}" count_flag="${signal_and_count#*:}"
        echo "-- telemetrygen ${signal}"
        ${DOCKER} run --rm --network "${NET}" \
            ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:latest \
            "${signal}" --otlp-endpoint otelcol:4317 --otlp-insecure "${count_flag}" \
            || echo "record-fixtures: telemetrygen ${signal} failed -- skipping, see plan doc follow-on list" >&2
    done
    sleep 2 # let the collector's file exporters flush

    ${DOCKER} logs otelcol 2>&1 | sed 's/^/  [otelcol] /'
    ${DOCKER} rm -f otelcol >/dev/null 2>&1 || true
}

# Graphite/Carbon, one producer per carbon wire protocol, each captured through raw_capture.py's
# `--proto tcp` mode (one file per connection).
#
# Plaintext comes from collectd's `write_graphite` plugin, a real carbon plaintext sender reading
# the same plugins as collectd.conf. It opens one TCP connection at startup and writes every flush
# to it, so the fixture is one connection's stream across several read cycles, and
# `interop_fixture_write_graphite_plaintext_decodes` (crates/logit-inputs/src/graphite/mod.rs)
# decodes it as one buffer. The 90s timeout covers the apt-get install.
#
# Pickle comes from three senders, one capture each so a test can name the opcodes it checks:
# - python_graphite_pickle_producer.py, a stdlib-only sender, at `protocol=0`, `protocol=2`, and
#   `protocol=-1` (highest available: 5 on python:3.12-slim). `python3 --version` prints beside the
#   script's `pickle.HIGHEST_PROTOCOL` line for testdata/interop/graphite/README.md's provenance
#   table.
# - python2_diamond_pickle_producer.py on python:2.7-slim: Diamond's `cPickle.dumps(batch)` call,
#   protocol 0 with cPickle's memo numbering.
# - Dropwizard Metrics' `GraphiteReporter` over `PickledGraphite` (tools/record-fixtures/
#   dropwizard-graphite/), built in `MAVEN_IMAGE`. The 600s timeout covers the first run's
#   dependency download.
record_graphite() {
    echo "== recording: collectd write_graphite plugin (plaintext TCP, debian:bookworm-slim) =="
    local out="${OUT_ROOT}/graphite"
    start_capture tcp 2003 "${out}" write-graphite 1 90
    # RUN_SECONDS=3, not the entrypoint's default 10: write_graphite holds its connection open for
    # as long as collectd runs, so fixture size scales with this. Three seconds gives several read
    # cycles at `Interval 1` and keeps the file in the corpus's size class.
    ${DOCKER} run --rm --network "${NET}" -e RUN_SECONDS=3 \
        -v "${TOOLS_DIR}/collectd-write-graphite.conf:/etc/collectd-fixture.conf:ro,z" \
        -v "${TOOLS_DIR}/collectd-entrypoint.sh:/entrypoint.sh:ro,z" \
        debian:bookworm-slim bash /entrypoint.sh
    finish_capture

    echo "== recording: stdlib pickle producer (protocol 2) =="
    start_capture tcp 2004 "${out}" graphite-pickle-p2 1
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_graphite_pickle_producer.py:/producer/run.py:ro,z" \
        -w /producer python:3.12-slim \
        bash -c "python3 --version && python3 run.py --host capture --port 2004 --protocol 2"
    finish_capture

    echo "== recording: stdlib pickle producer (protocol -1, highest) =="
    start_capture tcp 2004 "${out}" graphite-pickle-p5 1
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_graphite_pickle_producer.py:/producer/run.py:ro,z" \
        -w /producer python:3.12-slim \
        bash -c "python3 --version && python3 run.py --host capture --port 2004 --protocol -1"
    finish_capture

    record_graphite_p0
    record_graphite_py2
    record_graphite_dropwizard
}

record_graphite_p0() {
    local out="${OUT_ROOT}/graphite"
    echo "== recording: stdlib pickle producer (protocol 0) =="
    start_capture tcp 2004 "${out}" graphite-pickle-p0 1
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python_graphite_pickle_producer.py:/producer/run.py:ro,z" \
        -w /producer python:3.12-slim \
        bash -c "python3 --version && python3 run.py --host capture --port 2004 --protocol 0"
    finish_capture
}

record_graphite_py2() {
    local out="${OUT_ROOT}/graphite"
    echo "== recording: Diamond's cPickle.dumps(batch) on Python 2 (python:2.7-slim) =="
    start_capture tcp 2004 "${out}" graphite-pickle-py2 1
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/python2_diamond_pickle_producer.py:/producer/run.py:ro,z" \
        -w /producer python:2.7-slim \
        python2 run.py capture 2004
    finish_capture
}

record_graphite_dropwizard() {
    local out="${OUT_ROOT}/graphite"
    echo "== recording: Dropwizard Metrics PickledGraphite (${MAVEN_IMAGE}) =="
    start_capture tcp 2004 "${out}" graphite-dropwizard 1 600
    ${DOCKER} run --rm --network "${NET}" \
        -v "${TOOLS_DIR}/dropwizard-graphite:/src:ro,z" "${MAVEN_IMAGE}" \
        bash -c "cp -r /src /build && cd /build && java -version 2>&1 | head -1 \
            && mvn -q -B package dependency:copy-dependencies -DskipTests \
            && ls target/dependency | grep -E 'metrics' \
            && java -cp 'target/classes:target/dependency/*' Main capture 2004" \
        2>&1 | sed 's/^/  [java] /'
    finish_capture
}

# Prometheus remote-write from `prom/prometheus:v3.14.0`: the release whose `prompb` and
# `io.prometheus.write.v2` protos are vendored under crates/logit-proto/proto/prometheus/, so the
# fixture and the generated decoder share an upstream revision.
#
# Captured with raw_capture.py's `--proto http` mode, which replies `204 No Content`: a sender that
# gets no response never sends a second request. Each request lands as a `.bin` body plus a
# `.headers` sidecar, from which a replay test reads the wire version (`Content-Type`,
# `X-Prometheus-Remote-Write-Version`).
#
# Three fixture sets, one sequential run each, so a test can name the file it means:
#   prometheus-v1          remote-write 1.0 (`prometheus.WriteRequest`) sample requests.
#   prometheus-v1-metadata 1.0 `MetricMetadata`-only requests by construction: the run drops every
#                          series in `write_relabel_configs`, while 1.0 metadata, which comes from
#                          the scrape cache, still ships on `metadata_config.send_interval`. The
#                          replay test asserts all three captures are metadata-only, so the recipe
#                          guarantees it instead of racing the first sample batch; nothing
#                          post-processes or hand-picks bytes. It scrapes a static target
#                          (prometheus-metadata-target.prom) declaring the sample captures' families.
#   prometheus-v2          remote-write 2.0 (`io.prometheus.write.v2.Request`), metadata inline per
#                          series.
# `protobuf_message` is explicit on all three, so the fixture records a choice rather than a
# default a later release could move.
#
# Size: prometheus.yml's `write_relabel_configs` keeps four families (a counter, a gauge, a
# histogram, and a summary) out of several hundred, and counts stay small, to fit
# testdata/interop/README.md's size budget.
#
# The 90s timeouts cover container start, TSDB and WAL replay, the hash-staggered first scrape, and
# on the metadata run `metadata_config`'s first tick; a healthy run takes a few seconds. Too short
# fails a good re-record; too long only delays a broken one.
record_prometheus() {
    echo "== recording: Prometheus remote-write (prom/prometheus:v3.14.0) =="
    local out="${OUT_ROOT}/prometheus"
    # Printed so a re-record's drift from testdata/interop/prometheus/README.md's provenance table
    # shows in the output. This run also pulls the image before any capture starts.
    ${DOCKER} run --rm prom/prometheus:v3.14.0 --version 2>&1 | sed 's/^/  [prometheus] /'

    # One template, three `sed` renderings, so it's easy to check that the sets differ only in the
    # placeholders (see prometheus.yml's header). The rendered file is a per-run artifact, so it
    # goes in a temp dir, not tools/.
    PROM_CFG_DIR="$(mktemp -d)"
    chmod 755 "${PROM_CFG_DIR}"

    # The four families the sample captures keep: 26 series, one `max_samples_per_send` request, so
    # a capture is a whole scrape rather than a fragment.
    local keep_regex="prometheus_build_info|prometheus_tsdb_wal_page_flushes_total"
    keep_regex="${keep_regex}|prometheus_tsdb_compaction_duration_seconds_(bucket|sum|count)"
    keep_regex="${keep_regex}|go_gc_duration_seconds(_sum|_count)?"
    # The metadata run drops every series instead (metadata isn't subject to the relabel), so every
    # request it produces is a metadata request. Its static target is served by
    # `python3 -m http.server` from the capture sink's image, so no new image is pulled.
    ${DOCKER} run -d --name metatarget --network "${NET}" -w /srv \
        -v "${TOOLS_DIR}/prometheus-metadata-target.prom:/srv/metrics:ro,z" \
        python:3.12-slim \
        python3 -m http.server 9100 >/dev/null
    sleep 1

    # prefix:count:protobuf_message:scrape_interval:metadata_send_interval:relabel_action:target
    for spec in \
        "prometheus-v1:2:prometheus.WriteRequest:5s:1m:keep:localhost:9090" \
        "prometheus-v1-metadata:3:prometheus.WriteRequest:5s:1s:drop:metatarget:9100" \
        "prometheus-v2:2:io.prometheus.write.v2.Request:5s:1m:keep:localhost:9090"; do
        local prefix count message scrape_interval metadata_interval action host port regex
        IFS=: read -r prefix count message scrape_interval metadata_interval action host port \
            <<<"${spec}"
        if [ "${action}" = "drop" ]; then regex=".*"; else regex="${keep_regex}"; fi
        # `#` as the delimiter for these two, not the `|` the others use: the keep pattern is an
        # alternation and is full of `|`.
        echo "-- ${prefix} (protobuf_message: ${message}, relabel: ${action}, target: ${host}:${port})"
        sed -e "s|@@PROTOBUF_MESSAGE@@|${message}|" \
            -e "s|@@SCRAPE_INTERVAL@@|${scrape_interval}|" \
            -e "s|@@METADATA_SEND_INTERVAL@@|${metadata_interval}|" \
            -e "s|@@SCRAPE_TARGET@@|${host}:${port}|" \
            -e "s#@@RELABEL_ACTION@@#${action}#" \
            -e "s#@@RELABEL_REGEX@@#${regex}#" \
            "${TOOLS_DIR}/prometheus.yml" >"${PROM_CFG_DIR}/prometheus.yml"

        start_capture http 9091 "${out}" "${prefix}" "${count}" 90
        # Mounted straight over the image's own config path with no command override, so this runs
        # prom/prometheus's stock command line and the capture records a stock sender.
        ${DOCKER} run -d --name prometheus --network "${NET}" \
            -v "${PROM_CFG_DIR}/prometheus.yml:/etc/prometheus/prometheus.yml:ro,z" \
            prom/prometheus:v3.14.0 \
            >/dev/null
        finish_capture
        ${DOCKER} logs prometheus 2>&1 | sed 's/^/  [prometheus] /'
        ${DOCKER} rm -f prometheus >/dev/null 2>&1 || true
    done

    ${DOCKER} rm -f metatarget >/dev/null 2>&1 || true
    rm -rf "${PROM_CFG_DIR}"
    PROM_CFG_DIR=""
}

# Scrape bodies from two real exporters, for the Prometheus text differential corpus
# (testdata/differential/prometheus-text/): `prom/node-exporter` with four collectors, and a
# `prometheus_client` app (python_prometheus_client_app.py) exposing every type that library
# writes, OpenMetrics `_created`, exemplars, `info`, and `stateset` among them. Each body lands as
# `<exporter>-<n>.body`, byte for byte as served, beside a `.headers` sidecar holding the response's
# `Content-Type`, which picks the dialect.
#
# curl fetches each target twice: with `prometheus_in`'s own `Accept` header, read out of
# crates/logit-inputs/src/prometheus.rs at record time, then with a forced
# `text/plain;version=0.0.4`. The second body is kept only when its `Content-Type` differs from
# the first's, so an exporter that ignores `Accept` records one body.
#
# Size: node_exporter runs four collectors, chosen for small output, beside its own `go_*`,
# `process_*`, and `promhttp_*` metrics. Bodies are never trimmed, since a trimmed body isn't real
# bytes; drop a collector instead.
PROM_SCRAPE_NODE_IMAGE="prom/node-exporter:v1.12.1@sha256:1b4e4438faca4dd7e001dd445d161a4a2091b0fededa84093b3a8dfeae1f1be0"
PROM_SCRAPE_PYTHON_IMAGE="python:3.12.15-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1"
PROM_SCRAPE_CLIENT_VERSION="0.26.0"
PROM_SCRAPE_CURL_IMAGE="curlimages/curl:8.22.0@sha256:58adaa4e8dca9c988bae2aba4ab3434a0bb2da16bbe3f92dec39ec7785166777"

# scrape_target <out_dir> <exporter> <url>: writes <exporter>-0 and, when the forced text 0.0.4
# request gets a different Content-Type, <exporter>-1.
scrape_target() {
    local out="$1" exporter="$2" url="$3" accept first="" i=0
    accept="$(grep -A1 '^const ACCEPT_HEADER_VALUE' "${ROOT}/crates/logit-inputs/src/prometheus.rs" |
        sed -n 's/^ *"\(.*\)";$/\1/p')"
    [ -n "${accept}" ] || { echo "record-fixtures: no ACCEPT_HEADER_VALUE found" >&2; return 1; }
    for value in "${accept}" "text/plain;version=0.0.4"; do
        local stem="${out}/${exporter}-${i}" headers ct
        headers="$(mktemp)"
        # The body goes to stdout and the response headers to stderr, both into host files, so
        # nothing in the container writes to the bind-mounted tree. `--retry-all-errors` covers the
        # target's name not resolving yet, as well as its port not listening yet.
        ${DOCKER} run --rm --network "${NET}" "${PROM_SCRAPE_CURL_IMAGE}" \
            -sS --fail --retry 60 --retry-all-errors --retry-delay 1 \
            -H "Accept: ${value}" -D /dev/stderr -o - "${url}" \
            >"${stem}.body" 2>"${headers}" || { cat "${headers}" >&2; rm -f "${headers}"; return 1; }
        ct="$(grep -i '^content-type:' "${headers}" | tail -1 | tr -d '\r' | sed 's/^[^:]*:[ \t]*//')"
        rm -f "${headers}"
        echo "-- ${exporter}-${i}: Accept: ${value} -> Content-Type: ${ct} ($(wc -c <"${stem}.body") bytes)"
        if [ "${i}" = 1 ] && [ "${ct}" = "${first}" ]; then
            echo "   the same Content-Type as ${exporter}-0, so not kept"
            rm -f "${stem}.body"
            break
        fi
        printf 'content-type: %s\n' "${ct}" >"${stem}.headers"
        first="${ct}"
        i=$((i + 1))
    done
}

record_prometheus_scrape() {
    echo "== recording: Prometheus scrape bodies (node_exporter, prometheus_client) =="
    local out="${OUT_ROOT}/prometheus-scrape"
    mkdir -p "${out}"
    rm -f "${out}"/*.body "${out}"/*.headers
    ${DOCKER} run --rm "${PROM_SCRAPE_NODE_IMAGE}" --version 2>&1 | sed -n 1p | sed 's/^/  [node] /'
    ${DOCKER} run --rm "${PROM_SCRAPE_CURL_IMAGE}" --version 2>&1 | sed -n 1p | sed 's/^/  [curl] /'

    ${DOCKER} run -d --name scrape-node --network "${NET}" "${PROM_SCRAPE_NODE_IMAGE}" \
        --collector.disable-defaults --collector.loadavg --collector.meminfo \
        --collector.netdev --collector.uname >/dev/null
    scrape_target "${out}" node-exporter http://scrape-node:9100/metrics

    ${DOCKER} run -d --name scrape-python --network "${NET}" \
        -v "${TOOLS_DIR}/python_prometheus_client_app.py:/app.py:ro,z" \
        "${PROM_SCRAPE_PYTHON_IMAGE}" \
        bash -c "pip install -q --no-cache-dir --root-user-action=ignore \
            prometheus_client==${PROM_SCRAPE_CLIENT_VERSION} && exec python3 /app.py" >/dev/null
    scrape_target "${out}" python-client http://scrape-python:8000/metrics
    ${DOCKER} logs scrape-python 2>&1 | sed 's/^/  [python] /'
    ${DOCKER} rm -f scrape-node scrape-python >/dev/null 2>&1 || true
}

# Remote-write from `victoriametrics/vmagent:v1.152.0`, on both of its wires:
#   vmagent-zstd    the "VictoriaMetrics remote write protocol", vmagent's default: the 1.0
#                   `WriteRequest` with `Content-Encoding: zstd`. raw_capture.py answers `204`, so
#                   vmagent never sees the `415`/`400` that would downgrade it to Snappy.
#   vmagent-snappy  the same sender with `-remoteWrite.forcePromProto`: plain remote-write 1.0.
# Two requests each, because vmagent (`-enableMetadata`, on by default) sends a scrape's samples
# and its 1.0 `MetricMetadata` in separate requests, in no fixed order: one of each. vmagent
# scrapes the static prometheus-metadata-target.prom (the `prometheus` producer's metadata target,
# the same four families) through tools/record-fixtures/vmagent.yml, so a sample request is one
# whole scrape of a small, fixed exposition and the set stays inside testdata/interop/README.md's
# size budget.
record_vmagent() {
    local image="victoriametrics/vmagent:v1.152.0"
    echo "== recording: vmagent remote-write (${image}) =="
    local out="${OUT_ROOT}/prometheus"
    ${DOCKER} run --rm "${image}" --version 2>&1 | sed 's/^/  [vmagent] /'

    ${DOCKER} run -d --name metatarget --network "${NET}" -w /srv \
        -v "${TOOLS_DIR}/prometheus-metadata-target.prom:/srv/metrics:ro,z" \
        python:3.12-slim \
        python3 -m http.server 9100 >/dev/null
    sleep 1

    # prefix:extra vmagent flag
    for spec in "vmagent-zstd:" "vmagent-snappy:-remoteWrite.forcePromProto"; do
        local prefix flag extra=()
        IFS=: read -r prefix flag <<<"${spec}"
        [ -n "${flag}" ] && extra=("${flag}")
        echo "-- ${prefix} (${flag:-the default wire})"
        start_capture http 9091 "${out}" "${prefix}" 2 60
        ${DOCKER} run -d --name vmagent --network "${NET}" \
            -v "${TOOLS_DIR}/vmagent.yml:/etc/vmagent/vmagent.yml:ro,z" \
            "${image}" \
            -promscrape.config=/etc/vmagent/vmagent.yml \
            -remoteWrite.url=http://capture:9091/api/v1/write \
            -remoteWrite.tmpDataPath=/tmp/vmagent-remotewrite-data \
            "${extra[@]}" \
            >/dev/null
        finish_capture
        ${DOCKER} logs vmagent 2>&1 | grep -E 'remotewrite|error|warn' | sed 's/^/  [vmagent] /' || true
        ${DOCKER} rm -f vmagent >/dev/null 2>&1 || true
    done

    ${DOCKER} rm -f metatarget >/dev/null 2>&1 || true
}

# statsd/DogStatsD from the two common Python clients: Datadog's `datadog` package (`DogStatsd`)
# and the plain `statsd` package (`StatsClient`). This corpus is also the ground truth
# perf/load/README.md's traffic model is calibrated against.
#
# Four captures, because what the corpus records is datagram packing, and each client packs
# differently:
#   statsd-dogstatsd-unbuffered  one metric per datagram, the syscall-bound shape
#   statsd-dogstatsd-buffered    the client's own send buffer decides the cut
#   statsd-plain-unbuffered      StatsClient, one metric per datagram, tagless dialect
#   statsd-plain-pipeline        StatsClient's `pipeline()` batching, its own 512 B cut
# All four run the same workload (python_statsd_producer.py), so only the packing differs.
#
# `pip install` takes the current release; the producer prints the resolved version first, for
# testdata/interop/statsd/README.md's provenance table.
#
# Counts are below what each mode sends (a couple hundred unbuffered datagrams for 40 rounds, a
# dozen-plus buffered), so the capture stops early rather than racing the producer: raw_capture.py
# fails a short capture, never a truncated one.
record_statsd() {
    local out="${OUT_ROOT}/statsd"
    # prefix:client:mode:count
    for spec in \
        "statsd-dogstatsd-unbuffered:dogstatsd:unbuffered:24" \
        "statsd-dogstatsd-buffered:dogstatsd:buffered:4" \
        "statsd-plain-unbuffered:statsd:plain:24" \
        "statsd-plain-pipeline:statsd:pipeline:4"; do
        local prefix client mode count package
        IFS=: read -r prefix client mode count <<<"${spec}"
        if [ "${client}" = "dogstatsd" ]; then package="datadog"; else package="statsd"; fi
        echo "== recording: ${client} (${mode}), python:3.12-slim + pip install ${package} =="
        start_capture udp 8125 "${out}" "${prefix}" "${count}"
        ${DOCKER} run --rm --network "${NET}" \
            -v "${TOOLS_DIR}/python_statsd_producer.py:/producer/run.py:ro,z" \
            -w /producer python:3.12-slim \
            bash -c "python3 --version && pip install --quiet --disable-pip-version-check ${package} \
                && python3 run.py --host capture --port 8125 --client ${client} --mode ${mode}"
        finish_capture
    done
}

# ---- Datadog ----------------------------------------------------------------------------------------
#
# Three producers, all writing testdata/interop/datadog/ (its README has the provenance table):
#   datadog-agent           a real Agent with every intake URL pointed at the capture sink, fed by
#                           DogStatsD over UDP and both Unix sockets, a dd-trace app over the APM
#                           socket, and a tailed log file
#   datadog-tracer          the same dd-trace app sending straight to the capture sink, which
#                           answers `/info` as `datadog_trace_in` does
#   datadog-dogstatsd-unix  the `datadog` DogStatsD client to the capture sink over a Unix datagram
#                           socket and a Unix stream socket
# `datadog` runs all three.
#
# Nothing here reaches Datadog. Every Agent runs with a fake API key and every intake URL it has is
# the capture sink's; `--dns 192.0.2.1` (TEST-NET-1, unrouted) leaves Docker's embedded resolver
# answering container names and fails every other lookup, so whatever the Agent tries on its own
# (remote config, its own telemetry, cloud metadata) can't resolve a Datadog host.
#
# `pip install` takes the current `datadog`, `ddtrace`, and `flask`; each producer prints what it
# resolved, as does the Agent image, for the README's table.

DD_AGENT_IMAGE="docker.io/datadog/agent:7"
DD_CLIENT_PACKAGES="datadog ddtrace flask"
# Set on every DogStatsD client, so each line carries `|e:` (the client reads it at startup).
DD_EXTERNAL_ENV="it-false,cn-record-fixtures,pu-00000000-0000-4000-8000-000000000001"

# dd_clients_run <name> <cmd>: a python:3.12-slim container on $NET with the shared socket volume
# and the two Python producers mounted, running `cmd` after installing $DD_CLIENT_PACKAGES.
dd_clients_run() {
    local name="$1" cmd="$2"
    shift 2
    ${DOCKER} run --name "${name}" --network "${NET}" \
        -v "${DD_VOLUME}:/var/run/datadog" \
        -v "${TOOLS_DIR}/python_dogstatsd_producer.py:/producer/dogstatsd.py:ro,z" \
        -v "${TOOLS_DIR}/python_ddtrace_app.py:/producer/app.py:ro,z" \
        -e DD_EXTERNAL_ENV="${DD_EXTERNAL_ENV}" \
        -e DD_SERVICE=record-fixtures -e DD_ENV=record -e DD_VERSION=1.2.3 \
        -e DD_INSTRUMENTATION_TELEMETRY_ENABLED=false -e DD_REMOTE_CONFIGURATION_ENABLED=false \
        "$@" -w /producer python:3.12-slim \
        bash -c "python3 --version && pip install --quiet --disable-pip-version-check \
            --root-user-action=ignore ${DD_CLIENT_PACKAGES} && ${cmd}"
}

# A real Agent, redirected. The capture runs by path (raw_capture.py's `--name-by-path`), keeping
# one request per route except where a `--require` asks for more, and completes once every
# `--require` is met. Series, `/intake/`, and service checks keep several because the Agent flushes
# on its own 15 s clock: its own metrics, host metadata, and startup event arrive first, and the
# DogStatsD clients' data lands in whichever flush follows their send. check_datadog_agent_capture.py
# then deletes host metadata (testdata/interop/datadog/README.md's "Privacy") and fails the run
# unless every construct the tests read made it in.
record_datadog_agent() {
    echo "== recording: Datadog Agent (${DD_AGENT_IMAGE}) =="
    local out="${OUT_ROOT}/datadog"
    ${DOCKER} run --rm --entrypoint agent "${DD_AGENT_IMAGE}" version 2>&1 | sed 's/^/  [agent] /'
    ${DOCKER} volume create "${DD_VOLUME}" >/dev/null

    # The Agent's whole conf.d: only the log tail, so none of the image's default checks run.
    DD_CONF_DIR="$(mktemp -d)"
    mkdir -p "${DD_CONF_DIR}/record.d"
    cp "${TOOLS_DIR}/datadog-agent-logs.yaml" "${DD_CONF_DIR}/record.d/conf.yaml"
    chmod -R a+rX "${DD_CONF_DIR}"

    start_capture http 8080 "${out}" agent 0 240 \
        --name-by-path --max-per-path 1 \
        --require /api/v2/series=5 --require /api/beta/sketches --require /api/v1/check_run=3 \
        --require /api/v2/logs=2 --require /api/v0.2/traces --require /api/v0.2/stats \
        --require /intake/=4 --require /api/v1/validate --require /api/v2/validate \
        --discard /api/v2/host_metadata

    # `datadog-agent-app.txt`, not `.log`: `.gitignore`'s `*.log` would leave a `.log` untracked.
    ${DOCKER} run -d --name dd-agent --network "${NET}" --dns 192.0.2.1 \
        -v "${DD_VOLUME}:/var/run/datadog" \
        -v "${DD_CONF_DIR}:/etc/datadog-agent/conf.d:z" \
        -v "${TOOLS_DIR}/datadog-agent-app.txt:/var/log/record/app.log:ro,z" \
        -e DD_API_KEY=logit-record -e DD_HOSTNAME=record-fixtures \
        -e DD_DD_URL=http://capture:8080 \
        -e DD_LOGS_ENABLED=true -e DD_LOGS_CONFIG_LOGS_DD_URL=capture:8080 \
        -e DD_LOGS_CONFIG_LOGS_NO_SSL=true -e DD_LOGS_CONFIG_FORCE_USE_HTTP=true \
        -e DD_APM_ENABLED=true -e DD_APM_DD_URL=http://capture:8080 \
        -e DD_APM_RECEIVER_SOCKET=/var/run/datadog/apm.socket \
        -e DD_DOGSTATSD_SOCKET=/var/run/datadog/dsd.socket \
        -e DD_DOGSTATSD_STREAM_SOCKET=/var/run/datadog/dsd-stream.socket \
        -e DD_DOGSTATSD_NON_LOCAL_TRAFFIC=true \
        -e DD_PROCESS_AGENT_ENABLED=false -e DD_REMOTE_CONFIGURATION_ENABLED=false \
        -e DD_ORCHESTRATOR_EXPLORER_ENABLED=false -e DD_AGENT_TELEMETRY_ENABLED=false \
        -e DD_INVENTORIES_ENABLED=false \
        "${DD_AGENT_IMAGE}" >/dev/null

    # The socket files are the Agent's own; their modes are what decision 12 of ADR
    # `datadog-agent-and-intake-relay` needed to know.
    local tries=0
    until ${DOCKER} exec dd-agent bash -c 'for s in apm dsd dsd-stream; do test -S /var/run/datadog/${s}.socket || exit 1; done' 2>/dev/null; do
        tries=$((tries + 1))
        if [ "${tries}" -gt 90 ]; then
            echo "record-fixtures: the Agent never created all three of its sockets" >&2
            ${DOCKER} logs dd-agent 2>&1 | tail -40 | sed 's/^/  [agent] /'
            return 1
        fi
        sleep 1
    done
    sleep 2
    ${DOCKER} exec dd-agent bash -c 'ls -ln /var/run/datadog/; stat -c "%A %a %U:%G %n" /var/run/datadog/*' \
        2>&1 | sed 's/^/  [agent sockets] /'
    # The Agent's own `/info`, asked over its APM socket the way a tracer asks: the document
    # `datadog_trace_in`'s is checked against, field by field (crates/logit-inputs/src/datadog_trace.rs).
    ${DOCKER} exec dd-agent curl -sS --unix-socket /var/run/datadog/apm.socket http://localhost/info \
        >"${out}/agent-info.json"
    echo "  [agent] GET /info over apm.socket: $(wc -c <"${out}/agent-info.json") bytes -> agent-info.json"

    # One client container: DogStatsD over UDP, the datagram socket, and the stream socket, then
    # the dd-trace app over the APM socket.
    dd_clients_run dd-clients "\
        python3 dogstatsd.py --url udp://dd-agent:8125 \
        && python3 dogstatsd.py --url unix:///var/run/datadog/dsd.socket \
        && python3 dogstatsd.py --url unixstream:///var/run/datadog/dsd-stream.socket \
        && ddtrace-run python3 app.py" \
        -e DD_TRACE_AGENT_URL=unix:///var/run/datadog/apm.socket \
        2>&1 | sed 's/^/  [clients] /'
    ${DOCKER} rm -f dd-clients >/dev/null 2>&1 || true

    local status=0
    finish_capture || status=$?
    ${DOCKER} logs dd-agent 2>&1 | grep -E '\| ERROR \||dogstatsd|uds_stream|receiver' | tail -20 | sed 's/^/  [agent] /' || true
    ${DOCKER} rm -f dd-agent >/dev/null 2>&1 || true
    # Run whatever the capture's outcome: it also deletes the host metadata a partial capture wrote.
    ${DOCKER} run --rm -v "${out}:/data:z" \
        -v "${TOOLS_DIR}/check_datadog_agent_capture.py:/check.py:ro,z" python:3.12-slim \
        bash -c "pip install --quiet --disable-pip-version-check --root-user-action=ignore \
            zstandard && python3 /check.py /data" 2>&1 | sed 's/^/  [check] /' || status=1
    ${DOCKER} volume rm "${DD_VOLUME}" >/dev/null 2>&1 || true
    rm -rf "${DD_CONF_DIR}"
    DD_CONF_DIR=""
    return "${status}"
}

# A dd-trace tracer with no Agent: the capture sink answers `GET /info` with
# datadog-trace-info.json (the document `datadog_trace_in` serves, which a test in
# crates/logit-inputs/src/datadog_trace.rs keeps in step) and every trace request with
# datadog-trace-rates.json, so the tracer picks its forms as it would against `datadog_trace_in`.
#
# Two runs:
#   tracer      the tracer's defaults against that document: its default trace form, and no
#               client stats
#   tracer-v04  `DD_TRACE_API_VERSION=v0.4` and `DD_TRACE_STATS_COMPUTATION_ENABLED=true`, against
#               the same document with `client_drop_p0s: true`, as a real Agent answers. The tracer
#               computes client stats only when the Agent lets it drop priority-0 traces, so this is
#               the run that puts `/v0.6/stats` on the wire (testdata/interop/datadog/README.md).
#               One request (`RECORD_PATHS`), which keeps the v0.4 body inside the size budget.
record_datadog_tracer() {
    local out="${OUT_ROOT}/datadog"
    DD_CONF_DIR="$(mktemp -d)"
    cp "${TOOLS_DIR}/datadog-trace-info.json" "${DD_CONF_DIR}/info.json"
    sed 's/"client_drop_p0s":false/"client_drop_p0s":true/' "${TOOLS_DIR}/datadog-trace-info.json" \
        >"${DD_CONF_DIR}/info-drop-p0s.json"
    chmod -R a+rX "${DD_CONF_DIR}"
    # prefix:info document:trace form:required paths (comma-separated)
    for spec in \
        "tracer:info.json:default:/info,/v0.5/traces" \
        "tracer-v04:info-drop-p0s.json:v0.4:/info,/v0.4/traces,/v0.6/stats"; do
        local prefix info api required
        IFS=: read -r prefix info api required <<<"${spec}"
        echo "== recording: ddtrace straight to the capture sink (${prefix}: ${api} trace form, ${info}) =="
        local require_args=()
        local path
        for path in ${required//,/ }; do require_args+=(--require "${path}"); done
        CAPTURE_DOCKER_ARGS=(
            -v "${DD_CONF_DIR}/${info}:/replies/info.json:ro,z"
            -v "${TOOLS_DIR}/datadog-trace-rates.json:/replies/rates.json:ro,z"
        )
        start_capture http 8126 "${out}" "${prefix}" 0 120 \
            --name-by-path --max-per-path 1 \
            --reply /info=/replies/info.json \
            --reply /v0.4/traces=/replies/rates.json --reply /v0.5/traces=/replies/rates.json \
            --reply /v0.7/traces=/replies/rates.json \
            "${require_args[@]}"
        CAPTURE_DOCKER_ARGS=()
        local tracer_env=()
        if [ "${api}" != "default" ]; then
            tracer_env=(-e "DD_TRACE_API_VERSION=${api}" -e DD_TRACE_STATS_COMPUTATION_ENABLED=true
                -e RECORD_PATHS=/orders/42)
        fi
        dd_clients_run dd-clients "ddtrace-run python3 app.py" \
            -e DD_TRACE_AGENT_URL=http://capture:8126 \
            "${tracer_env[@]}" \
            2>&1 | grep -v -E '^  File |^    |^Traceback' | sed 's/^/  [tracer] /'
        ${DOCKER} rm -f dd-clients >/dev/null 2>&1 || true
        finish_capture
    done
    rm -rf "${DD_CONF_DIR}"
    DD_CONF_DIR=""
}

# The `datadog` DogStatsD client over both Unix sockets, straight to the capture sink: what settles
# the stream framing and the `|c:`/`|e:`/`|card:`/`|T` order. Nine datagrams (one per call,
# unbuffered), then two stream connections (unbuffered, then buffered).
record_datadog_dogstatsd_unix() {
    local out="${OUT_ROOT}/datadog"
    ${DOCKER} volume create "${DD_VOLUME}" >/dev/null
    CAPTURE_DOCKER_ARGS=(-v "${DD_VOLUME}:/var/run/datadog")

    echo "== recording: datadog DogStatsD client over a Unix datagram socket =="
    start_capture unix 0 "${out}" dogstatsd-unix 9 90 --path /var/run/datadog/dsd.socket
    dd_clients_run dd-clients "python3 dogstatsd.py --url unix:///var/run/datadog/dsd.socket" \
        2>&1 | sed 's/^/  [client] /'
    ${DOCKER} rm -f dd-clients >/dev/null 2>&1 || true
    finish_capture

    echo "== recording: datadog DogStatsD client over a Unix stream socket =="
    start_capture unix-stream 0 "${out}" dogstatsd-unix-stream 2 90 \
        --path /var/run/datadog/dsd-stream.socket
    dd_clients_run dd-clients \
        "python3 dogstatsd.py --url unixstream:///var/run/datadog/dsd-stream.socket --modes unbuffered,buffered" \
        2>&1 | sed 's/^/  [client] /'
    ${DOCKER} rm -f dd-clients >/dev/null 2>&1 || true
    finish_capture

    CAPTURE_DOCKER_ARGS=()
    ${DOCKER} volume rm "${DD_VOLUME}" >/dev/null 2>&1 || true
}

# ---- Splunk HEC ---------------------------------------------------------------------------------
#
# Four producers, all writing testdata/interop/splunk/ (its README has the provenance table):
#   splunk-otel    the OpenTelemetry Collector's `splunk_hec` exporter, fed by telemetrygen
#   splunk-docker  Docker's `splunk` log driver in each `splunk-format`, in a docker:dind daemon
#   splunk-sc4s    Splunk Connect for Syslog, fed RFC 5424 and RFC 3164 lines over UDP
#   splunk-java    splunk-library-javalogging's Logback appender, `/event` and `/raw`
# `splunk` runs all four, then check_splunk_capture.py.
#
# The capture sink stands where a HEC listener would, on port 8088, answering every route alias a
# client may use with Splunk's own bodies (`splunk-hec-success.json`, `splunk-hec-health.json`).
# Every producer carries the dummy token below; nothing here reaches a Splunk.

SPLUNK_TOKEN="00000000-0000-0000-0000-000000000000"
SPLUNK_OUT="${OUT_ROOT}/splunk"
SPLUNK_OTEL_IMAGE="otel/opentelemetry-collector-contrib:0.161.0"
SPLUNK_TELEMETRYGEN_IMAGE="ghcr.io/open-telemetry/opentelemetry-collector-contrib/telemetrygen:v0.161.0"
SPLUNK_DIND_IMAGE="docker:29.8.1-dind"
SPLUNK_ALPINE_IMAGE="alpine:3.22"
SPLUNK_SC4S_IMAGE="ghcr.io/splunk/splunk-connect-for-syslog/container3:3.40.0"

# splunk_capture <prefix> <timeout> [raw_capture.py args...]: start_capture on port 8088, named
# by path, with Splunk's success body on every data route and its health body on both health
# routes.
splunk_capture() {
    local prefix="$1" timeout="$2"
    shift 2
    local replies=() route
    for route in /services/collector /services/collector/event /services/collector/event/1.0 \
        /services/collector/raw /services/collector/raw/1.0; do
        replies+=(--reply "${route}=/replies/success.json")
    done
    for route in /services/collector/health /services/collector/health/1.0; do
        replies+=(--reply "${route}=/replies/health.json")
    done
    CAPTURE_DOCKER_ARGS=(
        -v "${TOOLS_DIR}/splunk-hec-success.json:/replies/success.json:ro,z"
        -v "${TOOLS_DIR}/splunk-hec-health.json:/replies/health.json:ro,z"
    )
    start_capture http 8088 "${SPLUNK_OUT}" "${prefix}" 0 "${timeout}" --name-by-path \
        "${replies[@]}" "$@"
    CAPTURE_DOCKER_ARGS=()
}

# The `splunk_hec` exporter (otel-collector-splunk.yaml says which exporter writes what), fed by
# telemetrygen: one traces run, one logs run, and one metrics run per `--metric-type`, unthrottled
# (`--rate=0`). The config's `batch` processor makes each run one request per exporter, so the
# capture's count is fixed: traces 1, logs 1 (plus one `/raw`), and two per metrics run (default
# and multi-metric form), except ExponentialHistogram, which the exporter drops and so never
# sends. That run goes before Histogram's, so a release that started sending it would complete the
# capture early and check_splunk_capture.py would fail on the missing histogram. A log carries a
# fixed trace and span id, a non-default severity, and an array attribute.
#
# Then the Collector's own `splunk_hec` receiver is posted the recorded span body
# (splunk_hec_receiver_probe.py), and the `debug` exporter's rendering of what it decoded is
# printed for testdata/interop/splunk/README.md.
record_splunk_otel() {
    echo "== recording: OpenTelemetry Collector splunk_hec exporter (${SPLUNK_OTEL_IMAGE}) =="
    ${DOCKER} run --rm "${SPLUNK_OTEL_IMAGE}" --version 2>&1 | sed 's/^/  [otelcol] /'
    splunk_capture otel 90 --max-per-path 1 \
        --require /services/collector=8 --require /services/collector/raw \
        --require /services/collector/health
    ${DOCKER} run -d --name otelcol --network "${NET}" --hostname splunk-otel-fixture \
        -v "${TOOLS_DIR}/otel-collector-splunk.yaml:/etc/otelcol-config.yaml:ro,z" \
        "${SPLUNK_OTEL_IMAGE}" --config /etc/otelcol-config.yaml >/dev/null
    sleep 3

    local gen_args=(--otlp-endpoint otelcol:4317 --otlp-insecure --service splunk-otel-fixture --rate=0)
    local run
    for run in \
        "traces --traces=3" \
        "logs --logs=3 --severity-text=Warn --severity-number=13 --trace-id=0af7651916cd43dd8448eb211c80319c --span-id=b7ad6b7169203331 --telemetry-attributes=fixture.tags=[\"a\",\"b\"]" \
        "metrics --metrics=3 --metric-type=Gauge" \
        "metrics --metrics=3 --metric-type=Sum" \
        "metrics --metrics=3 --metric-type=ExponentialHistogram" \
        "metrics --metrics=3 --metric-type=Histogram"; do
        echo "-- telemetrygen ${run%% *}"
        # shellcheck disable=SC2086 # word splitting is the point: one run's flags
        ${DOCKER} run --rm --network "${NET}" "${SPLUNK_TELEMETRYGEN_IMAGE}" ${run} "${gen_args[@]}" \
            2>&1 | grep -E 'error|fail' | sed 's/^/  [telemetrygen] /' || true
        # Past the batch processor's 3 s timeout, so each run is its own request.
        sleep 5
    done
    local status=0
    finish_capture || status=$?

    echo "-- the Collector's splunk_hec receiver, posted the recorded span body"
    ${DOCKER} run --rm --network "${NET}" -v "${SPLUNK_OUT}:/data:ro,z" \
        -v "${TOOLS_DIR}/splunk_hec_receiver_probe.py:/probe.py:ro,z" python:3.12-slim \
        python3 /probe.py /data http://otelcol:8088/services/collector 2>&1 | sed 's/^/  [probe] /' || status=1
    sleep 2
    ${DOCKER} logs otelcol 2>&1 | sed -n '/ResourceLog #0/,$p' | head -60 | sed 's/^/  [otelcol debug] /'
    ${DOCKER} rm -f otelcol >/dev/null 2>&1 || true
    return "${status}"
}

# Docker's `splunk` log driver, run by a docker:dind daemon rather than this machine's, so the
# `host` the driver stamps is the dind container's fixed hostname. The inner daemon reaches the
# capture sink through the outer network's resolver. Three containers, one per `splunk-format`,
# each echoing a JSON line and a plain line and exiting; the driver flushes on close, so each is
# one request. `json` also sets `splunk-source`/`-sourcetype`/`-index`, and `raw` sets
# `splunk-gzip`. The alpine image is loaded into the inner daemon from this one, not pulled.
record_splunk_docker() {
    echo "== recording: Docker's splunk log driver (${SPLUNK_DIND_IMAGE}) =="
    ${DOCKER} image inspect "${SPLUNK_ALPINE_IMAGE}" >/dev/null 2>&1 || ${DOCKER} pull -q "${SPLUNK_ALPINE_IMAGE}" >/dev/null
    splunk_capture docker 180 --max-per-path 1 \
        --require /services/collector/event/1.0=6
    ${DOCKER} run -d --name splunk-dind --privileged --hostname splunk-docker-fixture \
        --network "${NET}" -e DOCKER_TLS_CERTDIR= "${SPLUNK_DIND_IMAGE}" >/dev/null
    local tries=0
    until ${DOCKER} exec splunk-dind docker info >/dev/null 2>&1; do
        tries=$((tries + 1))
        if [ "${tries}" -gt 60 ]; then
            echo "record-fixtures: the dind daemon never came up" >&2
            ${DOCKER} logs splunk-dind 2>&1 | tail -20 | sed 's/^/  [dind] /'
            return 1
        fi
        sleep 1
    done
    ${DOCKER} exec splunk-dind docker version --format 'server {{.Server.Version}}' | sed 's/^/  [dind] /'
    ${DOCKER} save "${SPLUNK_ALPINE_IMAGE}" | ${DOCKER} exec -i splunk-dind docker load -q | sed 's/^/  [dind] /'

    local common=(--log-driver splunk --log-opt splunk-url=http://capture:8088
        --log-opt "splunk-token=${SPLUNK_TOKEN}" --log-opt splunk-insecureskipverify=true)
    local format extra
    for format in inline json raw; do
        extra=()
        case "${format}" in
        json) extra=(--log-opt splunk-source=docker:fixture --log-opt splunk-sourcetype=docker:json
            --log-opt splunk-index=main) ;;
        raw) extra=(--log-opt splunk-gzip=true) ;;
        esac
        echo "-- splunk-format=${format}"
        ${DOCKER} exec splunk-dind docker run --rm --name "splunk-${format}" "${common[@]}" \
            --log-opt "splunk-format=${format}" "${extra[@]}" "${SPLUNK_ALPINE_IMAGE}" \
            sh -c "echo '{\"level\":\"info\",\"msg\":\"splunk-docker fixture ${format}\",\"n\":1}'; echo 'splunk-docker fixture plain line (${format})'" \
            2>&1 | sed 's/^/  [dind] /'
    done
    local status=0
    finish_capture || status=$?
    ${DOCKER} rm -f -v splunk-dind >/dev/null 2>&1 || true
    return "${status}"
}

# Splunk Connect for Syslog, forwarding three syslog lines (splunk-sc4s-lines.txt: two RFC 5424,
# one RFC 3164, each naming the fixed host `sc4s-fixture-host`) over UDP 514 to HEC. Seven
# requests, in a fixed order: the entrypoint's two `curl` connection tests ("HEC TEST EVENT"),
# syslog-ng's two startup events, then one request per line (sent 200 ms apart). The lines go as
# soon as syslog-ng is up, because SC4S also posts its own metrics every 30 s, a ~44 KB body per
# flush that the corpus doesn't keep (testdata/interop/splunk/README.md describes its shape).
record_splunk_sc4s() {
    echo "== recording: Splunk Connect for Syslog (${SPLUNK_SC4S_IMAGE}) =="
    splunk_capture sc4s 120 --max-per-path 1 --require /services/collector/event=7
    ${DOCKER} run -d --name splunk-sc4s --network "${NET}" --hostname splunk-sc4s-fixture \
        -e SC4S_DEST_SPLUNK_HEC_DEFAULT_URL=http://capture:8088 \
        -e "SC4S_DEST_SPLUNK_HEC_DEFAULT_TOKEN=${SPLUNK_TOKEN}" \
        -e SC4S_DEST_SPLUNK_HEC_DEFAULT_TLS_VERIFY=no \
        -e SC4S_DEST_SPLUNK_HEC_DEFAULT_DISKBUFF_ENABLE=no \
        -e SC4S_SOURCE_LISTEN_UDP_SOCKETS=1 \
        "${SPLUNK_SC4S_IMAGE}" >/dev/null
    local tries=0
    until ${DOCKER} logs splunk-sc4s 2>&1 | grep -q 'starting syslog-ng'; do
        tries=$((tries + 1))
        if [ "${tries}" -gt 90 ]; then
            echo "record-fixtures: SC4S never started syslog-ng" >&2
            ${DOCKER} logs splunk-sc4s 2>&1 | tail -20 | sed 's/^/  [sc4s] /'
            break
        fi
        sleep 1
    done
    # syslog-ng binds its sources a moment after the entrypoint says it is starting.
    sleep 3
    ${DOCKER} run --rm --network "${NET}" -v "${TOOLS_DIR}/splunk-sc4s-lines.txt:/lines.txt:ro,z" \
        python:3.12-slim python3 -c "
import socket, time
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
for line in open('/lines.txt').read().splitlines():
    s.sendto(line.encode(), ('splunk-sc4s', 514))
    time.sleep(0.2)
"
    local status=0
    finish_capture || status=$?
    ${DOCKER} logs splunk-sc4s 2>&1 | grep -E 'version|HEC|error' | sed 's/^/  [sc4s] /'
    ${DOCKER} rm -f -v splunk-sc4s >/dev/null 2>&1 || true
    return "${status}"
}

# Splunk's Java logging library (`splunk-library-javalogging`), through a one-class Logback app
# built and run in one maven container from tools/record-fixtures/splunk-java/ (its logback.xml
# says what each of the three appenders sends). Three lines each, one request per line: six to
# `/services/collector/event/1.0` and three to `/services/collector/raw`. The appenders send
# asynchronously, so the two `/event` appenders' requests interleave in no fixed order. The 600 s
# timeout covers the first run's Maven downloads.
record_splunk_java() {
    echo "== recording: splunk-library-javalogging Logback appender (${MAVEN_IMAGE}) =="
    splunk_capture java 600 --max-per-path 1 \
        --require /services/collector/event/1.0=6 --require /services/collector/raw=3
    ${DOCKER} run --rm --name splunk-java --network "${NET}" --hostname splunk-java-fixture \
        -v "${TOOLS_DIR}/splunk-java:/src:ro,z" "${MAVEN_IMAGE}" \
        bash -c "cp -r /src /build && cd /build && java -version 2>&1 | head -1 \
            && mvn -q -B package dependency:copy-dependencies -DskipTests \
            && ls target/dependency | grep -E 'splunk|logback|okhttp' \
            && java -Dlogback.configurationFile=/build/logback.xml -cp 'target/classes:target/dependency/*' Main" \
        2>&1 | sed 's/^/  [java] /'
    finish_capture
}

# check_splunk_capture.py over the whole directory: fails on anything describing this machine
# (its hostname, read here and passed in) and on a construct the tests read that no capture holds.
check_splunk_capture() {
    ${DOCKER} run --rm -v "${SPLUNK_OUT}:/data:ro,z" \
        -v "${TOOLS_DIR}/check_splunk_capture.py:/check.py:ro,z" python:3.12-slim \
        python3 /check.py /data "$(hostname)" 2>&1 | sed 's/^/  [check] /'
    return "${PIPESTATUS[0]}"
}

# The four producers, then the check, which runs whatever their outcome: a failed producer can
# still have written captures into testdata/.
record_splunk() {
    local status=0
    record_splunk_otel || status=1
    record_splunk_docker || status=1
    record_splunk_sc4s || status=1
    record_splunk_java || status=1
    check_splunk_capture || status=1
    return "${status}"
}

# ---- influxdb ------------------------------------------------------------------------------------

INFLUXDB_TELEGRAF_IMAGE="docker.io/library/telegraf:1.40.2@sha256:aedc74ac64c623b6e6760545a8ff56a63b99a798bba3d361279a2887642798cf"

# Telegraf's `outputs.influxdb_v2`, twice (telegraf-influxdb-v2.conf): the default gzip body and
# `content_encoding = "identity"`, written to a capture sink standing where InfluxDB 2.x would, on
# port 8086, answering `204` to every write. The inputs are cpu, mem, system, and an `inputs.file`
# over telegraf-influxdb-lines.txt. Telegraf streams every body chunked, whatever its encoding, so
# the sink runs with --accept-chunked. Six writes are three 5 s flushes of both outputs.
record_influxdb() {
    echo "== recording: Telegraf outputs.influxdb_v2 (${INFLUXDB_TELEGRAF_IMAGE}) =="
    local out="${OUT_ROOT}/influxdb"
    ${DOCKER} run --rm "${INFLUXDB_TELEGRAF_IMAGE}" telegraf --version 2>&1 | sed 's/^/  [telegraf] /'
    start_capture http 8086 "${out}" telegraf 0 90 --name-by-path --accept-chunked \
        --require /api/v2/write=6
    ${DOCKER} run -d --name telegraf --network "${NET}" \
        -v "${TOOLS_DIR}/telegraf-influxdb-v2.conf:/etc/telegraf/telegraf.conf:ro,z" \
        -v "${TOOLS_DIR}/telegraf-influxdb-lines.txt:/etc/telegraf/lines.txt:ro,z" \
        "${INFLUXDB_TELEGRAF_IMAGE}" >/dev/null
    local status=0
    finish_capture || status=$?
    ${DOCKER} logs telegraf 2>&1 | grep -E ' [EW]! ' | head -20 | sed 's/^/  [telegraf] /' || true
    ${DOCKER} rm -f telegraf >/dev/null 2>&1 || true
    return "${status}"
}

# ---- Kafka --------------------------------------------------------------------------------------
#
# One producer, `kafka`, writing testdata/interop/kafka/ (its README has the provenance): reference
# vectors for `kafka_out` (docs/adr/kafka-output.md), from the Java client in the Apache Kafka
# image and from kcat (librdkafka), against a single-node KRaft broker.
#   murmur2.json              the Java client's own partitioner, over a fixed key set
#   partitioner-crosscheck.tsv  the same keys produced by the console producer and by kcat, and
#                             the partition each landed on
#   batches/<producer>-<compression>.{log,txt}  the broker's stored segment and its
#                             kafka-dump-log.sh rendering, per producer and compression
#   api-versions.txt          the broker's ApiVersions ranges

KAFKA_OUT="${OUT_ROOT}/kafka"
KAFKA_IMAGE="apache/kafka:4.2.0"
KCAT_IMAGE="edenhill/kcat:1.7.1"
# Compiles Murmur2Vectors.java only; pinned by digest because the tag moves with Maven and JDK
# patch releases.
KAFKA_JDK_IMAGE="maven:3.9.16-eclipse-temurin-17@sha256:1a352420f7aba21f5ad08df31bab55f74c013fb491f1ae8ab1dd7ff9ed698584"
KAFKA_BROKER="kafka-record-broker"
KAFKA_BIN="/opt/kafka/bin"
KAFKA_BOOTSTRAP="kafka-record-broker:9092"

# kafka_exec <args...>: runs a command in the broker container, with stdin passed through.
kafka_exec() { ${DOCKER} exec -i "${KAFKA_BROKER}" "$@"; }
kafka_topic() { # <name> <partitions>
    kafka_exec "${KAFKA_BIN}/kafka-topics.sh" --bootstrap-server "${KAFKA_BOOTSTRAP}" --create \
        --topic "$1" --partitions "$2" >/dev/null
}
kcat() { ${DOCKER} run --rm -i --network "${KAFKA_NET}" "${KCAT_IMAGE}" -b "${KAFKA_BOOTSTRAP}" "$@"; }

record_kafka() {
    echo "== recording: Kafka ${KAFKA_IMAGE} and kcat ${KCAT_IMAGE} =="
    local work kdir="${TOOLS_DIR}/kafka"
    work="$(mktemp -d)"
    mkdir -p "${KAFKA_OUT}/batches"
    ${DOCKER} network create "${KAFKA_NET}" >/dev/null 2>&1 || true
    ${DOCKER} rm -f "${KAFKA_BROKER}" >/dev/null 2>&1 || true
    ${DOCKER} run -d --name "${KAFKA_BROKER}" --network "${KAFKA_NET}" --hostname "${KAFKA_BROKER}" \
        -e KAFKA_NODE_ID=1 -e KAFKA_PROCESS_ROLES=broker,controller \
        -e KAFKA_LISTENERS=PLAINTEXT://:9092,CONTROLLER://:9093 \
        -e "KAFKA_ADVERTISED_LISTENERS=PLAINTEXT://${KAFKA_BOOTSTRAP}" \
        -e KAFKA_CONTROLLER_LISTENER_NAMES=CONTROLLER \
        -e KAFKA_LISTENER_SECURITY_PROTOCOL_MAP=CONTROLLER:PLAINTEXT,PLAINTEXT:PLAINTEXT \
        -e "KAFKA_CONTROLLER_QUORUM_VOTERS=1@${KAFKA_BROKER}:9093" \
        -e KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR=1 -e KAFKA_TRANSACTION_STATE_LOG_REPLICATION_FACTOR=1 \
        -e KAFKA_TRANSACTION_STATE_LOG_MIN_ISR=1 -e KAFKA_GROUP_INITIAL_REBALANCE_DELAY_MS=0 \
        "${KAFKA_IMAGE}" >/dev/null
    local i
    for i in $(seq 60); do
        kafka_exec "${KAFKA_BIN}/kafka-broker-api-versions.sh" --bootstrap-server "${KAFKA_BOOTSTRAP}" \
            >"${work}/api.txt" 2>/dev/null && break
        sleep 2
    done
    [ -s "${work}/api.txt" ] || { echo "record-fixtures: kafka broker never came up" >&2; return 1; }

    # ApiVersions: the four a producer uses first, then the broker's whole answer.
    {
        echo "# ${KAFKA_IMAGE} kafka-broker-api-versions.sh, $(date -u +%F)"
        grep -E '^\s*(Produce|Metadata|InitProducerId|ApiVersions)\(' "${work}/api.txt"
        echo "# the broker's whole answer"
        cat "${work}/api.txt"
    } >"${KAFKA_OUT}/api-versions.txt"

    # murmur2: the Java client's Utils.murmur2, from the kafka-clients jar in the broker image. That
    # image has a JRE and no javac, so the class is compiled in a JDK image against the same jar.
    echo "-- murmur2 vectors"
    mkdir -p "${work}/libs" "${work}/cls"
    ${DOCKER} cp "${KAFKA_BROKER}:/opt/kafka/libs/." "${work}/libs/"
    ${DOCKER} run --rm --name kafka-record-javac -v "${work}/libs:/libs:ro,z" -v "${kdir}:/src:ro,z" \
        -v "${work}/cls:/out:z" "${KAFKA_JDK_IMAGE}" \
        javac --release 17 -cp '/libs/*' -d /out /src/Murmur2Vectors.java
    ${DOCKER} cp "${work}/cls/Murmur2Vectors.class" "${KAFKA_BROKER}:/tmp/"
    local counts=(1 3 6 12 100)
    python3 -I "${kdir}/murmur2_json.py" keys \
        | kafka_exec java -cp '/opt/kafka/libs/*:/tmp' Murmur2Vectors "${counts[@]}" >"${work}/m2.txt"
    python3 -I "${kdir}/murmur2_json.py" format "${counts[@]}" <"${work}/m2.txt" >"${KAFKA_OUT}/murmur2.json"

    # Partitioner cross-check on 6 partitions: console producer, kcat murmur2_random, kcat default.
    echo "-- partitioner cross-check"
    local t
    for t in kafka-record-x-java kafka-record-x-m2 kafka-record-x-def; do kafka_topic "${t}" 6; done
    python3 -I "${kdir}/murmur2_json.py" textkeys | awk '{ printf "%s\tv-%d\n", $0, NR }' >"${work}/kv.tsv"
    kafka_exec "${KAFKA_BIN}/kafka-console-producer.sh" --bootstrap-server "${KAFKA_BOOTSTRAP}" \
        --topic kafka-record-x-java --reader-property parse.key=true <"${work}/kv.tsv" 2>/dev/null
    awk -F'\t' '{ printf "%s:%s\n", $1, $2 }' "${work}/kv.tsv" >"${work}/kv.colon"
    kcat -P -t kafka-record-x-m2 -K: -X partitioner=murmur2_random <"${work}/kv.colon"
    kcat -P -t kafka-record-x-def -K: <"${work}/kv.colon"
    kafka_exec "${KAFKA_BIN}/kafka-console-consumer.sh" --bootstrap-server "${KAFKA_BOOTSTRAP}" \
        --topic kafka-record-x-java --from-beginning --timeout-ms 10000 \
        --formatter-property print.partition=true --formatter-property print.key=true --formatter-property print.value=false \
        2>/dev/null | sed -n 's/^Partition://p' >"${work}/java.out"
    local topic out
    for t in m2:m2 def:def; do
        topic="kafka-record-x-${t%%:*}"; out="${work}/${t##*:}.out"
        kcat -C -t "${topic}" -o beginning -e -f '%p\t%k\n' >"${out}"
    done
    python3 -I "${kdir}/murmur2_json.py" compare "${work}/java.out" "${work}/m2.out" "${work}/def.out" \
        <"${KAFKA_OUT}/murmur2.json" >"${KAFKA_OUT}/partitioner-crosscheck.tsv" || {
        echo "record-fixtures: a console-producer or kcat murmur2_random landing differs from the Java computation" >&2
        return 1
    }

    # Stored batches: one single-partition topic per (producer, compression), each given the same
    # three records with the header h1=hv1. Every record carries the header because the console
    # producer requires one on every line once parse.headers is set, and kcat -H applies to all.
    echo "-- stored record batches"
    local comp producer topic seg
    local v1 v2 v3 zargs
    v1="the quick brown fox jumps over the lazy dog, record one"
    v2="the quick brown fox jumps over the lazy dog, record two"
    v3="the quick brown fox jumps over the lazy dog, record three"
    for producer in java kcat; do
        for comp in none gzip snappy lz4 zstd; do
            topic="kafka-record-b-${producer}-${comp}"
            kafka_topic "${topic}" 1
            if [ "${producer}" = java ]; then
                printf 'h1:hv1\tkey-1\t%s\nh1:hv1\tkey-2\t%s\nh1:hv1\tkey-3\t%s\n' "${v1}" "${v2}" "${v3}" \
                    | kafka_exec "${KAFKA_BIN}/kafka-console-producer.sh" --bootstrap-server "${KAFKA_BOOTSTRAP}" \
                        --topic "${topic}" --reader-property parse.key=true --reader-property parse.headers=true \
                        --compression-codec "${comp}" 2>/dev/null
            else
                zargs=()
                [ "${comp}" = none ] || zargs=(-z "${comp}")
                printf 'key-1:%s\nkey-2:%s\nkey-3:%s\n' "${v1}" "${v2}" "${v3}" \
                    | kcat -P -t "${topic}" -K: -H h1=hv1 "${zargs[@]}" -X queue.buffering.max.ms=500
            fi
        done
    done
    # Copy each segment and its kafka-dump-log.sh rendering out, after every producer has run.
    # Each segment is saved as `.segment`, not `.log`: `.gitignore`'s `*.log` would leave it untracked.
    for producer in java kcat; do
        for comp in none gzip snappy lz4 zstd; do
            topic="kafka-record-b-${producer}-${comp}"
            seg="$(kafka_exec find / -path "*/${topic}-0/*.log" 2>/dev/null | head -1 | tr -d '\r' || true)"
            kafka_exec cat "${seg}" >"${KAFKA_OUT}/batches/${producer}-${comp}.segment"
            {
                echo "# ${KAFKA_IMAGE} kafka-dump-log.sh --files <${topic}-0/00000000000000000000.log> --print-data-log --deep-iteration"
                kafka_exec "${KAFKA_BIN}/kafka-dump-log.sh" --files "${seg}" --print-data-log --deep-iteration \
                    | sed '/^Dumping /d'
            } >"${KAFKA_OUT}/batches/${producer}-${comp}.txt"
        done
    done
    {
        echo "image ${KAFKA_IMAGE} $(${DOCKER} inspect --format '{{index .RepoDigests 0}}' "${KAFKA_IMAGE}")"
        echo "image ${KCAT_IMAGE} $(${DOCKER} inspect --format '{{index .RepoDigests 0}}' "${KCAT_IMAGE}")"
        echo "image ${KAFKA_JDK_IMAGE}"
    } >&2
    ${DOCKER} rm -f -v "${KAFKA_BROKER}" >/dev/null 2>&1 || true
    rm -rf "${work}"
}

# ---- cri: the kubelet's pod log files, written by containerd and CRI-O -----------------------------

# Pinned: kind's release notes name the node image each kind release was built with, and minikube
# picks its Kubernetes and CRI-O versions per release.
KIND_VERSION="v0.33.0"
KIND_SHA256_AMD64="aee6151561422756b764a4ae28e7f44cda5af5a9eead3cc9985112b1de8d8e0d"
KIND_NODE_IMAGE="kindest/node:v1.37.0@sha256:a1ed56cfb0e7b93589bdf97c8cd566405a265939e3620fc4f5de89adff580ae5"
MINIKUBE_VERSION="v1.39.0"
MINIKUBE_SHA256_AMD64="b738496da01be06bbaf80c688f57ce25acd3849fbb518155f3a88e03ef555aa4"
CRI_CLUSTER="logit-record-cri"
CRI_NODE="${CRI_CLUSTER}-control-plane"
CRIO_PROFILE="logit-record-crio"
CRI_WORK="" # set by the recorders, removed by cleanup()

# cri_as_root <command...>: runs a pinned binary as root when $DOCKER needs sudo, since kind and
# minikube drive the same docker daemon.
cri_as_root() {
    if [ "${DOCKER}" = "sudo docker" ]; then
        sudo env MINIKUBE_HOME="${CRI_WORK}/mk" "$@"
    else
        env MINIKUBE_HOME="${CRI_WORK}/mk" "$@"
    fi
}

# cri_fetch <name> <url> <sha256>: downloads a binary into $CRI_WORK and checks its digest.
cri_fetch() {
    [ -n "${CRI_WORK}" ] || CRI_WORK="$(mktemp -d)"
    curl -fsSL -o "${CRI_WORK}/$1" "$2"
    echo "$3  ${CRI_WORK}/$1" | sha256sum --check --quiet
    chmod +x "${CRI_WORK}/$1"
}

# cri_wait <seconds> <what> <command...>: polls until the command succeeds, or fails.
cri_wait() {
    local limit="$1" what="$2" waited=0
    shift 2
    until "$@" >/dev/null 2>&1; do
        if [ "${waited}" -ge "${limit}" ]; then
            echo "record-fixtures: timed out after ${limit}s waiting for ${what}" >&2
            return 1
        fi
        sleep 2
        waited=$((waited + 2))
    done
}

# cri_teardown: deletes both clusters' node containers. Safe to call twice.
cri_teardown() {
    if [ -n "${CRI_WORK}" ] && [ -x "${CRI_WORK}/kind" ]; then
        cri_as_root "${CRI_WORK}/kind" delete cluster --name "${CRI_CLUSTER}" >/dev/null 2>&1 || true
    fi
    if [ -n "${CRI_WORK}" ] && [ -x "${CRI_WORK}/minikube" ]; then
        cri_as_root "${CRI_WORK}/minikube" delete -p "${CRIO_PROFILE}" >/dev/null 2>&1 || true
    fi
    ${DOCKER} rm -f -v "${CRI_NODE}" "${CRIO_PROFILE}" >/dev/null 2>&1 || true
    # minikube keeps a named volume for its node, which `rm -v` leaves.
    ${DOCKER} volume rm "${CRIO_PROFILE}" "${CRI_NODE}" >/dev/null 2>&1 || true
    ${DOCKER} network rm "${CRIO_PROFILE}" >/dev/null 2>&1 || true
}

# cri_record_tree <node container> <kubectl path in the node> <out dir> <version command>:
# runs the pods in tools/record-fixtures/cri/ on a node whose kubelet is already set to rotate at
# 24 KiB every 3 s, and copies the kubelet's /var/log/pods tree and a manifest of its
# /var/log/containers symlinks into <out dir>.
cri_record_tree() {
    local node="$1" kubectl_bin="$2" out="$3" versions="$4"
    local cri_dir="${TOOLS_DIR}/cri" pods="/var/log/pods" rot_dir edge_dir
    local kubectl=(${DOCKER} exec "${node}" "${kubectl_bin}" --kubeconfig /etc/kubernetes/admin.conf)

    ${DOCKER} cp "${cri_dir}/pods.yaml" "${node}:/etc/logit-pods.yaml"
    cri_wait 120 "the API server" "${kubectl[@]}" get nodes
    # A new namespace's default service account takes a moment, and apply is idempotent.
    cri_wait 120 "the pods to apply" "${kubectl[@]}" apply -f /etc/logit-pods.yaml
    # Placing the manifest is all a static pod takes; the kubelet watches the directory.
    ${DOCKER} cp "${cri_dir}/static-pod.yaml" "${node}:/etc/kubernetes/manifests/static-hello.yaml"

    # The kubelet's container GC removes an older dead attempt's directory within a minute of the
    # next attempt, so a loop in the node copies edge's files and symlink names as they appear.
    ${DOCKER} exec -d "${node}" sh -c '
        mkdir -p /snap
        while :; do
            for d in /var/log/pods/cri-fixture_edge_*/writer; do
                [ -d "$d" ] || continue
                dest="/snap/$(basename "$(dirname "$d")")/writer"
                mkdir -p "$dest" && cp -a "$d/." "$dest/"
            done
            for f in /var/log/containers/*_cri-fixture_*; do
                [ -L "$f" ] && echo "$(basename "$f") -> $(readlink "$f")" >> /snap/symlinks.raw
            done
            sleep 0.5
        done'

    # `edge` ends its first run on an unterminated line, restarts, and ends its second the same way.
    cri_wait 300 "edge's restarted run to write 1.log" \
        ${DOCKER} exec "${node}" sh -c "grep -q 'second run dangling' /snap/cri-fixture_edge_*/writer/1.log"
    cri_wait 300 "rotator to finish" \
        sh -c "[ \"\$(${DOCKER} exec ${node} ${kubectl_bin} --kubeconfig /etc/kubernetes/admin.conf -n cri-fixture get pod rotator -o jsonpath='{.status.phase}')\" = Succeeded ]"
    cri_wait 120 "the static pod's log" \
        ${DOCKER} exec "${node}" sh -c "ls ${pods}/cri-fixture_static-hello-*/hello/0.log"
    # The kubelet gzips a rotated file on the rotation after its rename, so a .gz means two ran.
    rot_dir="$(${DOCKER} exec "${node}" sh -c "echo ${pods}/cri-fixture_rotator_*/spin")"
    if ! ${DOCKER} exec "${node}" sh -c "ls ${rot_dir}/0.log.*.gz" >/dev/null 2>&1; then
        echo "record-fixtures: the kubelet never gzipped a rotated file of ${rot_dir}" >&2
        return 1
    fi
    edge_dir="$(${DOCKER} exec "${node}" sh -c "echo /snap/cri-fixture_edge_*/writer")"
    ${DOCKER} exec "${node}" sh -c "ls -l ${rot_dir} ${edge_dir}" | sed 's/^/  [node] /'

    rm -rf "${out}"
    mkdir -p "${out}"
    # Everything but edge comes from /var/log/pods; edge comes from the copy loop's /snap.
    ${DOCKER} exec "${node}" sh -c \
        "cd ${pods} && tar -cf - \$(ls -d cri-fixture_* | grep -v '^cri-fixture_edge_')" \
        | tar -x -C "${out}" --no-same-owner --one-top-level=pods
    ${DOCKER} exec "${node}" sh -c "cd /snap && tar -cf - cri-fixture_edge_*" \
        | tar -x -C "${out}/pods" --no-same-owner
    ${DOCKER} exec "${node}" sh -c 'sort -u /snap/symlinks.raw' | LC_ALL=C sort > "${out}/symlinks.txt"
    {
        eval "${versions}"
        ${DOCKER} exec "${node}" sh -c '(kubelet --version || /var/lib/minikube/binaries/*/kubelet --version); crictl --version; crictl images --digests | grep busybox'
    } > "${out}/versions.txt" 2>&1
    sed 's/^/  [versions] /' "${out}/versions.txt"
    chmod -R u+rwX,go+rX "${out}"
}

# A kind node: containerd and a real kubelet.
record_cri_containerd() {
    echo "== recording: containerd in a kind ${KIND_VERSION} node (${KIND_NODE_IMAGE%%@*}) =="
    if [ "$(uname -m)" != "x86_64" ]; then
        echo "record-fixtures: cri pins linux-amd64 binaries; add the arm64 digests to record elsewhere" >&2
        return 1
    fi
    cri_fetch kind "https://github.com/kubernetes-sigs/kind/releases/download/${KIND_VERSION}/kind-linux-amd64" \
        "${KIND_SHA256_AMD64}"
    cri_teardown
    cri_as_root "${CRI_WORK}/kind" create cluster --name "${CRI_CLUSTER}" --image "${KIND_NODE_IMAGE}" \
        --config "${TOOLS_DIR}/cri/kind-config.yaml" --kubeconfig "${CRI_WORK}/kubeconfig" --wait 180s
    cri_record_tree "${CRI_NODE}" kubectl "${OUT_ROOT}/cri/containerd" \
        "echo \"kind ${KIND_VERSION}\"; echo \"node image ${KIND_NODE_IMAGE}\"; ${DOCKER} exec ${CRI_NODE} containerd --version"
    cri_teardown
}

# A minikube node: CRI-O and a real kubelet. The kubelet's rotation settings are
# KubeletConfiguration fields, so they are appended to the node's config and the kubelet restarted.
record_cri_crio() {
    echo "== recording: CRI-O in a minikube ${MINIKUBE_VERSION} node =="
    if [ "$(uname -m)" != "x86_64" ]; then
        echo "record-fixtures: cri pins linux-amd64 binaries; add the arm64 digests to record elsewhere" >&2
        return 1
    fi
    local force=()
    [ "${DOCKER}" = "sudo docker" ] && force=(--force)
    cri_fetch minikube "https://github.com/kubernetes/minikube/releases/download/${MINIKUBE_VERSION}/minikube-linux-amd64" \
        "${MINIKUBE_SHA256_AMD64}"
    cri_teardown
    cri_as_root "${CRI_WORK}/minikube" start -p "${CRIO_PROFILE}" --driver=docker \
        --container-runtime=cri-o --memory=2g --wait=apiserver,system_pods "${force[@]}"
    ${DOCKER} exec "${CRIO_PROFILE}" sh -c \
        "printf 'containerLogMaxSize: 24Ki\ncontainerLogMonitorInterval: 3s\n' >> /var/lib/kubelet/config.yaml && systemctl restart kubelet"
    local kubectl_bin
    kubectl_bin="$(${DOCKER} exec "${CRIO_PROFILE}" sh -c 'echo /var/lib/minikube/binaries/*/kubectl')"
    cri_record_tree "${CRIO_PROFILE}" "${kubectl_bin}" "${OUT_ROOT}/cri/crio" \
        "echo \"minikube ${MINIKUBE_VERSION}\"; ${DOCKER} exec ${CRIO_PROFILE} crio --version | head -2"
    cri_teardown
}

record_cri() {
    record_cri_containerd
    record_cri_crio
}

# `stub_status` pages from four nginx-family servers, for `logit_proto::nginx_status`'s corpus
# (testdata/interop/nginx-status/): nginx stable and mainline from the official image, Angie from
# its own registry, and freenginx built from its release tarball by
# tools/record-fixtures/nginx-status/build-freenginx.sh, since freenginx publishes no image. Each
# runs tools/record-fixtures/nginx-status/status.conf, which serves nothing but the page.
#
# Two captures per server, each `<server>-<n>.body` byte for byte as served beside a `.headers`
# sidecar holding the response's status line and headers verbatim:
#   <server>-0  the first request after start: one active connection, the scrape itself
#   <server>-1  with tools/record-fixtures/nginx-status/connections.py holding three idle
#               connections (Waiting) and a half-sent request (Reading) open
#
# Tengine has no official image; its four-column form is tested from a literal in
# crates/logit-proto/src/nginx_status.rs's tests instead.
NGINX_STATUS_STABLE_IMAGE="nginx:1.30.6@sha256:66b50d24288dba67f3d000b31223daefc4868c58d29aaacb6a4ff9771597b5eb"
NGINX_STATUS_MAINLINE_IMAGE="nginx:1.31.8@sha256:5ab5b0b01097420873a3f3330f44248e34a3c2a3e8d5ee30658aeae8cb7435da"
NGINX_STATUS_ANGIE_IMAGE="docker.angie.software/angie:1.12.4@sha256:5e0cffc7863bdf9562db301c114f0a8cba21c3727854aa22c822d0fc7bf6dea4"
NGINX_STATUS_DEBIAN_IMAGE="debian:bookworm-slim@sha256:99c0b25c46d0214d5a2091092e7908907dcaecd6a962cde0ac700acee222b6f3"
NGINX_STATUS_FREENGINX_VERSION="1.30.2"
NGINX_STATUS_FREENGINX_SHA256="3166632fe3c74892e3fb216ed36d36e1bcaafa46a54d28c00d575998bc7ea927"

# status_page <out_dir> <stem> <url>: one GET, the body to <stem>.body and the response's head to
# <stem>.headers, both written on the host. curl's stderr also holds a line per retry while the
# server starts, so only the head from the last status line on is kept.
status_page() {
    local out="$1" stem="$2" url="$3" stderr
    stderr="$(mktemp)"
    ${DOCKER} run --rm --network "${NET}" "${PROM_SCRAPE_CURL_IMAGE}" \
        -sS --fail --retry 300 --retry-all-errors --retry-delay 1 \
        -D /dev/stderr -o - "${url}" \
        >"${out}/${stem}.body" 2>"${stderr}" || { cat "${stderr}" >&2; rm -f "${stderr}"; return 1; }
    awk '/^HTTP\//{head=""} {head=head $0 "\n"} END{printf "%s", head}' "${stderr}" \
        >"${out}/${stem}.headers"
    rm -f "${stderr}"
    echo "-- ${stem} ($(wc -c <"${out}/${stem}.body") bytes)"
    sed 's/^/  [body] /' "${out}/${stem}.body"
}

record_nginx_status() {
    echo "== recording: nginx-family stub_status pages (nginx, Angie, freenginx) =="
    local out="${OUT_ROOT}/nginx-status" dir="${TOOLS_DIR}/nginx-status"
    mkdir -p "${out}"
    rm -f "${out}"/*.body "${out}"/*.headers
    local conf=(-v "${dir}/status.conf:/status.conf:ro,z")

    local spec name
    for spec in stable mainline angie freenginx; do
        name="nginx-${spec}"
        [ "${spec}" = angie ] && name=angie
        [ "${spec}" = freenginx ] && name=freenginx
        case "${spec}" in
        stable | mainline)
            local image="${NGINX_STATUS_STABLE_IMAGE}"
            [ "${spec}" = mainline ] && image="${NGINX_STATUS_MAINLINE_IMAGE}"
            ${DOCKER} run -d --name status-server --network "${NET}" "${conf[@]}" "${image}" \
                nginx -c /status.conf -g 'daemon off;' >/dev/null
            ;;
        angie)
            ${DOCKER} run -d --name status-server --network "${NET}" "${conf[@]}" \
                "${NGINX_STATUS_ANGIE_IMAGE}" angie -c /status.conf -g 'daemon off;' >/dev/null
            ;;
        freenginx)
            ${DOCKER} run -d --name status-server --network "${NET}" "${conf[@]}" \
                -v "${dir}/build-freenginx.sh:/build-freenginx.sh:ro,z" \
                "${NGINX_STATUS_DEBIAN_IMAGE}" \
                sh /build-freenginx.sh "${NGINX_STATUS_FREENGINX_VERSION}" \
                "${NGINX_STATUS_FREENGINX_SHA256}" >/dev/null
            ;;
        esac
        status_page "${out}" "${name}-0" http://status-server:8080/nginx_status

        ${DOCKER} run -d --name status-connections --network "${NET}" \
            -v "${dir}/connections.py:/connections.py:ro,z" "${PROM_SCRAPE_PYTHON_IMAGE}" \
            python3 /connections.py status-server 8080 >/dev/null
        local i
        for i in $(seq 1 60); do
            ${DOCKER} logs status-connections 2>&1 | grep -q '^ready' && break
            sleep 1
        done
        ${DOCKER} logs status-connections 2>&1 | grep -q '^ready' ||
            { echo "record-fixtures: connections.py never became ready" >&2; return 1; }
        status_page "${out}" "${name}-1" http://status-server:8080/nginx_status

        ${DOCKER} logs status-server 2>&1 | grep -E 'version|warn|emerg' | sed 's/^/  [server] /' || true
        ${DOCKER} rm -f status-server status-connections >/dev/null 2>&1 || true
    done
}

# ---- entry point ----------------------------------------------------------------------------------

all=(logger python-syslog-handler rsyslog rsyslog-tcp collectd otlp graphite prometheus
    prometheus-scrape vmagent statsd datadog splunk influxdb kafka cri nginx-status)

producers=("$@")
if [ "${#producers[@]}" -eq 0 ]; then
    producers=("${all[@]}")
fi

${DOCKER} network create "${NET}" >/dev/null 2>&1 || true
trap cleanup EXIT

for p in "${producers[@]}"; do
    case "${p}" in
    logger) record_logger ;;
    python-syslog-handler) record_python_syslog_handler ;;
    rsyslog) record_rsyslog ;;
    rsyslog-tcp) record_rsyslog_tcp ;;
    collectd) record_collectd ;;
    otlp) record_otlp ;;
    graphite) record_graphite ;;
    graphite-p0) record_graphite_p0 ;;
    graphite-py2) record_graphite_py2 ;;
    graphite-dropwizard) record_graphite_dropwizard ;;
    prometheus) record_prometheus ;;
    prometheus-scrape) record_prometheus_scrape ;;
    vmagent) record_vmagent ;;
    statsd) record_statsd ;;
    datadog-agent) record_datadog_agent ;;
    datadog-tracer) record_datadog_tracer ;;
    datadog-dogstatsd-unix) record_datadog_dogstatsd_unix ;;
    splunk-otel) record_splunk_otel ;;
    splunk-docker) record_splunk_docker ;;
    splunk-sc4s) record_splunk_sc4s ;;
    splunk-java) record_splunk_java ;;
    splunk) record_splunk ;;
    influxdb) record_influxdb ;;
    kafka) record_kafka ;;
    cri) record_cri ;;
    nginx-status) record_nginx_status ;;
    cri-containerd) record_cri_containerd ;;
    cri-crio) record_cri_crio ;;
    datadog)
        record_datadog_dogstatsd_unix
        record_datadog_tracer
        record_datadog_agent
        ;;
    *)
        echo "record-fixtures: unknown producer '${p}'" >&2
        exit 1
        ;;
    esac
done

echo "Recorded fixtures under ${OUT_ROOT} -- review the diff (git status/diff testdata/interop) and commit."
