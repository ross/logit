#!/bin/bash
# Usage: IMAGE_REPO=<repo> IMAGE_PUSH=1 script/image [tag]
# Builds the production runtime image (Dockerfile, not Dockerfile.dev) and tags it
# `<IMAGE_REPO>:<tag>` (defaults: `logit`, `local`). IMAGE_PUSH=1 also pushes it, after a
# `docker login ghcr.io`. See docs/adr/publish-release-image-to-ghcr.md.
#
#   IMAGE_REPO=ghcr.io/ross/logit IMAGE_PUSH=1 script/image latest
#
# Calls $DOCKER directly, not common.sh's `run`: `run` executes inside the dev container, and this
# needs the host's Docker daemon.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TAG="${1:-local}"
IMAGE_REPO="${IMAGE_REPO:-logit}"

${DOCKER} build -f Dockerfile -t "${IMAGE_REPO}:${TAG}" .
echo "Built ${IMAGE_REPO}:${TAG}"

if [ -n "${IMAGE_PUSH:-}" ]; then
    ${DOCKER} push "${IMAGE_REPO}:${TAG}"
    echo "Pushed ${IMAGE_REPO}:${TAG}"
fi
