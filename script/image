#!/bin/bash
# Usage: IMAGE_REPO=<repo> IMAGE_PUSH=1 script/image [tag]
# Builds the production runtime image (Dockerfile, not Dockerfile.dev) -- what a consumer builds
# or pulls to actually run `logit` (docs/plans/nginx-integration.md, workstream B;
# docs/adr/publish-release-image-to-ghcr.md). Tags the result `<IMAGE_REPO>:<tag>` (default repo
# `logit`, default tag `local`), and pushes it too when IMAGE_PUSH=1 -- e.g., after a
# `docker login ghcr.io`:
#
#   IMAGE_REPO=ghcr.io/ross/logit IMAGE_PUSH=1 script/image latest
#
# Builds directly against $DOCKER, not through the `run` helper in common.sh -- `run` executes
# inside the dev container (or CI's equivalent image), and this needs to invoke the host's Docker
# daemon itself, the same reasoning as common.sh's own `build_image`.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TAG="${1:-local}"
IMAGE_REPO="${IMAGE_REPO:-logit}"

${DOCKER} build -f Dockerfile -t "${IMAGE_REPO}:${TAG}" .
echo "Built ${IMAGE_REPO}:${TAG}"

if [ -n "${IMAGE_PUSH:-}" ]; then
    ${DOCKER} push "${IMAGE_REPO}:${TAG}"
    echo "Pushed ${IMAGE_REPO}:${TAG}"
fi
