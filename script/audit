#!/bin/bash
# Usage: script/audit [advisories|bans|licenses|sources ...]
# Supply-chain checks through cargo-deny, against deny.toml's policy. With no arguments, runs all
# four checks. `bans`, `licenses`, and `sources` depend only on the checkout, so script/cibuild
# runs those. `advisories` reads the RustSec database as it is when the check runs, so a new
# advisory can fail it with no change to the checkout; .github/workflows/advisories.yml runs it
# (docs/adr/advisories-off-the-pr-gate.md).

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

if ! in_project_environment; then
    run ./script/audit "$@"
    exit
fi

cargo deny check "$@"
