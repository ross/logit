#!/bin/bash
# Usage: script/audit [advisories|bans|licenses|sources ...]
# Supply-chain checks from deny.toml. With no arguments, runs all four. CI runs everything but
# advisories, because that check reads the live RustSec database and fails on a new advisory with
# no change in the tree.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

if ! in_project_environment; then
    run ./script/audit "$@"
    exit
fi

cargo deny check "$@"
