#!/bin/bash
# Usage: script/bootstrap
# Builds the dev container image every other script runs in, so the host needs no Rust or LuaJIT.
# Run it first; re-running is safe and a no-op when the image is current.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

build_image

if [ -z "${CI:-}" ]; then
    echo ""
    echo "Dev image built. Try ./script/test, or ./script/console for a shell."
    echo "Uses 'sudo docker' by default -- override with DOCKER=docker (docker group) or"
    echo "DOCKER=podman (rootless) if you'd rather not use sudo. See ADR containerized-development."
fi
