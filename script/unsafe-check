#!/bin/bash
# Usage: script/unsafe-check miri [cargo-miri-test args]
#        script/unsafe-check careful [cargo-careful-test args]
#        script/unsafe-check inject <strace-inject-spec> [-- <cargo test args>]
#        script/unsafe-check inject-all
#        script/unsafe-check all
#        script/unsafe-check fuzz <target> [-- <libfuzzer args>]
#        script/unsafe-check fuzz-all [seconds]
#        script/unsafe-check fuzz-tmin <target> <crash file>
#        script/unsafe-check fuzz-seed
#        script/unsafe-check fuzz-self-test
#        script/unsafe-check shell
#        script/unsafe-check --help
#
# Verifies, with nightly-only tools in a throwaway image, the three raw-`libc` `unsafe` call sites
# (udp.rs `recvmmsg`, sockstat.rs `getsockopt`, tail/watch.rs inotify), the safe-Rust accept loops
# (the `accept4` inject scenarios), and the decoders of untrusted bytes (the fuzz targets); see
# docs/adr/out-of-ci-unsafe-verification.md and docs/adr/out-of-ci-fuzzing.md. `miri` runs the
# pure helpers and the sketch and HyperLogLog codec tests, `careful` runs the real tests under a
# debug-assertion std, and `inject`/`inject-all` force errno paths with `strace -e inject=`.
# `all` runs `miri` then `careful`.
#
# The same image fuzzes the decoders that read a peer's or the disk spool's bytes (`fuzz/`,
# cargo-fuzz under ASan). `fuzz` runs one target from FUZZ_TARGETS for FUZZ_SECONDS, `fuzz-all`
# runs each for `seconds` (default 120), prints a summary, and exits 1 if any target failed,
# `fuzz-tmin` minimizes a crash, and `fuzz-seed` rewrites the committed seeds. The host may
# suspend: a run it slept through is rerun up to FUZZ_RETRY_SLEPT times, its `timeout-*` and
# `slow-unit-*` artifacts move to fuzz/artifacts/<target>/slept/, and a target whose every
# attempt slept reads `slept` and exits 3 (`fuzz-all`: 3 when no target failed). Fuzzing needs
# python3 on the host to read its suspend clock; `fuzz-self-test` checks that detection.
#
#   UNSAFE_CHECK_TARGET_VOLUME       target volume; give each concurrently running checkout its own
#   UNSAFE_CHECK_FUZZ_TARGET_VOLUME  the same, for the sanitizer builds `fuzz` makes
#   UNSAFE_CHECK_SECCOMP_UNCONFINED  1 adds seccomp=unconfined to `inject`, for a host whose
#                                    default seccomp profile blocks ptrace
#   MIRIFLAGS                        defaults to -Zmiri-disable-isolation
#   FUZZ_SECONDS                     `fuzz`'s -max_total_time, default 600
#   FUZZ_RETRY_SLEPT                 reruns of a run the host suspended during, default 1
#   UNSAFE_CHECK_FAKE_SUSPEND        N makes each target's first N attempts read as slept, to
#                                    test the retry path
#
# Not part of script/cibuild: needs nightly and ptrace (docs/adr/out-of-ci-unsafe-verification.md,
# docs/adr/out-of-ci-fuzzing.md).

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

IMAGE=logit-unsafe-check:local

# One "<package>|<libtest args>|<extra MIRIFLAGS>" per line; `miri` with no arguments runs each
# in order, with the extra flags appended to MIRIFLAGS. The libtest args are word-split, so an
# entry can add `--skip`. Miri can't execute the three syscalls, so each of their entries is a
# pure helper split out of the code around one (the ADR's "What each tool verifies, and its
# limits"). Add an entry when a new one lands.
#
#   parse_events            the `inotify_event` parser in tail/watch.rs
#   batch_reader_helpers    udp.rs's `mmsghdr`/`iovec`/`msg_name` construction, post-call harvest,
#                           and the source-address parser `peer:` reads `msg_name` with
#   reply_parsing           sockstat.rs's two `getsockopt` reply parsers, which take an
#                           already-filled buffer, including a `mem::zeroed::<libc::tcp_info>()`
#   hyperloglog, hll_       metric.rs's `HyperLogLog` codec; Stacked Borrows off, permissive provenance
#   sketch::tests           sketch.rs's `DdSketch`; deterministic floats
#
# Why those flags, and why `--skip properties`: the ADR's "Sketch and HyperLogLog targets" amendment.
MIRI_TARGETS=(
    "logit-inputs|parse_events|"
    "logit-inputs|batch_reader_helpers|"
    "logit-pipeline|sockstat::tests::reply_parsing|"
    "logit-core|hyperloglog --skip properties|-Zmiri-disable-stacked-borrows -Zmiri-permissive-provenance"
    "logit-core|hll_ --skip properties|-Zmiri-disable-stacked-borrows -Zmiri-permissive-provenance"
    "logit-core|sketch::tests --skip properties|-Zmiri-deterministic-floats"
)

# Every checkout binds at the same `/work`, so cargo fingerprints match across branches and two
# worktrees sharing one target volume can run each other's stale test binaries.
TARGET_VOLUME="${UNSAFE_CHECK_TARGET_VOLUME:-logit_unsafe_check_target}"

# One "<target>|<max_len>|<malloc_limit_mb>|<extra args>" per line, one per
# `fuzz/fuzz_targets/<target>.rs`; `fuzz-all` runs each in order. `malloc_limit_mb` fails a run on
# any single allocation past it, which is how a decoder sizing an allocation from a declared
# length shows up. Each sits above the largest allocation a valid input may make: `native_frame`'s
# 65 admits a 64 MiB lz4 frame, which allocates its `uncompressed_len`, and the `native_batch_*`
# targets' 64 admits `decode_batch_body`'s events `Vec` regrowing by doubling past its initial
# 4,096: a batch of one-byte empty events at `max_len` regrows to about 56 MiB. `proxy_header`'s
# `max_len` admits the largest PROXY v2 header, 16 plus 65,535 bytes, and one payload byte behind
# it. `forwarded`'s 4,096 is past any forwarding header a proxy writes, and `http_auth`'s past any
# `Authorization` header a client sends. `nginx_status`'s `max_len` is `nginx_stub_status_in`'s
# 64 KiB body cap; a page allocates one seven-event `Vec` and interns only fixed names, so 16 MiB
# is ample and it needs no fork mode. `apache_status`'s is `apache_status_in`'s 1 MiB body cap,
# and the same holds: a page is at most 31 events over fixed names. `stream_framing`'s `max_len`
# is its 4 selector bytes, the longest frame header (`65536 `, six bytes), and a frame of
# `MAX_FRAME_BYTES`, so an at-bound frame fits under every framing; its only growing allocation is
# the framer's buffer, never larger than the input, so 16 MiB is ample, and it needs no fork mode
# because the framer interns nothing. `statsd`'s `max_len` is `MAX_FRAME_BYTES`, the largest
# packet any transport hands the decoder, above UDP's 65,507-byte payload. Its worst input,
# `a:1:1:…|c`, is one 864-byte `Event` per two bytes, and a second line's append doubles `out` past
# the first line's exact fit: a measured 54 MiB `Vec`, which
# `crates/logit-proto/tests/robustness.rs`'s statsd section pins under 56. `syslog`'s worst
# input, `<0>` lines filling 64 KiB, is one 864-byte `Event` per four bytes, and the target's
# marker event takes `out` one past 16,384 events, so it doubles to a measured 27 MiB `Vec`, which
# the syslog section pins under 32. `graphite_plaintext`'s `max_len` is `statsd`'s; its worst
# input, `a 1 1` lines filling 64 KiB, is one `Event` per six bytes, a measured 13.5 MiB `Vec`,
# which the graphite section pins under 16. `graphite_pickle`'s is its mode byte and a 64 KiB
# payload, past which carbon's 1 MiB frame bound reaches no new reader state: its worst input,
# one memoized datapoint repeated by two-byte `BINGET`s, is a measured 27 MiB `Vec`, pinned under
# 32; protocol 0's densest repeat, the three-byte `g0\n`, makes fewer events, and its decoded
# strings' scratch is at most twice the payload. `collectd`'s is its two cut bytes and a 65,507-byte UDP payload; its worst input, one-byte
# notification messages six bytes apart, is a measured 13.5 MiB `Vec`, pinned under 16 in the
# collectd section. `influxdb_line`'s is its precision byte and a 64 KiB body; its worst input,
# `a f=1 N` lines with distinct timestamps so nothing merges, is a measured 5.2 MiB events `Vec`,
# pinned under 16 in the influxdb section. `prom_text`'s is its dialect byte and a body one byte short of 64 KiB; its
# worst input, distinct one- to three-character names on `aa 1` lines, is one family of one
# series per five or six bytes, and the target's model mapping makes one 864-byte `Event` of
# each: a measured 13.5 MiB `Vec`, pinned under 16 in the prometheus text section. The four
# `message_*` targets' `max_len` is a selector byte and a 64 KiB message, past the 65,507-byte
# datagram and `MAX_FRAME_BYTES` line most messages arrive in; each worst message grows one `Vec`
# by doubling, measured in the robustness suite's log-message section under 16: `message_json`'s
# `{"a":[0,0,…]}` at 1.25 MiB, `message_csv`'s 65,537 empty fields at 3 MiB, `message_logfmt`'s
# one-byte barewords at 1.5 MiB, and `message_kv`'s at 2 MiB. `message_csv` needs no fork mode
# because the split interns nothing. `kafka_batch`'s `max_len` is twice its 64 KiB decompression
# bound, so an uncompressed records section reaches the bound too. Its largest allocation is the
# LZ4 frame decoder's output buffer, which an LZ4 frame header declaring linked 4 MiB blocks
# sizes at twice that plus a 64 KiB window, whatever the payload holds; the records and headers
# `Vec`s sized from a section at the bound stay near 2 MiB. It needs no fork mode because the
# record decoder interns nothing. `msgpack_event`'s worst input, the smallest event map
# (`timestamp` alone, about 40 bytes) repeated, is under 2,048 864-byte `Event`s in one batch's
# `Vec`, under 2 MiB. `extra args` go to `fuzz` only, never to `fuzz-tmin`.
#
# `native_batch`, `native_hop_batch`, `statsd`, `syslog`, `graphite_plaintext`,
# `graphite_pickle`, `collectd`, `influxdb_line`, `prom_text`, `prom_remote_write`, `message_json`,
# `message_logfmt`, `message_kv`, and `msgpack_event` run in fork mode: the process-wide interner
# never evicts, so a long-lived fuzz process accumulates every dictionary string, metric name, tag
# key, SD-ID, PARAM-NAME, carbon path, InfluxDB metric name, Prometheus exemplar label name and
# family name, log-message key, and MessagePack event attribute key it
# decodes until the arena outgrows the malloc limit, and fork mode restarts the process. `-ignore_ooms=0` keeps an out-of-memory in a child fatal, as it
# is outside fork mode.
FUZZ_TARGETS=(
    "native_frame|262144|65|"
    "native_batch|65536|64|-fork=1 -ignore_ooms=0"
    "native_hop_batch|65536|64|-fork=1 -ignore_ooms=0"
    "native_control|4096|4|"
    "sketch_bytes|65536|16|"
    "sketch_merge|65536|64|"
    "hll_bytes|65536|16|"
    "otlp_proto|65536|64|"
    "otlp_json|65536|64|"
    "otlp_grpc|65536|16|"
    "prom_decompress|65536|16|"
    "prom_remote_write|65536|64|-fork=1 -ignore_ooms=0"
    "prom_text|65536|16|-fork=1 -ignore_ooms=0"
    "proxy_header|65552|16|"
    "forwarded|4096|16|"
    "cri|65536|16|"
    "nginx_status|65536|16|"
    "apache_status|1048576|16|"
    "http_auth|4096|16|"
    "stream_framing|65546|16|"
    "statsd|65536|56|-fork=1 -ignore_ooms=0"
    "syslog|65536|32|-fork=1 -ignore_ooms=0"
    "graphite_plaintext|65536|16|-fork=1 -ignore_ooms=0"
    "graphite_pickle|65537|32|-fork=1 -ignore_ooms=0"
    "collectd|65509|16|-fork=1 -ignore_ooms=0"
    "influxdb_line|65537|16|-fork=1 -ignore_ooms=0"
    "message_json|65537|16|-fork=1 -ignore_ooms=0"
    "message_csv|65537|16|"
    "message_logfmt|65537|16|-fork=1 -ignore_ooms=0"
    "message_kv|65537|16|-fork=1 -ignore_ooms=0"
    "kafka_batch|131072|16|"
    "msgpack_event|65536|16|-fork=1 -ignore_ooms=0"
)

# The sanitizer builds' RUSTFLAGS differ from miri's and careful's, so they get their own volume
# rather than invalidating the other one on every switch.
FUZZ_TARGET_VOLUME="${UNSAFE_CHECK_FUZZ_TARGET_VOLUME:-logit_fuzz_target}"

# One "<label>|<strace inject spec>|<cargo test args>" per line; `inject-all` runs each in order.
# Unlike MIRI_TARGETS, not all are expected to pass: three force a fatal error, and they succeed
# when the failure has the expected shape. Each scenario's results are recorded in the ADR that
# owns its code path: the `udp-*` ones in ADR `udp-intake-batching-and-socket-visibility`'s
# "kernel- and tokio-cited facts" amendment, the `*-accept-*` ones in ADR
# `out-of-ci-unsafe-verification`'s "accept-error inject scenarios" amendment.
INJECT_SCENARIOS=(
    # The EINTR retry arm in `BatchReader::read_batch`, which a signal can't reach on a
    # non-blocking socket. EXPECT: the test passes, every datagram delivered.
    "udp-eintr-retry|recvmmsg:error=EINTR:when=2+3|-p logit-inputs --lib a_two_hundred_datagram_burst_is_delivered_complete_and_in_order"
    # The same retry with `peer:` on, failing the first call so the retry is the one that reads
    # addresses. EXPECT: the test passes, and the strace shows the injected `recvmmsg`, then one
    # returning every datagram with `msg_namelen=128 => 16` on each.
    "udp-peer-eintr-retry|recvmmsg:error=EINTR:when=1|-p logit-inputs --lib peer_stamps_each_udp_senders_own_address_and_port"
    # A fatal errno after two batches. EXPECT: the test fails, and the strace shows one injected
    # `recvmmsg` and then the process exiting: no retry, spin, or hang. The test panics on its
    # closed fanout, so the error message isn't checked here;
    # `a_fatal_read_error_closes_the_queue_and_names_the_syscall_and_the_socket` pins it in CI.
    "udp-fatal-mid-stream|recvmmsg:error=EPERM:when=3|-p logit-inputs --lib a_two_hundred_datagram_burst_is_delivered_complete_and_in_order"
    # A seccomp refusal on the first call (quinn#1947, bun#42678). EXPECT: the test fails, and the
    # strace shows one `recvmmsg` and nothing after it, not a refused call retried at 100% CPU.
    "udp-seccomp-first-call|recvmmsg:error=ENOSYS:when=1|-p logit-inputs --lib a_two_hundred_datagram_burst_is_delivered_complete_and_in_order"
    # fd exhaustion on the stream driver's first accept. EXPECT: the test passes, and the strace
    # shows the injected `accept4`, one 100 ms backoff, and a second `accept4` that succeeds.
    "tcp-accept-emfile|accept4:error=EMFILE:when=1|-p logit-inputs --lib a_plaintext_connection_round_trips_a_decoded_frame"
    # The same on `logit_in`'s accept loop. EXPECT: the test passes.
    "logit-accept-emfile|accept4:error=EMFILE:when=1|-p logit-inputs --lib a_v2_clients_provenance_is_relayed_untouched"
    # A seccomp or LSM refusal, which leaves the connection queued. EXPECT: the test passes, and
    # the strace shows the injected `accept4` and, after one 100 ms backoff, a second that succeeds.
    "tcp-accept-eperm|accept4:error=EPERM:when=1|-p logit-inputs --lib a_plaintext_connection_round_trips_a_decoded_frame"
    # A fatal errno on the listening socket. EXPECT: the test fails fast on its closed fanout, and
    # the strace shows one injected `accept4` and no second: the listener ends, it does not spin.
    "tcp-accept-ebadf|accept4:error=EBADF:when=1|-p logit-inputs --lib a_plaintext_connection_round_trips_a_decoded_frame"
)

build_image() {
    ${DOCKER} build -q -t "${IMAGE}" -f tools/unsafe-check/Dockerfile tools/unsafe-check >/dev/null
}

# A plain `docker run`, not a compose service, which could cross-mount another checkout. Its own
# volumes, never the dev container's `logit_cargo_home`/`logit_target_cache`: nightly artifacts
# must not mix into the stable toolchain's cache. The first argument is the target volume.
run_in_image() {
    local target_volume="${1}"
    shift
    ${DOCKER} run --rm \
        -u 1000:1000 -w /work \
        -v "${ROOT}:/work:z" \
        -v logit_unsafe_check_cargo_home:/home/dev/.cargo \
        -v "${target_volume}:/work/target" \
        -e CARGO_HOME=/home/dev/.cargo \
        -e CARGO_TARGET_DIR=/work/target \
        -e MIRIFLAGS="${MIRIFLAGS:--Zmiri-disable-isolation}" \
        "${IMAGE}" "$@"
}

# strace needs ptrace, and Docker's default capability set drops CAP_SYS_PTRACE. An older
# Docker/libseccomp/kernel also blocks ptrace in the default seccomp profile; set
# UNSAFE_CHECK_SECCOMP_UNCONFINED=1 there (moby#21051).
run_privileged_in_image() {
    local seccomp_arg=()
    if [ "${UNSAFE_CHECK_SECCOMP_UNCONFINED:-0}" = "1" ]; then
        seccomp_arg=(--security-opt seccomp=unconfined)
    fi
    ${DOCKER} run --rm \
        --cap-add SYS_PTRACE \
        "${seccomp_arg[@]}" \
        -u 1000:1000 -w /work \
        -v "${ROOT}:/work:z" \
        -v logit_unsafe_check_cargo_home:/home/dev/.cargo \
        -v "${TARGET_VOLUME}:/work/target" \
        -e CARGO_HOME=/home/dev/.cargo \
        -e CARGO_TARGET_DIR=/work/target \
        "${IMAGE}" "$@"
}

cmd_miri() {
    build_image
    if [ "$#" -gt 0 ]; then
        run_in_image "${TARGET_VOLUME}" cargo miri test "$@"
        return
    fi
    local base_flags="${MIRIFLAGS:--Zmiri-disable-isolation}"
    for target in "${MIRI_TARGETS[@]}"; do
        local package="${target%%|*}"
        local rest="${target#*|}"
        local filter="${rest%%|*}"
        local flags="${rest#*|}"
        echo "## miri: -p ${package} -- ${filter} (MIRIFLAGS: ${base_flags} ${flags}) ##########"
        # shellcheck disable=SC2086 # `filter` is a word-split libtest argument list
        MIRIFLAGS="${base_flags} ${flags}" run_in_image "${TARGET_VOLUME}" cargo miri test -p "${package}" --lib -- ${filter}
    done
}

cmd_careful() {
    build_image
    if [ "$#" -gt 0 ]; then
        run_in_image "${TARGET_VOLUME}" cargo careful test "$@"
        return
    fi
    run_in_image "${TARGET_VOLUME}" cargo careful test -p logit-pipeline -p logit-inputs
}

# Builds one test binary, then runs it under strace with the fault injected. `<cargo test args>`
# selects and filters one binary (for example `-p logit-inputs --lib a_two_hundred_datagram_burst`).
# All of it goes to `cargo test --no-run`, and the last bare token, the filter, also goes to the
# binary.
cmd_inject() {
    local spec="${1:-}"
    if [ -z "${spec}" ]; then
        echo "usage: script/unsafe-check inject <strace-inject-spec> [-- <cargo test args>]" >&2
        exit 1
    fi
    shift
    if [ "${1:-}" = "--" ]; then
        shift
    fi
    local syscall="${spec%%:*}"

    local cargo_args=("$@")
    local filter=""
    local i=0
    while [ "${i}" -lt "${#cargo_args[@]}" ]; do
        local a="${cargo_args[${i}]}"
        case "${a}" in
        -p | --package | --bin | --test)
            i=$((i + 2))
            continue
            ;;
        -*)
            i=$((i + 1))
            continue
            ;;
        *)
            filter="${a}"
            i=$((i + 1))
            continue
            ;;
        esac
    done

    build_image
    echo "## inject: tracing ${syscall}, injecting ${spec} #####################"
    # `cargo test --no-run` prints one "Executable ... (path)" line per test binary, with a path
    # relative to /work. `tail -1` assumes one target (`--lib`, `--bin <name>`, or
    # `--test <name>`); selecting more than one isn't supported.
    local build_output
    build_output="$(run_in_image "${TARGET_VOLUME}" cargo test --no-run "${cargo_args[@]}" 2>&1)"
    local binary
    binary="$(printf '%s\n' "${build_output}" |
        grep -E '^\s*Executable ' | tail -1 | sed -E 's/.*\(([^()]+)\)[[:space:]]*$/\1/')"
    if [ -z "${binary}" ]; then
        echo "error: could not find a compiled test binary in cargo's build output:" >&2
        printf '%s\n' "${build_output}" >&2
        exit 1
    fi
    run_privileged_in_image strace -f -e "trace=${syscall}" -e "inject=${spec}" -- \
        "${binary}" ${filter:+"${filter}"} --test-threads=1
}

# Runs past a non-zero exit, which `set -e` would otherwise stop at: three scenarios are expected to
# fail, and the operator reads the shape of each failure off the output.
cmd_inject_all() {
    build_image
    for scenario in "${INJECT_SCENARIOS[@]}"; do
        local label="${scenario%%|*}"
        local rest="${scenario#*|}"
        local spec="${rest%%|*}"
        local args="${rest#*|}"
        echo
        echo "===== inject scenario: ${label} ====================================="
        # shellcheck disable=SC2086 # `args` is a deliberate word-split argument list
        cmd_inject "${spec}" -- ${args} || echo "## ${label}: exited non-zero (read the output \
above: for a fatal-errno scenario that is the expected shape, not a regression)"
    done
}

cmd_all() {
    cmd_miri
    cmd_careful
}

fuzz_target_entry() {
    local wanted="${1}"
    for entry in "${FUZZ_TARGETS[@]}"; do
        if [ "${entry%%|*}" = "${wanted}" ]; then
            echo "${entry}"
            return
        fi
    done
    return 1
}

# Prints the libFuzzer limits FUZZ_TARGETS gives `target`, or exits with the target list.
fuzz_limits() {
    local target="${1}"
    local usage="${2}"
    local entry
    if [ -z "${target}" ] || ! entry="$(fuzz_target_entry "${target}")"; then
        echo "usage: ${usage}" >&2
        echo "targets: $(printf '%s ' "${FUZZ_TARGETS[@]%%|*}")" >&2
        exit 1
    fi
    local rest="${entry#*|}"
    local max_len="${rest%%|*}"
    rest="${rest#*|}"
    echo "-max_len=${max_len} -malloc_limit_mb=${rest%%|*} -rss_limit_mb=4096 -timeout=10"
}

# Prints the extra libFuzzer arguments FUZZ_TARGETS gives `target`, often none.
fuzz_extra_args() {
    local entry
    entry="$(fuzz_target_entry "${1}")"
    echo "${entry##*|}"
}

# Prints the whole seconds this host has spent suspended since boot: CLOCK_BOOTTIME counts a
# suspend and CLOCK_MONOTONIC doesn't. libFuzzer times `-timeout` and `-max_total_time` on
# `system_clock`, which a suspend advances, so a run that spans one ends early and can report a
# timeout no input caused (docs/adr/out-of-ci-fuzzing.md, "Amendment (2026-10-18)").
suspended_seconds() {
    python3 -c 'import time; print(int(time.clock_gettime(time.CLOCK_BOOTTIME) - time.clock_gettime(time.CLOCK_MONOTONIC)))'
}

# Below the 10 s `-timeout` fuzz_limits sets, so every suspend long enough to fake a timeout
# counts.
FUZZ_SLEPT_THRESHOLD=5

# Succeeds when two suspended_seconds readings, `before` then `after`, show a suspend between them.
slept_between() {
    [ $(("${2}" - "${1}")) -ge "${FUZZ_SLEPT_THRESHOLD}" ]
}

# libFuzzer writes new inputs only to the first corpus directory, so fuzz/corpus/<target> grows
# and fuzz/seeds/<target> stays as committed. Caller arguments come last, so they win.
fuzz_once() {
    local target="${1}"
    local limits="${2}"
    shift 2
    mkdir -p "${ROOT}/fuzz/corpus/${target}"
    local extra
    extra="$(fuzz_extra_args "${target}")"
    # shellcheck disable=SC2086 # `limits` and `extra` are word-split argument lists
    run_in_image "${FUZZ_TARGET_VOLUME}" cargo fuzz run "${target}" \
        "fuzz/corpus/${target}" "fuzz/seeds/${target}" -- \
        ${limits} ${extra} -max_total_time="${FUZZ_SECONDS:-600}" "$@"
}

# Runs one target, and reruns it up to FUZZ_RETRY_SLEPT times while the host suspends during a
# run. A slept run's new `timeout-*` and `slow-unit-*` artifacts move to
# fuzz/artifacts/<target>/slept/, because libFuzzer counted the suspend against the input in
# flight. A slept run that failed and left any other new artifact (`crash-*`, `oom-*`, `leak-*`)
# returns its own status: none of those depends on time, so the finding stands. Returns 3 when
# the last attempt slept too.
cmd_fuzz() {
    local target="${1:-}"
    local limits
    limits="$(fuzz_limits "${target}" "script/unsafe-check fuzz <target> [-- <libfuzzer args>]")"
    shift
    if [ "${1:-}" = "--" ]; then
        shift
    fi
    if ! command -v python3 >/dev/null; then
        echo "error: fuzzing needs python3 on the host, to tell a suspend from a slow input" >&2
        exit 1
    fi

    build_image
    local artifacts="${ROOT}/fuzz/artifacts/${target}"
    local retries="${FUZZ_RETRY_SLEPT:-1}"
    local attempt=0
    local marker
    marker="$(mktemp)"
    while true; do
        touch "${marker}"
        local before after status=0
        before="$(suspended_seconds)"
        fuzz_once "${target}" "${limits}" "$@" || status=$?
        after="$(suspended_seconds)"
        # A test seam: the first UNSAFE_CHECK_FAKE_SUSPEND attempts read as slept.
        if [ "${attempt}" -lt "${UNSAFE_CHECK_FAKE_SUSPEND:-0}" ]; then
            after=$((after + FUZZ_SLEPT_THRESHOLD))
        fi
        if ! slept_between "${before}" "${after}"; then
            rm -f "${marker}"
            return "${status}"
        fi
        echo "## fuzz: ${target}: the host was suspended for about $((after - before))s of this run" >&2
        local timing=() other=()
        if [ -d "${artifacts}" ]; then
            mapfile -t timing < <(find "${artifacts}" -maxdepth 1 -type f -newer "${marker}" \
                \( -name 'timeout-*' -o -name 'slow-unit-*' \))
            mapfile -t other < <(find "${artifacts}" -maxdepth 1 -type f -newer "${marker}" \
                ! -name 'timeout-*' ! -name 'slow-unit-*')
        fi
        if [ "${#timing[@]}" -gt 0 ]; then
            mkdir -p "${artifacts}/slept"
            mv -- "${timing[@]}" "${artifacts}/slept/"
            echo "## fuzz: ${target}: moved ${#timing[@]} timing artifact(s) to fuzz/artifacts/${target}/slept/" >&2
        fi
        if [ "${status}" -ne 0 ] && [ "${#other[@]}" -gt 0 ]; then
            rm -f "${marker}"
            return "${status}"
        fi
        if [ "${attempt}" -ge "${retries}" ]; then
            echo "## fuzz: ${target}: slept: the host suspended during every attempt; rerun it" >&2
            rm -f "${marker}"
            return 3
        fi
        attempt=$((attempt + 1))
        echo "## fuzz: ${target}: rerunning, attempt $((attempt + 1)) of $((retries + 1))" >&2
    done
}

# Prints the last failure artifact `log` names that still exists under `base`, or nothing. The
# pattern matches only a file directly in a target's artifacts directory, so neither the
# `slept/` path cmd_fuzz prints nor `-artifact_prefix` matches, and the existence check skips a
# timeout cmd_fuzz moved out of a slept run.
fuzz_artifact_from_log() {
    local log="${1}"
    local base="${2}"
    local path
    while read -r path; do
        if [ -f "${base}/${path}" ]; then
            echo "${path}"
            return
        fi
    done < <(grep -oE 'fuzz/artifacts/[^ /]+/(crash|oom|leak|timeout)-[^ ]+' "${log}" | tac)
}

# Checks slept_between against simulated readings, fuzz_artifact_from_log against simulated
# logs, and that this host gives a suspend reading.
cmd_fuzz_self_test() {
    local fails=0
    check() {
        local want="${1}" before="${2}" after="${3}" got=awake
        if slept_between "${before}" "${after}"; then
            got=slept
        fi
        if [ "${got}" = "${want}" ]; then
            echo "ok   ${before} -> ${after}: ${got}"
        else
            echo "FAIL ${before} -> ${after}: ${got}, want ${want}"
            fails=1
        fi
    }
    check awake 0 0
    check awake 120 124
    check slept 120 125
    check slept 0 10123

    # A slept run's log as fuzz-all tees it: libFuzzer's line for each artifact, then cmd_fuzz's.
    local base
    base="$(mktemp -d)"
    local dir="${base}/fuzz/artifacts/t"
    mkdir -p "${dir}/slept"
    touch "${dir}/oom-aa" "${dir}/slept/timeout-bb"
    pick() {
        local want="${1}" name="${2}" got
        got="$(fuzz_artifact_from_log "${base}/${name}.log" "${base}")"
        if [ "${got}" = "${want}" ]; then
            echo "ok   artifact for ${name}: '${got}'"
        else
            echo "FAIL artifact for ${name}: '${got}', want '${want}'"
            fails=1
        fi
    }
    cat >"${base}/crash-then-slept.log" <<'EOF'
artifact_prefix='/work/fuzz/artifacts/t/'; Test unit written to /work/fuzz/artifacts/t/oom-aa
## fuzz: t: the host was suspended for about 9s of this run
## fuzz: t: moved 1 timing artifact(s) to fuzz/artifacts/t/slept/
EOF
    pick fuzz/artifacts/t/oom-aa crash-then-slept
    cat >"${base}/moved-then-failed.log" <<'EOF'
artifact_prefix='/work/fuzz/artifacts/t/'; Test unit written to /work/fuzz/artifacts/t/timeout-bb
## fuzz: t: the host was suspended for about 9s of this run
## fuzz: t: moved 1 timing artifact(s) to fuzz/artifacts/t/slept/
## fuzz: t: rerunning, attempt 2 of 2
Error: Fuzz target exited with exit status: 1
EOF
    pick "" moved-then-failed
    rm -rf "${base}"

    local now
    now="$(suspended_seconds)"
    if [[ "${now}" =~ ^[0-9]+$ ]]; then
        echo "ok   this host has been suspended for ${now}s since boot"
    else
        echo "FAIL suspended_seconds printed '${now}'"
        fails=1
    fi
    return "${fails}"
}

# An `oom-*` file gets the target's limits, since without `-malloc_limit_mb` an allocation-limit
# crash doesn't reproduce. Any other crash gets none: under the malloc limit, a mutated candidate
# that trips it counts as the crash and libFuzzer "minimizes" to an empty file that doesn't
# reproduce. cargo-fuzz writes the result beside the crash file as `minimized-from-<hash>`.
cmd_fuzz_tmin() {
    local target="${1:-}"
    local crash="${2:-}"
    local limits
    limits="$(fuzz_limits "${target}" "script/unsafe-check fuzz-tmin <target> <crash file>")"
    if [ -z "${crash}" ]; then
        echo "usage: script/unsafe-check fuzz-tmin <target> <crash file>" >&2
        exit 1
    fi
    case "$(basename -- "${crash}")" in
    oom-*) ;;
    *) limits="" ;;
    esac
    build_image
    # shellcheck disable=SC2086 # `limits` is a word-split argument list
    run_in_image "${FUZZ_TARGET_VOLUME}" cargo fuzz tmin "${target}" "${crash}" \
        ${limits:+-- ${limits}}
}

# Runs every target past a failure, which `set -e` would otherwise stop at. Each run's output
# lands in perf/results/fuzz/<timestamp>/<target>.log, and the summary quotes libFuzzer's last
# stats line per target.
cmd_fuzz_all() {
    local seconds="${1:-120}"
    local out_dir
    out_dir="perf/results/fuzz/$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "${ROOT}/${out_dir}"
    local summary=()
    local failed=0
    local slept=0
    for entry in "${FUZZ_TARGETS[@]}"; do
        local target="${entry%%|*}"
        local log="${ROOT}/${out_dir}/${target}.log"
        echo
        echo "===== fuzz: ${target} for ${seconds}s ====================================="
        local status=0
        cmd_fuzz "${target}" -- -max_total_time="${seconds}" 2>&1 | tee "${log}" || status=$?
        local stats
        stats="$(grep -E '^#[0-9]+' "${log}" | tail -1 || true)"
        if [ "${status}" -eq 0 ]; then
            summary+=("ok     ${target}: ${stats}")
        elif [ "${status}" -eq 3 ]; then
            slept=1
            summary+=("slept  ${target}: the host suspended during every attempt; rerun it")
        else
            local artifact
            artifact="$(fuzz_artifact_from_log "${log}" "${ROOT}")"
            failed=1
            summary+=("FAILED ${target} (exit ${status}): ${stats}")
            if [ -n "${artifact}" ]; then
                summary+=("       minimize: script/unsafe-check fuzz-tmin ${target} ${artifact}")
            fi
        fi
    done
    echo
    echo "===== fuzz-all summary: ${seconds}s per target, logs in ${out_dir} ====="
    printf '%s\n' "${summary[@]}"
    if [ "${failed}" -ne 0 ]; then
        return 1
    fi
    if [ "${slept}" -ne 0 ]; then
        return 3
    fi
    return 0
}

# A plain binary with no sanitizer, so it needs nothing the stable dev image lacks either.
cmd_fuzz_seed() {
    build_image
    run_in_image "${FUZZ_TARGET_VOLUME}" \
        cargo run --manifest-path fuzz/seedgen/Cargo.toml --release
}

cmd_shell() {
    build_image
    run_in_image "${TARGET_VOLUME}" bash
}

usage() {
    cat <<'EOF'
Usage: script/unsafe-check miri [cargo-miri-test args]
       script/unsafe-check careful [cargo-careful-test args]
       script/unsafe-check inject <strace-inject-spec> [-- <cargo test args>]
       script/unsafe-check inject-all
       script/unsafe-check all
       script/unsafe-check fuzz <target> [-- <libfuzzer args>]
       script/unsafe-check fuzz-all [seconds]
       script/unsafe-check fuzz-tmin <target> <crash file>
       script/unsafe-check fuzz-seed
       script/unsafe-check fuzz-self-test
       script/unsafe-check shell
       script/unsafe-check --help

Verifies, with nightly-only tools in a throwaway image, the three raw-`libc` `unsafe` call sites
(udp.rs `recvmmsg`, sockstat.rs `getsockopt`, tail/watch.rs inotify), the safe-Rust accept loops
(the `accept4` inject scenarios), and the decoders of untrusted bytes (the fuzz targets); see
docs/adr/out-of-ci-unsafe-verification.md and docs/adr/out-of-ci-fuzzing.md. `miri` runs the
pure helpers and the sketch and HyperLogLog codec tests, `careful` runs the real tests under a
debug-assertion std, and `inject`/`inject-all` force errno paths with `strace -e inject=`.
`all` runs `miri` then `careful`.

The same image fuzzes the decoders that read a peer's or the disk spool's bytes (`fuzz/`,
cargo-fuzz under ASan). `fuzz` runs one target from FUZZ_TARGETS for FUZZ_SECONDS, `fuzz-all`
runs each for `seconds` (default 120), prints a summary, and exits 1 if any target failed,
`fuzz-tmin` minimizes a crash, and `fuzz-seed` rewrites the committed seeds. The host may
suspend: a run it slept through is rerun up to FUZZ_RETRY_SLEPT times, its `timeout-*` and
`slow-unit-*` artifacts move to fuzz/artifacts/<target>/slept/, and a target whose every
attempt slept reads `slept` and exits 3 (`fuzz-all`: 3 when no target failed). Fuzzing needs
python3 on the host to read its suspend clock; `fuzz-self-test` checks that detection.

  UNSAFE_CHECK_TARGET_VOLUME       target volume; give each concurrently running checkout its own
  UNSAFE_CHECK_FUZZ_TARGET_VOLUME  the same, for the sanitizer builds `fuzz` makes
  UNSAFE_CHECK_SECCOMP_UNCONFINED  1 adds seccomp=unconfined to `inject`, for a host whose
                                   default seccomp profile blocks ptrace
  MIRIFLAGS                        defaults to -Zmiri-disable-isolation
  FUZZ_SECONDS                     `fuzz`'s -max_total_time, default 600
  FUZZ_RETRY_SLEPT                 reruns of a run the host suspended during, default 1
  UNSAFE_CHECK_FAKE_SUSPEND        N makes each target's first N attempts read as slept, to
                                   test the retry path

Not part of script/cibuild: needs nightly and ptrace (docs/adr/out-of-ci-unsafe-verification.md,
docs/adr/out-of-ci-fuzzing.md).
EOF
}

case "${1:-}" in
miri)
    shift
    cmd_miri "$@"
    ;;
careful)
    shift
    cmd_careful "$@"
    ;;
inject)
    shift
    cmd_inject "$@"
    ;;
inject-all)
    cmd_inject_all
    ;;
all)
    cmd_all
    ;;
fuzz)
    shift
    cmd_fuzz "$@"
    ;;
fuzz-all)
    shift
    cmd_fuzz_all "$@"
    ;;
fuzz-tmin)
    shift
    cmd_fuzz_tmin "$@"
    ;;
fuzz-seed)
    cmd_fuzz_seed
    ;;
fuzz-self-test)
    cmd_fuzz_self_test
    ;;
shell)
    cmd_shell
    ;;
-h | --help | "")
    usage
    ;;
*)
    echo "unknown subcommand: ${1}" >&2
    usage >&2
    exit 1
    ;;
esac
