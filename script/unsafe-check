#!/bin/bash
# Usage: script/unsafe-check miri [cargo-miri-test args]
#        script/unsafe-check careful [cargo-careful-test args]
#        script/unsafe-check inject <strace-inject-spec> [-- <cargo test args>]
#        script/unsafe-check inject-all
#        script/unsafe-check all
#        script/unsafe-check shell
#        script/unsafe-check --help
#
# Checks the three raw-`libc` `unsafe` call sites (udp.rs `recvmmsg`, sockstat.rs `getsockopt`,
# tail/watch.rs inotify) with nightly-only tools in a throwaway image. `miri` runs the pure
# helpers and the sketch and HyperLogLog codec tests, `careful` runs the real tests under a
# debug-assertion std, and `inject`/`inject-all` force errno paths with `strace -e inject=`.
# `all` runs `miri` then `careful`.
#
#   UNSAFE_CHECK_TARGET_VOLUME       target volume; give each concurrently running checkout its own
#   UNSAFE_CHECK_SECCOMP_UNCONFINED  1 adds seccomp=unconfined to `inject`, for a host whose
#                                    default seccomp profile blocks ptrace
#   MIRIFLAGS                        defaults to -Zmiri-disable-isolation
#
# Not part of script/cibuild: needs nightly and ptrace (docs/adr/out-of-ci-unsafe-verification.md).

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

IMAGE=logit-unsafe-check:local

# One "<package>|<libtest args>|<extra MIRIFLAGS>" per line; `miri` with no arguments runs each
# in order, with the extra flags appended to MIRIFLAGS. The libtest args are word-split, so an
# entry can add `--skip`. Miri can't execute the three syscalls, so each of their entries is a
# pure helper split out of the code around one (the ADR's "What each tool verifies, and its
# limits"). Add an entry when a new one lands.
#
#   parse_events            the `inotify_event` parser in tail/watch.rs
#   batch_reader_helpers    udp.rs's `mmsghdr`/`iovec` construction and post-call harvest
#   reply_parsing           sockstat.rs's two `getsockopt` reply parsers, which take an
#                           already-filled buffer, including a `mem::zeroed::<libc::tcp_info>()`
#   hyperloglog, hll_       metric.rs's `HyperLogLog` codec; Stacked Borrows off, permissive provenance
#   sketch::tests           sketch.rs's `DdSketch`; deterministic floats
#
# Why those flags, and why `--skip properties`: the ADR's "Sketch and HyperLogLog targets" amendment.
MIRI_TARGETS=(
    "logit-inputs|parse_events|"
    "logit-inputs|batch_reader_helpers|"
    "logit-pipeline|sockstat::tests::reply_parsing|"
    "logit-core|hyperloglog --skip properties|-Zmiri-disable-stacked-borrows -Zmiri-permissive-provenance"
    "logit-core|hll_ --skip properties|-Zmiri-disable-stacked-borrows -Zmiri-permissive-provenance"
    "logit-core|sketch::tests --skip properties|-Zmiri-deterministic-floats"
)

# Every checkout binds at the same `/work`, so cargo fingerprints match across branches and two
# worktrees sharing one target volume can run each other's stale test binaries.
TARGET_VOLUME="${UNSAFE_CHECK_TARGET_VOLUME:-logit_unsafe_check_target}"

# One "<label>|<strace inject spec>|<cargo test args>" per line; `inject-all` runs each in order.
# Unlike MIRI_TARGETS, not all are expected to pass: two force a fatal error, and they succeed
# when the failure has the expected shape. ADR `udp-intake-batching-and-socket-visibility`'s
# amendment records the results.
INJECT_SCENARIOS=(
    # The EINTR retry arm in `BatchReader::read_batch`, which a signal can't reach on a
    # non-blocking socket. EXPECT: the test passes, every datagram delivered.
    "udp-eintr-retry|recvmmsg:error=EINTR:when=2+3|-p logit-inputs --lib a_two_hundred_datagram_burst_is_delivered_complete_and_in_order"
    # A fatal errno after two batches. EXPECT: the test fails, and the strace shows one injected
    # `recvmmsg` and then the process exiting: no retry, spin, or hang. The test panics on its
    # closed fanout, so the error message isn't checked here;
    # `a_fatal_read_error_closes_the_queue_and_names_the_syscall_and_the_socket` pins it in CI.
    "udp-fatal-mid-stream|recvmmsg:error=EPERM:when=3|-p logit-inputs --lib a_two_hundred_datagram_burst_is_delivered_complete_and_in_order"
    # A seccomp refusal on the first call (quinn#1947, bun#42678). EXPECT: the test fails, and the
    # strace shows one `recvmmsg` and nothing after it, not a refused call retried at 100% CPU.
    "udp-seccomp-first-call|recvmmsg:error=ENOSYS:when=1|-p logit-inputs --lib a_two_hundred_datagram_burst_is_delivered_complete_and_in_order"
)

build_image() {
    ${DOCKER} build -q -t "${IMAGE}" -f tools/unsafe-check/Dockerfile tools/unsafe-check >/dev/null
}

# A plain `docker run`, not a compose service, which could cross-mount another checkout. Its own
# volumes, never the dev container's `logit_cargo_home`/`logit_target_cache`: nightly artifacts
# must not mix into the stable toolchain's cache.
run_in_image() {
    ${DOCKER} run --rm \
        -u 1000:1000 -w /work \
        -v "${ROOT}:/work:z" \
        -v logit_unsafe_check_cargo_home:/home/dev/.cargo \
        -v "${TARGET_VOLUME}:/work/target" \
        -e CARGO_HOME=/home/dev/.cargo \
        -e CARGO_TARGET_DIR=/work/target \
        -e MIRIFLAGS="${MIRIFLAGS:--Zmiri-disable-isolation}" \
        "${IMAGE}" "$@"
}

# strace needs ptrace, and Docker's default capability set drops CAP_SYS_PTRACE. An older
# Docker/libseccomp/kernel also blocks ptrace in the default seccomp profile; set
# UNSAFE_CHECK_SECCOMP_UNCONFINED=1 there (moby#21051).
run_privileged_in_image() {
    local seccomp_arg=()
    if [ "${UNSAFE_CHECK_SECCOMP_UNCONFINED:-0}" = "1" ]; then
        seccomp_arg=(--security-opt seccomp=unconfined)
    fi
    ${DOCKER} run --rm \
        --cap-add SYS_PTRACE \
        "${seccomp_arg[@]}" \
        -u 1000:1000 -w /work \
        -v "${ROOT}:/work:z" \
        -v logit_unsafe_check_cargo_home:/home/dev/.cargo \
        -v "${TARGET_VOLUME}:/work/target" \
        -e CARGO_HOME=/home/dev/.cargo \
        -e CARGO_TARGET_DIR=/work/target \
        "${IMAGE}" "$@"
}

cmd_miri() {
    build_image
    if [ "$#" -gt 0 ]; then
        run_in_image cargo miri test "$@"
        return
    fi
    local base_flags="${MIRIFLAGS:--Zmiri-disable-isolation}"
    for target in "${MIRI_TARGETS[@]}"; do
        local package="${target%%|*}"
        local rest="${target#*|}"
        local filter="${rest%%|*}"
        local flags="${rest#*|}"
        echo "## miri: -p ${package} -- ${filter} (MIRIFLAGS: ${base_flags} ${flags}) ##########"
        # shellcheck disable=SC2086 # `filter` is a word-split libtest argument list
        MIRIFLAGS="${base_flags} ${flags}" run_in_image cargo miri test -p "${package}" --lib -- ${filter}
    done
}

cmd_careful() {
    build_image
    if [ "$#" -gt 0 ]; then
        run_in_image cargo careful test "$@"
        return
    fi
    run_in_image cargo careful test -p logit-pipeline -p logit-inputs
}

# Builds one test binary, then runs it under strace with the fault injected. `<cargo test args>`
# selects and filters one binary (for example `-p logit-inputs --lib a_two_hundred_datagram_burst`).
# All of it goes to `cargo test --no-run`, and the last bare token, the filter, also goes to the
# binary.
cmd_inject() {
    local spec="${1:-}"
    if [ -z "${spec}" ]; then
        echo "usage: script/unsafe-check inject <strace-inject-spec> [-- <cargo test args>]" >&2
        exit 1
    fi
    shift
    if [ "${1:-}" = "--" ]; then
        shift
    fi
    local syscall="${spec%%:*}"

    local cargo_args=("$@")
    local filter=""
    local i=0
    while [ "${i}" -lt "${#cargo_args[@]}" ]; do
        local a="${cargo_args[${i}]}"
        case "${a}" in
        -p | --package | --bin | --test)
            i=$((i + 2))
            continue
            ;;
        -*)
            i=$((i + 1))
            continue
            ;;
        *)
            filter="${a}"
            i=$((i + 1))
            continue
            ;;
        esac
    done

    build_image
    echo "## inject: tracing ${syscall}, injecting ${spec} #####################"
    # `cargo test --no-run` prints one "Executable ... (path)" line per test binary, with a path
    # relative to /work. `tail -1` assumes one target (`--lib`, `--bin <name>`, or
    # `--test <name>`); selecting more than one isn't supported.
    local build_output
    build_output="$(run_in_image cargo test --no-run "${cargo_args[@]}" 2>&1)"
    local binary
    binary="$(printf '%s\n' "${build_output}" |
        grep -E '^\s*Executable ' | tail -1 | sed -E 's/.*\(([^()]+)\)[[:space:]]*$/\1/')"
    if [ -z "${binary}" ]; then
        echo "error: could not find a compiled test binary in cargo's build output:" >&2
        printf '%s\n' "${build_output}" >&2
        exit 1
    fi
    run_privileged_in_image strace -f -e "trace=${syscall}" -e "inject=${spec}" -- \
        "${binary}" ${filter:+"${filter}"} --test-threads=1
}

# Runs past a non-zero exit, which `set -e` would otherwise stop at: two scenarios are expected to
# fail, and the operator reads the shape of each failure off the output.
cmd_inject_all() {
    build_image
    for scenario in "${INJECT_SCENARIOS[@]}"; do
        local label="${scenario%%|*}"
        local rest="${scenario#*|}"
        local spec="${rest%%|*}"
        local args="${rest#*|}"
        echo
        echo "===== inject scenario: ${label} ====================================="
        # shellcheck disable=SC2086 # `args` is a deliberate word-split argument list
        cmd_inject "${spec}" -- ${args} || echo "## ${label}: exited non-zero (read the output \
above: for a fatal-errno scenario that is the expected shape, not a regression)"
    done
}

cmd_all() {
    cmd_miri
    cmd_careful
}

cmd_shell() {
    build_image
    run_in_image bash
}

usage() {
    cat <<'EOF'
Usage: script/unsafe-check miri [cargo-miri-test args]
       script/unsafe-check careful [cargo-careful-test args]
       script/unsafe-check inject <strace-inject-spec> [-- <cargo test args>]
       script/unsafe-check inject-all
       script/unsafe-check all
       script/unsafe-check shell
       script/unsafe-check --help

Checks the three raw-`libc` `unsafe` call sites (udp.rs `recvmmsg`, sockstat.rs `getsockopt`,
tail/watch.rs inotify) with nightly-only tools in a throwaway image. `miri` runs the pure
helpers and the sketch and HyperLogLog codec tests, `careful` runs the real tests under a
debug-assertion std, and `inject`/`inject-all` force errno paths with `strace -e inject=`.
`all` runs `miri` then `careful`.

  UNSAFE_CHECK_TARGET_VOLUME       target volume; give each concurrently running checkout its own
  UNSAFE_CHECK_SECCOMP_UNCONFINED  1 adds seccomp=unconfined to `inject`, for a host whose
                                   default seccomp profile blocks ptrace
  MIRIFLAGS                        defaults to -Zmiri-disable-isolation

Not part of script/cibuild: needs nightly and ptrace (docs/adr/out-of-ci-unsafe-verification.md).
EOF
}

case "${1:-}" in
miri)
    shift
    cmd_miri "$@"
    ;;
careful)
    shift
    cmd_careful "$@"
    ;;
inject)
    shift
    cmd_inject "$@"
    ;;
inject-all)
    cmd_inject_all
    ;;
all)
    cmd_all
    ;;
shell)
    cmd_shell
    ;;
-h | --help | "")
    usage
    ;;
*)
    echo "unknown subcommand: ${1}" >&2
    usage >&2
    exit 1
    ;;
esac
