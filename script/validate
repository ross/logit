#!/bin/bash
# Usage: script/validate
# Runs `logit validate` over every shipped config: demo/logit.yaml, examples/*/*.yaml,
# fixtures/*.yaml, perf/scenarios/*.yaml, tools/shape-survey/configs/*.yaml,
# tools/victoria-interop/logit-*.yaml, tools/splunk-interop/logit-*.yaml,
# tools/kafka-interop/logit-*.yaml, tools/s3-interop/logit-*.yaml, tools/soak/scenarios/*/logit-*.yaml (those directories'
# other files are compose, broker, vmagent, and scenario config), and spec/transit/flows/*.yaml.
# Not part of script/cibuild; script/test's `every_shipped_config_loads_and_validates` covers the
# same set.
#
# The `!env` variables the configs need (ADR `env-yaml-tag`) are defaulted here, not in
# compose.yaml's `dev` service: `run()` bypasses compose in CI, so only an export here reaches both.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

export INFLUXDB_TOKEN="${INFLUXDB_TOKEN:-logit-dev-token}"
# fixtures/prometheus-remote-write-send.yaml's `headers:` map. The whole header value, `Bearer `
# prefix included: `!env` substitutes a field rather than interpolating into one.
export PROMETHEUS_REMOTE_WRITE_AUTHORIZATION="${PROMETHEUS_REMOTE_WRITE_AUTHORIZATION:-Bearer logit-dev-token}"
# fixtures/datadog-intake-standin.yaml's `api_keys:` list (the one key its Agents send as
# `DD-API-KEY`), fixtures/datadog-direct.yaml's `api_key`, and examples/canonical/logit.yaml's
# `api_key` and `dd-api-key` header.
export DD_API_KEY="${DD_API_KEY:-logit-dev-key}"
# fixtures/splunk-observability.yaml's `headers:` map (the `X-SF-Token` an org sends to
# Observability Cloud).
export SPLUNK_OBSERVABILITY_TOKEN="${SPLUNK_OBSERVABILITY_TOKEN:-logit-dev-token}"
# The HEC token fixtures/splunk-hec-*.yaml send (`splunk_hec_out`'s `token`) and accept
# (`splunk_hec_in`'s `tokens:`).
export SPLUNK_HEC_TOKEN="${SPLUNK_HEC_TOKEN:-logit-dev-token}"
# tools/splunk-interop/logit-*.yaml's `splunk_hec_out` target, which script/splunk-interop points
# at a local Splunk or Splunk Cloud.
export SPLUNK_INTEROP_HEC_URL="${SPLUNK_INTEROP_HEC_URL:-http://splunk:8088/services/collector}"
export SPLUNK_INTEROP_HEC_TOKEN="${SPLUNK_INTEROP_HEC_TOKEN:-logit-dev-token}"
export SPLUNK_INTEROP_ACK_TOKEN="${SPLUNK_INTEROP_ACK_TOKEN:-logit-dev-token}"
export SPLUNK_INTEROP_HEC_INSECURE="${SPLUNK_INTEROP_HEC_INSECURE:-false}"
# tools/kafka-interop/logit-oauth-*.yaml's fixed OAUTHBEARER token, which script/kafka-interop
# fetches from its token server.
export KAFKA_INTEROP_OAUTH_TOKEN="${KAFKA_INTEROP_OAUTH_TOKEN:-logit-dev-token}"
# tools/s3-interop/logit-*.yaml's store, credentials, and paths, which script/s3-interop sets per
# store and leg.
export S3_INTEROP_ENDPOINT="${S3_INTEROP_ENDPOINT:-http://minio:9000}"
export S3_INTEROP_VHOST_ENDPOINT="${S3_INTEROP_VHOST_ENDPOINT:-http://vhminio:9000}"
export S3_INTEROP_BUCKET="${S3_INTEROP_BUCKET:-logit-test}"
export S3_INTEROP_LATE_BUCKET="${S3_INTEROP_LATE_BUCKET:-logit-test-late}"
export S3_INTEROP_REGION="${S3_INTEROP_REGION:-us-east-1}"
export S3_INTEROP_PATH_STYLE="${S3_INTEROP_PATH_STYLE:-true}"
export S3_INTEROP_PREFIX="${S3_INTEROP_PREFIX:-leg/}"
export S3_INTEROP_ACCESS_KEY="${S3_INTEROP_ACCESS_KEY:-logit-dev-key}"
export S3_INTEROP_SECRET_KEY="${S3_INTEROP_SECRET_KEY:-logit-dev-key}"
export S3_INTEROP_RUN="${S3_INTEROP_RUN:-run1}"
export S3_INTEROP_TELEMETRY="${S3_INTEROP_TELEMETRY:-/out/leg.log}"
export S3_INTEROP_REPLAY_PATH="${S3_INTEROP_REPLAY_PATH:-/in/leg.logit}"
export S3_INTEROP_REPLAY_OUT="${S3_INTEROP_REPLAY_OUT:-/out/leg.log}"
# tools/soak/scenarios/rolling-overlap/logit-sut.yaml's instance name, which each overlap
# instance's compose service sets to its own name.
export SOAK_INSTANCE="${SOAK_INSTANCE:-logit}"

if ! in_project_environment; then
    run ./script/validate "$@"
    exit
fi

cargo build --quiet -p logit-cli
LOGIT_BIN="${CARGO_TARGET_DIR:-${ROOT}/target}/debug/logit"

for config in demo/logit.yaml examples/*/*.yaml fixtures/*.yaml perf/scenarios/*.yaml \
    tools/shape-survey/configs/*.yaml tools/victoria-interop/logit-*.yaml \
    tools/splunk-interop/logit-*.yaml tools/kafka-interop/logit-*.yaml tools/s3-interop/logit-*.yaml \
    tools/soak/scenarios/*/logit-*.yaml spec/transit/flows/*.yaml; do
    echo "-- ${config}"
    "${LOGIT_BIN}" validate "${config}"
done
