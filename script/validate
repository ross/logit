#!/bin/bash
# Usage: script/validate
# Runs `logit validate` over every shipped config -- demo/logit.yaml and every examples/*.yaml --
# so a component field rename or a new validation rule doesn't silently leave a config broken.
# Part of script/cibuild. Needs INFLUXDB_TOKEN resolvable (every shipped config's `influxdb_out`
# uses `!env INFLUXDB_TOKEN`, ADR 0011); the dev container's `environment:` already defaults it
# (compose.yaml), same as script/server relies on.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

for config in demo/logit.yaml examples/*.yaml; do
    echo "-- ${config}"
    run cargo run -q -p logit-cli -- validate "${config}"
done
