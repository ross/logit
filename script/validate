#!/bin/bash
# Usage: script/validate
# Runs `logit validate` over every shipped config: demo/logit.yaml, examples/*.yaml,
# perf/scenarios/*.yaml, and tools/shape-survey/configs/*.yaml. Not part of script/cibuild;
# script/test's `every_shipped_config_loads_and_validates` covers the same set.
#
# The `!env` variables the configs need (ADR `env-yaml-tag`) are defaulted here, not in
# compose.yaml's `dev` service: `run()` bypasses compose in CI, so only an export here reaches both.

set -e
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

export INFLUXDB_TOKEN="${INFLUXDB_TOKEN:-logit-dev-token}"
# examples/prometheus-remote-write-send.yaml's `headers:` map. The whole header value, `Bearer `
# prefix included: `!env` substitutes a field rather than interpolating into one.
export PROMETHEUS_REMOTE_WRITE_AUTHORIZATION="${PROMETHEUS_REMOTE_WRITE_AUTHORIZATION:-Bearer logit-dev-token}"
# examples/datadog-intake-standin.yaml's `api_keys:` list (the one key its Agents send as
# `DD-API-KEY`) and examples/datadog-direct.yaml's `api_key`.
export DD_API_KEY="${DD_API_KEY:-logit-dev-key}"

if ! in_project_environment; then
    run ./script/validate "$@"
    exit
fi

cargo build --quiet -p logit-cli
LOGIT_BIN="${CARGO_TARGET_DIR:-${ROOT}/target}/debug/logit"

for config in demo/logit.yaml examples/*.yaml perf/scenarios/*.yaml tools/shape-survey/configs/*.yaml; do
    echo "-- ${config}"
    "${LOGIT_BIN}" validate "${config}"
done
