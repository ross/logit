#!/bin/bash
# Usage: script/kafka-interop
#
# Runs every leg in tools/kafka-interop/README.md's "What it runs" against a real Apache Kafka
# and a real Redpanda, reads each topic back with the Java client and kcat, and prints one pass,
# gap, or fail row per leg. See tools/kafka-interop/README.md for what it runs and what it writes.
#
# Not part of script/cibuild: it runs third-party images on the host's docker daemon, and no test
# depends on it.
#
#   KAFKA_INTEROP_SKIP_IMAGE=1   reuse the existing logit:kafka-interop and logit-soak-netem:local
#   KAFKA_INTEROP_OUT=<dir>      where run directories go (default perf/results/kafka-interop)

set -euo pipefail
SCRIPT_PATH="$(dirname -- "$(readlink -f -- "${0}")")"
source "${SCRIPT_PATH}/common.sh"

TOOLS_DIR="${ROOT}/tools/kafka-interop"
# Everything this run creates is under this compose project, and compose.yaml names its network
# `kafka-interop-net`, so cleanup can't touch anything else on a shared daemon.
PROJECT="kafka-interop"
NETWORK="kafka-interop-net"
IMAGE="logit:kafka-interop"
NETEM_IMAGE="logit-soak-netem:local"
KAFKA_IMAGE="apache/kafka:4.2.0"
KCAT_IMAGE="edenhill/kcat:1.7.1"
PYTHON_IMAGE="python:3.12-slim"
COLLECTOR_IMAGE="otel/opentelemetry-collector-contrib:0.162.0@sha256:39923a8e431bd1f57be82411999d389fcfe40857492e4365456d97a4c1f74be6"
OAUTH_IMAGE="ghcr.io/navikt/mock-oauth2-server:6.0.2"
# The broker image's runtime is a JRE with no compiler, so `Txn.java` compiles here and runs on
# the broker image's JRE beside its client libraries.
JDK_IMAGE="eclipse-temurin:21.0.10_7-jdk@sha256:e58e492628c1428ceb838afc1a1b8762673d5eaa09296f560c363daea0fdcf3b"
BROKERS=(kafka redpanda)
# Each topic and its partition count, created on both brokers before any leg starts.
TOPICS=(parity-logit:6 parity-java:6 codec-none:1 codec-gzip:1 codec-snappy:1 codec-lz4:1
    codec-zstd:1 dedup:3 dedup-control:3 tls:1 mtls:1 mtls-nocert:1 sasl-plain:1
    sasl-scram512:1 sasl-scram256:1 sasl-wrong:1 timestamp:1 oauth-cc:1 oauth-static:1
    oauth-refused:1
    otlp_logs:1 otlp_metrics:1 otlp_spans:1 keyed-logs:6 keyed-metrics:1 keyed-spans:6
    big-logs:1 big-metrics:1 big-spans:1 exporter-default:6 exporter-murmur2:6
    otlpjson-logs:1 otlpjson-metrics:1 otlpjson-spans:1 jsonbig-logs:6 jsonbig-metrics:1
    jsonbig-spans:6)
# The topics only the consumer legs read, created beside TOPICS but never read back record by
# record: check.py reads what each `kafka_in` wrote, and their end offsets.
CODECS=(none gzip snappy lz4 zstd)
CONSUME_TOPICS=(console:3 txn:1 group-join:6 group-kill:6 group-mixed:6 restart:3
    collector-proto-logs:1 collector-proto-metrics:1 collector-proto-spans:1
    collector-json-logs:1 collector-json-metrics:1 collector-json-spans:1)
for codec in "${CODECS[@]}"; do
    for format in json msgpack native text; do
        CONSUME_TOPICS+=("relay-${format}-event-${codec}:1" "relay-${format}-batch-${codec}:1")
    done
    for format in otlp_proto otlp_json; do
        for signal in logs metrics spans; do
            CONSUME_TOPICS+=("relay-${format}-${codec}-${signal}:1")
        done
    done
done
# The consumer topics whose end offsets check.py reads, as a kafka-get-offsets.sh pattern.
CONSUME_OFFSETS='^(console|txn|group-join|group-kill|group-mixed)$'
# The topics that hold OTLP requests, protobuf bytes a tab-separated reader can't carry. Their
# read-back prints each record's partition, offset, timestamp, key, and value size, and no value.
BINARY_TOPICS=(otlp_logs otlp_metrics otlp_spans keyed-logs keyed-metrics keyed-spans big-logs
    big-metrics big-spans exporter-default exporter-murmur2 otlpjson-logs otlpjson-metrics
    otlpjson-spans jsonbig-logs jsonbig-metrics jsonbig-spans)
# The dedup leg's fault: the broker's packets to the leg's container dropped from this many
# seconds after the legs start, for this long. The leg sends for 40 s.
NETEM_AT=10
NETEM_FOR=8
# How long the legs run, from their start, before the script stops them: the longest leg's 40 s
# of sending, and time for its retries after the fault.
LEGS_WINDOW=75
# The group legs' steps, in seconds from the legs' start: the console consumer of the
# `group-mixed` leg runs from MIXED_AT for MIXED_FOR, the late member joins and the killed one
# dies at GROUP_AT, and the mixed group's assignment is read at DESCRIBE_AT, while both of its
# members are in it.
MIXED_AT=5
MIXED_FOR=40
GROUP_AT=20
DESCRIBE_AT=25
# The broker-restart legs run after the others: each broker restarts RESTART_AT seconds after
# they start with the member reading, and again once the member has stopped, and the legs stop
# RESTART_WINDOW seconds after they start.
RESTART_AT=20
RESTART_WINDOW=110
# The legs the script starts at a step of its own rather than with the others.
LATE_LEGS=(logit-in-group-join-b-kafka logit-in-group-join-b-redpanda)
KILLED_LEGS=(logit-in-group-kill-b-kafka logit-in-group-kill-b-redpanda)
RESTART_MEMBERS=(logit-in-restart-kafka logit-in-restart-redpanda)
RESTART_LEGS=("${RESTART_MEMBERS[@]}" logit-in-restart-produce-kafka logit-in-restart-produce-redpanda)

RUN_DIR="${KAFKA_INTEROP_OUT:-${ROOT}/perf/results/kafka-interop}/$(date -u +%Y%m%dT%H%M%SZ)"
mkdir -p "${RUN_DIR}/logs" "${RUN_DIR}/tls" "${RUN_DIR}/redpanda" "${RUN_DIR}/readback" \
    "${RUN_DIR}/readback/kafka" "${RUN_DIR}/readback/redpanda" "${RUN_DIR}/java/lib" \
    "${RUN_DIR}/collector/kafka" "${RUN_DIR}/collector/redpanda"
# The image's unprivileged `logit` user, the Kafka image's `appuser`, and Redpanda's `redpanda`
# each have an unrelated uid, and so does the Collector's; world-writable lets each write here.
chmod 777 "${RUN_DIR}" "${RUN_DIR}/tls" "${RUN_DIR}/redpanda" "${RUN_DIR}/readback" \
    "${RUN_DIR}/readback/kafka" "${RUN_DIR}/readback/redpanda" "${RUN_DIR}/java" \
    "${RUN_DIR}/java/lib" "${RUN_DIR}/collector" "${RUN_DIR}/collector/kafka" \
    "${RUN_DIR}/collector/redpanda"

# `--env-file` rather than the environment: `sudo` resets the environment, and `$DOCKER` is
# `sudo docker` by default.
ENV_FILE="${RUN_DIR}/compose.env"
{
    echo "KAFKA_INTEROP_OUT=${RUN_DIR}"
    echo "KAFKA_INTEROP_IMAGE=${IMAGE}"
} >"${ENV_FILE}"

ki_compose() {
    ${DOCKER} compose --progress quiet -p "${PROJECT}" -f "${TOOLS_DIR}/compose.yaml" \
        --env-file "${ENV_FILE}" "$@"
}

say() {
    echo "kafka-interop: $*"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) $*" >>"${RUN_DIR}/timeline.log"
}

STARTED=0

# Captures every service's log into the run directory, then removes the project's containers,
# volumes, and network. Runs on every exit, including a failed start.
cleanup() {
    if [ "${STARTED}" -eq 1 ]; then
        netem clear kafka >/dev/null 2>&1 || true
        netem clear redpanda >/dev/null 2>&1 || true
        collect_logs || true
        ki_compose down -v --remove-orphans >/dev/null 2>&1 || true
    fi
    return 0
}

collect_logs() {
    local service
    for service in $(ki_compose config --services); do
        ki_compose logs --no-color --no-log-prefix "${service}" >"${RUN_DIR}/logs/${service}.log" 2>&1 || true
    done
}

container() {
    ki_compose ps -a -q "$1"
}

# in_list <item> <list...>: whether the item is one of the list.
in_list() {
    local item="$1" candidate
    shift
    for candidate in "$@"; do
        [ "${candidate}" = "${item}" ] && return 0
    done
    return 1
}

# Restarts both brokers with `docker restart`, which keeps each container's log directory and so
# the groups' committed offsets, and waits for both to report healthy again.
restart_brokers() {
    local broker id n
    for broker in "${BROKERS[@]}"; do
        ${DOCKER} restart -t 30 "$(container "${broker}")" >/dev/null
    done
    for broker in "${BROKERS[@]}"; do
        id="$(container "${broker}")"
        for n in $(seq 1 90); do
            [ "$(${DOCKER} inspect -f '{{.State.Health.Status}}' "${id}")" = healthy ] && break
            [ "${n}" -eq 90 ] && {
                echo "kafka-interop: ${broker} didn't come back healthy after its restart" >&2
                return 1
            }
            sleep 2
        done
    done
}

# stop_legs <leg...>: SIGTERM each leg, which drains its sinks and writes its last telemetry,
# and appends its exit code to exits.txt.
stop_legs() {
    local leg id
    for leg in "$@"; do
        id="$(container "${leg}")"
        ${DOCKER} stop -t 30 "${id}" >/dev/null
        echo "${leg} $(${DOCKER} inspect -f '{{.State.ExitCode}}' "${id}")" >>"${RUN_DIR}/exits.txt"
    done
}

# netem set|clear <broker> [<ip>]: tools/kafka-interop/netem-drop.sh in the broker's network
# namespace, appended to netem.log.
netem() {
    local action="$1" broker="$2"
    shift 2
    {
        echo "== $(date -u +%Y-%m-%dT%H:%M:%S.%NZ) ${action} ${broker} $*"
        ${DOCKER} run --rm --network "container:$(container "${broker}")" --cap-add NET_ADMIN \
            -v "${TOOLS_DIR}/netem-drop.sh:/netem-drop.sh:ro,z" --entrypoint bash "${NETEM_IMAGE}" \
            /netem-drop.sh "${action}" "$@"
    } >>"${RUN_DIR}/netem.log" 2>&1
}

# A Kafka CLI tool from the broker image's /opt/kafka/bin, run inside the `kafka` container.
kafka_tool() {
    local tool="$1"
    shift
    ki_compose exec -T kafka "/opt/kafka/bin/${tool}" "$@"
}

# A private CA, a broker certificate for both broker names, and a client certificate, for the
# TLS legs. EC P-256 keys in PKCS#8, which the Kafka PEM keystore requires, and v3 extensions,
# which rustls requires. Throwaway keys, readable by every service's user.
make_tls() {
    ${DOCKER} run --rm -v "${RUN_DIR}/tls:/tls:z" -w /tls --entrypoint bash "${KAFKA_IMAGE}" -c '
        set -euo pipefail
        key() { openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 -out "$1"; }
        key ca.key
        openssl req -x509 -new -key ca.key -out ca.pem -days 2 -subj "/CN=kafka-interop CA" \
            -addext "basicConstraints=critical,CA:TRUE" \
            -addext "keyUsage=critical,keyCertSign,cRLSign"
        sign() {
            local name="$1" cn="$2" ext="$3"
            key "${name}.key"
            openssl req -new -key "${name}.key" -out "${name}.csr" -subj "/CN=${cn}"
            printf "%s\n" "${ext}" >"${name}.ext"
            openssl x509 -req -in "${name}.csr" -CA ca.pem -CAkey ca.key -CAcreateserial \
                -out "${name}.crt" -days 2 -extfile "${name}.ext" 2>/dev/null
        }
        sign broker kafka "subjectAltName=DNS:kafka,DNS:redpanda
extendedKeyUsage=serverAuth"
        sign client logit "extendedKeyUsage=clientAuth"
        cat broker.key broker.crt >broker-keystore.pem
        chmod 644 ./*
    '
}

# A project already up is someone else's run (or a crashed one of ours): stop rather than tear down
# a stack this invocation didn't start.
if [ -n "$(ki_compose ps -a -q 2>/dev/null)" ]; then
    echo "kafka-interop: compose project '${PROJECT}' already has containers on this daemon." >&2
    echo "  Not this run's to stop. If it is yours, run:" >&2
    echo "  ${DOCKER} compose -p ${PROJECT} -f ${TOOLS_DIR}/compose.yaml down -v" >&2
    exit 1
fi

if [ -n "${KAFKA_INTEROP_SKIP_IMAGE:-}" ]; then
    for image in "${IMAGE}" "${NETEM_IMAGE}"; do
        ${DOCKER} image inspect "${image}" >/dev/null 2>&1 || {
            echo "kafka-interop: KAFKA_INTEROP_SKIP_IMAGE is set but ${image} does not exist" >&2
            exit 1
        }
    done
else
    say "building ${IMAGE} from the current tree"
    ${DOCKER} build -q -f "${ROOT}/Dockerfile" -t "${IMAGE}" "${ROOT}" >/dev/null
    # The same image script/soak builds for its netem faults.
    ${DOCKER} build -q -t "${NETEM_IMAGE}" "${ROOT}/tools/soak/netem" >/dev/null
fi

for config in "${TOOLS_DIR}"/logit-*.yaml; do
    ${DOCKER} run --rm -v "${config}:/config.yaml:ro,z" -e KAFKA_INTEROP_OAUTH_TOKEN=unset \
        "${IMAGE}" validate /config.yaml >/dev/null || {
        echo "kafka-interop: ${config} failed 'logit validate'" >&2
        exit 1
    }
done

${DOCKER} run --rm -e BROKER=kafka -v "${TOOLS_DIR}/collector.yaml:/collector.yaml:ro,z" \
    "${COLLECTOR_IMAGE}" validate --config /collector.yaml || {
    echo "kafka-interop: collector.yaml failed the Collector's validate" >&2
    exit 1
}

say "generating a private CA and certificates into ${RUN_DIR}/tls"
make_tls
# `rpk redpanda start` rewrites its config file, so Redpanda gets a writable copy.
cp "${TOOLS_DIR}/redpanda.yaml" "${RUN_DIR}/redpanda/redpanda.yaml"
chmod 666 "${RUN_DIR}/redpanda/redpanda.yaml"

trap cleanup EXIT
STARTED=1
# Kafka fetches the JWKS while it starts its OAUTHBEARER listener, so the token server goes first.
say "starting the OAuth token server"
ki_compose up -d oauth >/dev/null
oauth_python() {
    ${DOCKER} run --rm --network "${NETWORK}" "${PYTHON_IMAGE}" python3 -I -c "$1"
}
oauth_python '
import time, urllib.request
for _ in range(120):
    try:
        urllib.request.urlopen("http://oauth/default/jwks", timeout=2).read()
        break
    except OSError:
        time.sleep(1)
else:
    raise SystemExit("the token server never served its JWKS")
' || {
    echo "kafka-interop: the OAuth token server didn't start" >&2
    exit 1
}
say "starting the brokers (run directory ${RUN_DIR})"
ki_compose up -d --wait --wait-timeout 180 kafka redpanda >/dev/null

{
    echo "kafka-interop provenance"
    echo "captured: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
    echo "repo: $(git -C "${ROOT}" rev-parse HEAD) ($(git -C "${ROOT}" status --porcelain | wc -l) modified path(s))"
    echo "docker: $(${DOCKER} version --format '{{.Server.Version}}' 2>/dev/null || echo unknown)"
    echo "logit image: $(${DOCKER} image inspect -f '{{.Id}}' "${IMAGE}")"
    for image in "${KAFKA_IMAGE}" "redpandadata/redpanda:v26.2.3" "${KCAT_IMAGE}" "${OAUTH_IMAGE}" "${COLLECTOR_IMAGE%%@*}" "${JDK_IMAGE%%@*}"; do
        echo "${image}: $(${DOCKER} image inspect -f '{{index .RepoDigests 0}}' "${image}" 2>/dev/null || echo unknown)"
    done
    echo "redpanda version: $(ki_compose exec -T redpanda rpk version 2>/dev/null | head -1)"
} >"${RUN_DIR}/provenance.txt"

# Redpanda's SASL users and mechanisms: its listeners named `sasl` and `sasls` require SASL, and the
# cluster setting picks which mechanisms they offer. A SCRAM user holds one mechanism's credential
# and PLAIN checks it, so each SCRAM mechanism gets its own user. Kafka's users come from
# compose.yaml and kafka-server.properties.
say "creating Redpanda's SASL users"
(
    set -e
    ki_compose exec -T redpanda rpk cluster config set sasl_mechanisms '[SCRAM, PLAIN]'
    ki_compose exec -T redpanda rpk security user create logit256 -p logit-secret \
        --mechanism SCRAM-SHA-256
    ki_compose exec -T redpanda rpk security user create logit512 -p logit-secret \
        --mechanism SCRAM-SHA-512
) >"${RUN_DIR}/logs/redpanda-sasl-setup.log" 2>&1 || {
    cat "${RUN_DIR}/logs/redpanda-sasl-setup.log" >&2
    echo "kafka-interop: Redpanda SASL setup failed" >&2
    exit 1
}

# OAUTHBEARER on Redpanda is an Enterprise feature. A new cluster runs on a 30-day trial license,
# so it can be turned on here; when it can't, check.py reads `redpanda-oidc.txt` and reports the
# OAUTHBEARER rows against Redpanda as GAP rather than FAIL.
say "turning on Redpanda's OAUTHBEARER"
if (
    set -e
    ki_compose exec -T redpanda rpk cluster license info
    # The identity provider first: turning OAUTHBEARER on fetches the discovery document and
    # JWKS from whatever `oidc_discovery_url` holds at that moment.
    ki_compose exec -T redpanda rpk cluster config set oidc_discovery_url \
        http://oauth/default/.well-known/openid-configuration
    ki_compose exec -T redpanda rpk cluster config set oidc_token_audience kafka-interop
    ki_compose exec -T redpanda rpk cluster config set sasl_mechanisms '[SCRAM, PLAIN, OAUTHBEARER]'
    # Ends every SASL session after 40 s, inside the 45 s token life, as Kafka's
    # `connections.max.reauth.ms` and token expiry do, so the `oauth-cc` sink redials on a new
    # token. Redpanda has one value for every listener, so the SCRAM and PLAIN sinks redial too.
    ki_compose exec -T redpanda rpk cluster config set kafka_sasl_max_reauth_ms 40000
) >"${RUN_DIR}/logs/redpanda-oidc-setup.log" 2>&1; then
    echo ok >"${RUN_DIR}/redpanda-oidc.txt"
else
    echo failed >"${RUN_DIR}/redpanda-oidc.txt"
    say "Redpanda refused OAUTHBEARER; see logs/redpanda-oidc-setup.log"
fi

# rpk creates every topic of one partition count in one call, against either broker; a
# kafka-topics.sh call per topic starts a JVM per topic.
say "creating topics on both brokers"
for broker in "${BROKERS[@]}"; do
    for partitions in $(printf '%s\n' "${TOPICS[@]}" "${CONSUME_TOPICS[@]}" | cut -d: -f2 | sort -u); do
        names=()
        for entry in "${TOPICS[@]}" "${CONSUME_TOPICS[@]}"; do
            [ "${entry##*:}" = "${partitions}" ] && names+=("${entry%%:*}")
        done
        ki_compose exec -T redpanda rpk topic create "${names[@]}" -p "${partitions}" -r 1 \
            -X "brokers=${broker}:9092" >>"${RUN_DIR}/logs/topics.log" 2>&1
    done
done

# The partition-parity leg's reference: the Java client's console producer writing the 50 keys
# `logit-parity-*.yaml` writes, one record each.
say "producing the parity keys with kafka-console-producer.sh"
for broker in "${BROKERS[@]}"; do
    for n in $(seq 0 49); do echo "user-${n}:java ${n}"; done |
        kafka_tool kafka-console-producer.sh --bootstrap-server "${broker}:9092" \
            --topic parity-java --reader-property parse.key=true --reader-property key.separator=: \
            >>"${RUN_DIR}/logs/java-producer.log" 2>&1
done

# The `consume-console` leg's records: 50 lines into a 3-partition topic, each with a key, a
# `seq` header, `rep` twice, and `nil` with a null value (the console producer's `null.marker`).
say "producing the console leg's records with kafka-console-producer.sh"
for broker in "${BROKERS[@]}"; do
    for n in $(seq 0 49); do
        printf 'seq:%s,rep:a,rep:b,nil:NULL\tkey-%s\tconsole line %s \xc3\xa9\n' "${n}" "${n}" "${n}"
    done | kafka_tool kafka-console-producer.sh --bootstrap-server "${broker}:9092" \
        --topic console --reader-property parse.key=true --reader-property parse.headers=true \
        --reader-property null.marker=NULL >>"${RUN_DIR}/logs/java-producer.log" 2>&1
done

# The `consume-read-committed` leg's transactions, from Txn.java: compiled against the broker
# image's client in the pinned JDK image, then run on the broker image's own JRE and libraries.
say "writing the read-committed leg's transactions with Txn.java"
(
    set -e
    ${DOCKER} run --rm -v "${RUN_DIR}/java/lib:/dst:z" --entrypoint bash "${KAFKA_IMAGE}" -c \
        'cp /opt/kafka/libs/kafka-clients-*.jar /dst/'
    ${DOCKER} run --rm -v "${TOOLS_DIR}/Txn.java:/src/Txn.java:ro,z" -v "${RUN_DIR}/java:/java:z" \
        "${JDK_IMAGE}" javac -cp '/java/lib/*' -d /java /src/Txn.java
    for broker in "${BROKERS[@]}"; do
        ${DOCKER} run --rm --network "${NETWORK}" -v "${RUN_DIR}/java:/java:ro,z" \
            --entrypoint java "${KAFKA_IMAGE}" -cp '/opt/kafka/libs/*:/java' Txn "${broker}:9092" txn
    done
) >"${RUN_DIR}/logs/txn-producer.log" 2>&1 || {
    cat "${RUN_DIR}/logs/txn-producer.log" >&2
    echo "kafka-interop: Txn.java failed" >&2
    exit 1
}

# The OAUTHBEARER legs' fixed token, fetched last so it outlives their sending by far.
say "fetching the OAUTHBEARER legs' fixed token"
token="$(oauth_python '
import json, urllib.request
request = urllib.request.Request(
    "http://oauth/default/token", data=b"grant_type=client_credentials&scope=kafka",
    headers={"Authorization": "Basic bG9naXQ6bG9naXQtc2VjcmV0",
             "Content-Type": "application/x-www-form-urlencoded"})
print(json.load(urllib.request.urlopen(request, timeout=10))["access_token"])
')"
echo "KAFKA_INTEROP_OAUTH_TOKEN=${token}" >>"${ENV_FILE}"

LEGS=()
START_LEGS=()
for config in "${TOOLS_DIR}"/logit-*.yaml; do
    name="$(basename "${config}" .yaml)"
    in_list "${name}" "${RESTART_LEGS[@]}" && continue
    LEGS+=("${name}")
    in_list "${name}" "${LATE_LEGS[@]}" || START_LEGS+=("${name}")
done
COLLECTORS=(collector-kafka collector-redpanda)
say "starting ${#START_LEGS[@]} legs and ${#COLLECTORS[@]} Collectors"
ki_compose up -d --no-deps "${START_LEGS[@]}" "${COLLECTORS[@]}" >/dev/null
elapsed=0

# The `group-mixed` leg's Java member: a console consumer in the group, run in the `kafka`
# container until `timeout` stops it, which closes the consumer: it commits and leaves.
sleep "${MIXED_AT}"
elapsed=${MIXED_AT}
say "starting the group-mixed leg's kafka-console-consumer.sh for ${MIXED_FOR}s"
MIXED_PIDS=()
for broker in "${BROKERS[@]}"; do
    ki_compose exec -T kafka timeout "${MIXED_FOR}" /opt/kafka/bin/kafka-console-consumer.sh \
        --bootstrap-server "${broker}:9092" --topic group-mixed --group consume-group-mixed \
        --from-beginning --formatter-property print.timestamp=true \
        --formatter-property print.partition=true --formatter-property print.offset=true \
        --formatter-property print.key=true \
        >"${RUN_DIR}/readback/${broker}/group-mixed-console.tsv" \
        2>>"${RUN_DIR}/logs/group-mixed-console.log" </dev/null &
    MIXED_PIDS+=($!)
done

sleep $((NETEM_AT - elapsed))
elapsed=${NETEM_AT}
for broker in "${BROKERS[@]}"; do
    ip="$(${DOCKER} inspect -f "{{(index .NetworkSettings.Networks \"${NETWORK}\").IPAddress}}" \
        "$(container "logit-dedup-${broker}")")"
    say "dropping ${broker}'s packets to logit-dedup-${broker} (${ip}) for ${NETEM_FOR}s"
    netem set "${broker}" "${ip}"
done
sleep "${NETEM_FOR}"
elapsed=$((NETEM_AT + NETEM_FOR))
for broker in "${BROKERS[@]}"; do
    netem clear "${broker}"
done
say "netem cleared"

sleep $((GROUP_AT - elapsed))
elapsed=${GROUP_AT}
say "starting the group-join legs' second member and killing the group-kill legs' second member"
ki_compose up -d --no-deps "${LATE_LEGS[@]}" >/dev/null
for leg in "${KILLED_LEGS[@]}"; do
    ${DOCKER} kill "$(container "${leg}")" >/dev/null
done

sleep $((DESCRIBE_AT - elapsed))
elapsed=${DESCRIBE_AT}
say "reading the group-mixed leg's group"
for broker in "${BROKERS[@]}"; do
    kafka_tool kafka-consumer-groups.sh --bootstrap-server "${broker}:9092" --describe \
        --group consume-group-mixed --state >"${RUN_DIR}/readback/${broker}/group-mixed.describe" \
        2>>"${RUN_DIR}/logs/readback.log" || true
    kafka_tool kafka-consumer-groups.sh --bootstrap-server "${broker}:9092" --describe \
        --group consume-group-mixed --members >>"${RUN_DIR}/readback/${broker}/group-mixed.describe" \
        2>>"${RUN_DIR}/logs/readback.log" || true
done

# Every leg sends for at most 40 s. `internal` runs until a signal, so no leg ends on its own:
# stop each with SIGTERM once the window has passed, which drains its sinks and writes its last
# telemetry. The killed members exit 137, which check.py expects.
sleep $((LEGS_WINDOW - elapsed))
say "stopping the legs"
: >"${RUN_DIR}/exits.txt"
stop_legs "${LEGS[@]}"
for pid in "${MIXED_PIDS[@]}"; do
    wait "${pid}" || true
done
# The legs have finished, so the Collectors have read every record. A SIGTERM flushes their file
# exporters and the `kafka` exporters' queues before the topics are read back.
for collector in "${COLLECTORS[@]}"; do
    id="$(container "${collector}")"
    ${DOCKER} stop -t 30 "${id}" >/dev/null
    echo "${collector} $(${DOCKER} inspect -f '{{.State.ExitCode}}' "${id}")" >>"${RUN_DIR}/exits.txt"
done

say "reading every topic back with kafka-console-consumer.sh and kcat"
for broker in "${BROKERS[@]}"; do
    out="${RUN_DIR}/readback/${broker}"
    mkdir -p "${out}"
    chmod 777 "${out}"
    for entry in "${TOPICS[@]}"; do
        topic="${entry%%:*}"
        kafka_tool kafka-get-offsets.sh --bootstrap-server "${broker}:9092" --topic "${topic}" \
            >"${out}/${topic}.offsets" 2>>"${RUN_DIR}/logs/readback.log" || true
        # The end offsets bound the read, so the consumer stops at the last record instead of
        # waiting out its idle timeout; the timeout only bounds a short topic.
        held="$(awk -F: '{ n += $3 } END { print n + 0 }' "${out}/${topic}.offsets")"
        binary=false
        for candidate in "${BINARY_TOPICS[@]}"; do
            [ "${candidate}" = "${topic}" ] && binary=true
        done
        print_value=true
        kcat_format='%p\t%o\t%T\t%k\t%s\n'
        if [ "${binary}" = true ]; then
            print_value=false
            kcat_format='%p\t%o\t%T\t%k\t%S\t%K\n'
        fi
        : >"${out}/${topic}.java.tsv"
        if [ "${held}" -gt 0 ]; then
            kafka_tool kafka-console-consumer.sh --bootstrap-server "${broker}:9092" \
                --topic "${topic}" --from-beginning --max-messages "${held}" --timeout-ms 20000 \
                --formatter-property print.timestamp=true --formatter-property print.partition=true \
                --formatter-property print.offset=true --formatter-property print.key=true \
                --formatter-property print.value="${print_value}" \
                >"${out}/${topic}.java.tsv" 2>>"${RUN_DIR}/logs/readback.log" || true
        fi
        ${DOCKER} run --rm --network "${NETWORK}" "${KCAT_IMAGE}" -b "${broker}:9092" -C \
            -t "${topic}" -o beginning -e -q -f "${kcat_format}" \
            >"${out}/${topic}.kcat.tsv" 2>>"${RUN_DIR}/logs/readback.log" || true
    done
done

# The codec each stored batch carries, for the codec legs. Kafka's segment files are in its own
# batch format, so kafka-dump-log.sh reads them; Redpanda's aren't, so rpk prints each record's
# batch attributes as the broker serves them on a fetch. Both brokers default
# `compression.type` to `producer`, so a stored batch keeps the codec the sink sent.
say "reading each codec topic's stored batch codec"
for codec in none gzip snappy lz4 zstd; do
    kafka_tool kafka-dump-log.sh \
        --files "/tmp/kraft-combined-logs/codec-${codec}-0/00000000000000000000.log" \
        >"${RUN_DIR}/readback/kafka/codec-${codec}.batches" 2>>"${RUN_DIR}/logs/readback.log" || true
    ki_compose exec -T redpanda rpk topic consume "codec-${codec}" -X brokers=redpanda:9092 \
        -o start -n 100 -f 'offset: %o compression: %a{compression}\n' \
        >"${RUN_DIR}/readback/redpanda/codec-${codec}.batches" 2>>"${RUN_DIR}/logs/readback.log" || true
done

say "reading the consumer legs' end offsets"
for broker in "${BROKERS[@]}"; do
    kafka_tool kafka-get-offsets.sh --bootstrap-server "${broker}:9092" \
        --topic "${CONSUME_OFFSETS}" >"${RUN_DIR}/readback/${broker}/consume.offsets" \
        2>>"${RUN_DIR}/logs/readback.log" || true
done

# The broker-restart legs, alone, so the restarts reach no other leg. The first restart comes
# with each member reading; the second while the member is stopped, so its next start reads the
# group's commit back from a broker that restarted since it was made.
say "starting the broker-restart legs"
started=$(date +%s)
ki_compose up -d --no-deps "${RESTART_LEGS[@]}" >/dev/null
sleep "${RESTART_AT}"
say "restarting both brokers with the members reading"
restart_brokers
say "stopping the broker-restart members, then restarting both brokers again"
for leg in "${RESTART_MEMBERS[@]}"; do
    ${DOCKER} stop -t 30 "$(container "${leg}")" >/dev/null
done
restart_brokers
say "starting the broker-restart members again"
for leg in "${RESTART_MEMBERS[@]}"; do
    ${DOCKER} start "$(container "${leg}")" >/dev/null
done
remaining=$((RESTART_WINDOW - ($(date +%s) - started)))
[ "${remaining}" -gt 0 ] && sleep "${remaining}"
say "stopping the broker-restart legs"
stop_legs "${RESTART_LEGS[@]}"
for broker in "${BROKERS[@]}"; do
    kafka_tool kafka-get-offsets.sh --bootstrap-server "${broker}:9092" --topic restart \
        >"${RUN_DIR}/readback/${broker}/restart.offsets" 2>>"${RUN_DIR}/logs/readback.log" || true
done

collect_logs
say "checking the legs"
status=0
${DOCKER} run --rm -v "${TOOLS_DIR}:/tools:ro,z" -v "${RUN_DIR}:/out:z" \
    "${PYTHON_IMAGE}" python3 -I /tools/check.py || status=$?

echo "kafka-interop: results in ${RUN_DIR}/results.md, service logs in ${RUN_DIR}/logs/"
exit "${status}"
