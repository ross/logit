# The image `script/s3-interop` runs `check.py` and the reference decompressors in: Python for the
# checker, and the stock `gzip` and `zstd` binaries to test and read the objects, so nothing in the
# verdict depends on `logit`'s own codecs.
FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
RUN apt-get update \
    && apt-get install -y --no-install-recommends zstd \
    && rm -rf /var/lib/apt/lists/*
