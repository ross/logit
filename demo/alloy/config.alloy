// syslog -> Loki shim (docs/plans/0003-demo-stack.md). Nothing writes here today -- pure
// scaffolding for `syslog_out`: once that ComponentKind exists, `logit` can point straight at
// the listener below. Loki has no syslog receiver of its own, and promtail (the historical
// answer) is EOL, which is why this is Alloy's `loki.source.syslog` rather than nothing at all.
loki.source.syslog "demo" {
  listener {
    address                         = "0.0.0.0:5141"
    protocol                        = "udp"
    syslog_format                   = "rfc3164" // matches syslog_in's own format (RFC 3164 only)
    rfc3164_default_to_current_year = true
    labels = {
      job      = "demo",
      protocol = "udp",
    }
  }

  // Alloy strips every `__`-prefixed label (including `__syslog_*`) before forwarding -- without
  // this, Loki would see no stream label from the syslog headers at all. Kept short: every label
  // here is a Loki stream, so only the low-cardinality header fields are promoted.
  relabel_rules = loki.relabel.syslog_headers.rules
  forward_to    = [loki.write.demo.receiver]
}

loki.relabel "syslog_headers" {
  forward_to = []

  rule {
    source_labels = ["__syslog_message_hostname"]
    target_label  = "host"
  }
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "app"
  }
}

loki.write "demo" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
