// The demo stack's service architecture: who talks to whom, and what *kind* of traffic each
// edge carries (web / logging / tracing / metrics / db / queue / query). demo/logit.yaml's
// pipeline diagram (rendered live by `logit graph`, shown below this one on the landing page)
// covers the other half: `logit`'s internal component graph and the wire protocol each edge
// uses. The two are deliberately complementary, not overlapping.
//
// Hand-authored, not generated: unlike the pipeline diagram, there's no single machine-readable
// source this could be derived from. "Traffic type" is a human judgment call spanning
// demo/compose.yaml, demo/logit.yaml, and demo/app/gunicorn.conf.py. So this file CAN drift from
// reality: when the topology changes, update it by hand alongside the change.
//
// Rendered the same way as the pipeline diagram (demo/compose.yaml's `arch-svg`, reusing
// demo/graph-renderer's Graphviz image), minus the generation step, since this file is already
// the source.
digraph architecture {
  rankdir=LR;
  nodesep=0.45;
  ranksep=0.7;
  node [fontname="monospace"];
  edge [fontname="monospace", fontsize=10];

  // `style="filled,..."` with no explicit `fillcolor`, matching crates/logit-cli/src/dot.rs's
  // node styling exactly, so both diagrams use the same default Graphviz lightgrey.

  // One node for both the real browser and demo/compose.yaml's `traffic` generator: from
  // haproxy's (or grafana's) point of view they're indistinguishable, and `traffic` exists only
  // to generate demo load, not as part of the architecture proper.
  client [shape=box, style="filled,rounded", label="client\n(browser / traffic)"];

  haproxy [shape=box, style="filled,rounded"];
  nginx   [shape=box, style="filled,rounded"];
  app     [shape=box, style="filled,rounded", label="app\n(Django)"];
  worker  [shape=box, style="filled,rounded", label="worker\n(Celery)"];
  logit   [shape=box, style="filled,rounded,bold"];
  grafana [shape=box, style="filled,rounded"];

  // Cylinders for the five data stores, the one shape this diagram uses that the pipeline
  // diagram doesn't. `logit graph`'s vocabulary doesn't distinguish "a backend that holds data"
  // from any other sink, but at the architecture level that distinction is the point. `redis` is
  // a broker rather than held data like the other four, but it's grouped here rather than given
  // a sixth shape for one node.
  loki            [shape=cylinder, style=filled];
  tempo           [shape=cylinder, style=filled];
  victoriametrics [shape=cylinder, style=filled];
  postgres        [shape=cylinder, style=filled];
  redis           [shape=cylinder, style=filled];

  // -- Web: the request path, plus the re-entrant hop `/work` adds -------------------------
  // (docs/plans/demo-richer-traces.md): app calling back into nginx's /inner is a second,
  // independent "web" edge in the opposite direction from nginx -> app, not a reuse of it. The
  // request genuinely re-enters the chain partway rather than looping in place.
  client  -> haproxy [label="web"];
  haproxy -> nginx   [label="web"];
  nginx   -> app     [label="web"];
  app     -> nginx   [label="web"];
  client  -> grafana [label="web"];

  // -- Logging: every tier's logs reach `logit` ---------------------------------------------
  // haproxy's, app's, and worker's over syslog. nginx's, redis's, and postgres's are tailed by
  // `logit` directly off the host: nginx's and redis's Docker json-file logs
  // (docs/adr/file-tailing-and-docker-json-logs.md, this demo's end-to-end proof for that ADR)
  // and postgres's rotating jsonlog directory (`tail_in`, docs/plans/demo-richer-traces.md).
  // Either way it's one "logging" edge: the transport is a detail this diagram doesn't draw
  // (demo/logit.yaml's topology comment has it).
  haproxy  -> logit [label="logging"];
  nginx    -> logit [label="logging"];
  app      -> logit [label="logging"];
  worker   -> logit [label="logging"];
  postgres -> logit [label="logging"];
  redis    -> logit [label="logging"];
  logit    -> loki  [label="logging"];

  // -- db: reads/writes against Postgres, from either app-tier process ---------------------
  // Distinct from "query" below, which is Grafana reading back what this stack wrote. This is
  // `app`/`worker` reading and writing their own state over `psycopg`
  // (docs/plans/demo-richer-traces.md). Both processes write: `pages/tasks.py`'s task runs in
  // the `worker` process.
  app    -> postgres [label="db"];
  worker -> postgres [label="db"];

  // -- queue: Celery's broker traffic -------------------------------------------------------
  // `app` publishes (`.delay()`, pages/views.py's `work`); `worker` consumes. Two directed edges
  // for one exchange, like `nginx -> app`/`app -> nginx` above, rather than implying a single
  // bidirectional one (docs/plans/demo-richer-traces.md).
  app    -> redis [label="queue"];
  worker -> redis [label="queue"];

  // -- Tracing: three paths into Tempo ------------------------------------------------------
  // The landing page's browser SDK (demo/app/browser/telemetry.js) POSTs OTLP/HTTP traces to
  // haproxy on the page's own origin, and haproxy's `is_otlp` ACL forwards `/v1/*` to `logit`'s
  // `browser_in`. Same-origin through haproxy, not straight to `logit`, because `otlp_in` has no
  // CORS support (demo/haproxy/haproxy.cfg). These are drawn as their own "tracing" edges, apart
  // from the "web" and "logging" edges that share their endpoints. Only a real browser takes this
  // path: `traffic` is a `curl` loop and sends none.
  //
  // `logit`'s own internal spans travel the `logit -> tempo` edge, and so do haproxy's/nginx's
  // real access-line spans (docs/adr/trace-context-span-lifting.md's `span:` block), derived
  // from the same log line the "logging" edges above already show: one wire, two signals, no new
  // edge. `app`'s request/database-client/Celery-producer spans and `worker`'s
  // Celery-consumer/database-client spans go straight to Tempo's OTLP receiver instead,
  // deliberately bypassing `logit` (docs/plans/demo-tracing-stack.md's "Decisions already
  // settled"). Not every telemetry leg needs `logit` in front of it, and this diagram shows that
  // honestly rather than drawing an edge through `logit` that doesn't exist. `postgres` and
  // `redis` get no edge into `tempo`, because neither runs an SDK: postgres's trace id reaches
  // Loki only, via its "logging" edge, and redis's log carries none (its "logging" edge is server
  // lines only; the broker traffic is traced from both client ends, `app`'s and `worker`'s Redis
  // CLIENT spans).
  client  -> haproxy [label="tracing"];
  haproxy -> logit   [label="tracing"];
  logit   -> tempo   [label="tracing"];
  app     -> tempo   [label="tracing"];
  worker  -> tempo   [label="tracing"];

  // -- Metrics -------------------------------------------------------------------------------
  logit -> victoriametrics [label="metrics"];

  // -- Query: Grafana reading back what everything else wrote, dashed to set it apart from
  // the push/write traffic above -------------------------------------------------------------
  grafana -> loki            [label="query", style=dashed];
  grafana -> tempo           [label="query", style=dashed];
  grafana -> victoriametrics [label="query", style=dashed];
}
